{"type":"item.started","item":{"id":"item_14","type":"command_execution","command":"\"C:\\\\WINDOWS\\\\System32\\\\WindowsPowerShell\\\\v1.0\\\\powershell.exe\" -Command \"@'\nimport json\nimport numpy as np\nimport bayes\nimport sim\nimport sim_u\nimport e14_meaning_shift as e14\n\nn = 20_000\nlatent = sim_u.simulate_latent_u(n, seed=42)\nrate = float(latent['y'].mean())\npolicies = {\n    'gain_A': sim_u.u_informative(2, 0),\n    'gain_B': sim_u.u_informative(2, 2),\n    'lose_A': sim_u.u_informative(2, 2),\n    'lose_B': sim_u.u_informative(2, 0),\n}\nmask_rates = {}\nfor i, (name, policy) in enumerate(policies.items()):\n    obs = sim_u.observe_u(latent, policy, sigma=1, seed=100 + i)\n    mask_rates[name] = float(obs['m'].mean())\n\nsmall = sim_u.simulate_latent_u(64, seed=43)\npolicy0 = sim_u.u_informative(2, 0)\nobs0 = sim_u.observe_u(small, policy0, sigma=1, seed=44)\npred0, pu0 = sim_u.bayes_predict_u(obs0['x'], obs0['m'], 1, policy0,\n                                     threshold=2.05, return_u_probability=True)\n\n# Compare the delta=0 mixture predictor with bayes' grid implementation at the\n# same explicit threshold by temporarily aligning the imported constant.\nold_threshold = bayes.THRESHOLD\nbayes.THRESHOLD = 2.05\ntry:\n    reference_policy = sim.informative(2, 0.3)\n    reference = bayes._bayes_predict_grid(obs0['x'], obs0['m'], 1, reference_policy, 241)\nfinally:\n    bayes.THRESHOLD = old_threshold\nsame_threshold = sim_u.bayes_predict_u(obs0['x'], obs0['m'], 1, policy0,\n                                        threshold=2.05, delta=0)\n\n# Gain-direction B oracle check on a moderate cohort.\nng = 1000\ngain_latent = sim_u.simulate_latent_u(ng, seed=45)\ngain_policy = sim_u.u_informative(2, 2)\ngain_obs = sim_u.observe_u(gain_latent, gain_policy, sigma=1, seed=46)\ngain_pred, gain_pu = sim_u.bayes_predict_u(\n    gain_obs['x'], gain_obs['m'], 1, gain_policy,\n    threshold=sim_u.outcome_threshold(), return_u_probability=True\n)\nsummary = {\n    'threshold': sim_u.outcome_threshold(),\n    'outcome_rate_n20000': rate,\n    'testing_rates_n20000': mask_rates,\n    'beta0_p_u1_min_max': [float(pu0.min()), float(pu0.max())],\n    'beta0_max_abs_from_0.3': float(np.max(np.abs(pu0 - 0.3))),\n    'beta0_delta0_max_abs_from_bayes': float(np.max(np.abs(same_threshold - reference))),\n    'gain_mean_p_u1_given_h_u1': float(gain_pu[gain_latent['u'] == 1].mean()),\n    'gain_mean_p_u1_given_h_u0': float(gain_pu[gain_latent['u'] == 0].mean()),\n    'gain_oracle_mean_prediction': float(gain_pred.mean()),\n    'gain_observed_outcome_rate': float(gain_latent['y'].mean()),\n    'smoke_train_rate_seed': float(sim_u.simulate_latent_u(1000, 1700000)['y'].mean()),\n    'torch_module_loaded': getattr(__import__('latent_filter'), 'torch', None) is not None,\n}\nprint(json.dumps(summary, indent=2))\n'@ | & \\\"\"'$env:USERPROFILE'\"\\\\.cache\\\\codex-runtimes\\\\codex-primary-runtime\\\\dependencies\\\\python\\\\python.exe\\\" -\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
