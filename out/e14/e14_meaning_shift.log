er.py:379:def _predict_family(model, test_observed: Mapping[str, Mapping[str, np.ndarray]], weights):\r\nlatent_filter.py:401:def run(smoke: bool = False) -> Path:\r\nlatent_filter.py:471:def main(argv: Iterable[str] | None = None) -> None:\r\ne12_unlabelled_head.py:25:ROOT = Path(__file__).resolve().parent\r\ne12_unlabelled_head.py:27:SIGMA = 1.0\r\ne12_unlabelled_head.py:28:POLICY_NAMES = (\"B_less\", \"B_more\", \"B_match\", \"B_dense\")\r\ne12_unlabelled_head.py:30:TEST_OBS_SEED_BASE = 1_200_000\r\ne12_unlabelled_head.py:41:def _policies() -> Dict[str, sim.Policy]:\r\ne12_unlabelled_head.py:51:def _load_parameters(path: Path | str) -> Dict[str, np.ndarray]:\r\ne12_unlabelled_head.py:56:def _sigmoid(values: np.ndarray) -> np.ndarray:\r\ne12_unlabelled_head.py:66:def auroc_rank(y_true: np.ndarray, scores: np.ndarray) -> float:\r\ne12_unlabelled_head.py:92:def _metrics(y: np.ndarray, probability: np.ndarray, oracle_brier: float) -> Dict[str, \r\nfloat]:\r\ne12_unlabelled_head.py:108:def _pool_seeds(policy_index: int, size_type: str, size_index: int, draw: int) -> \r\nTuple[int, int, int]:\r\ne12_unlabelled_head.py:115:def _observe_pool(n: int, policy: sim.Policy, latent_seed: int, obs_seed: int):\r\ne12_unlabelled_head.py:121:def _choose_dial_weight(x: np.ndarray, m: np.ndarray, y: np.ndarray,\r\ne12_unlabelled_head.py:135:def _refit_testing_head(\r\ne12_unlabelled_head.py:200:def _init_worker(\r\ne12_unlabelled_head.py:215:def _run_refit_job(task: Mapping[str, object]) -> Dict[str, object]:\r\ne12_unlabelled_head.py:326:def _baseline_rows(\r\ne12_unlabelled_head.py:380:def _write_outputs(rows: Sequence[Mapping[str, object]], curves: Sequence[Mapping[str, \r\nobject]],\r\ne12_unlabelled_head.py:408:def run(*, workers: int = 4, smoke: bool = False, steps: int | None = None,\r\ne12_unlabelled_head.py:482:def main(argv: Iterable[str] | None = None) -> None:\r\ne13_rungs_over_time.py:32:ROOT = Path(__file__).resolve().parent\r\ne13_rungs_over_time.py:33:SIGMA = 1.0\r\n