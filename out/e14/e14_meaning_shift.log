{"type":"item.completed","item":{"id":"item_5","type":"command_execution","command":"\"C:\\\\WINDOWS\\\\System32\\\\WindowsPowerShell\\\\v1.0\\\\powershell.exe\" -Command '$files=@(@{p='\"'sim.py';s=1;e=230},@{p='bayes.py';s=1;e=155},@{p='latent_filter.py';s=1;e=330},@{p='e12_unlabelled_head.py';s=1;e=200},@{p='e13_rungs_over_time.py';s=1;e=240},@{p='e13_rungs_over_time.py';s=235;e=575}); foreach(\"'$f in $files){$a=Get-Content $f.p; \"--- $($f.p) $($f.s)-$($f.e) ---\"; for($i=$f.s-1;$i -lt [Math]::Min($a.Length,$f.e);$i++){ '\"'{0,4}: {1}' -f (\"'$i+1),$a[$i] }}'","aggregated_output":"--- sim.py 1-230 ---\r\n   1: \"\"\"Simulation utilities for the observation-shift study (NumPy only).\"\"\"\r\n   2: \r\n   3: from dataclasses import dataclass\r\n   4: from functools import lru_cache\r\n   5: import math\r\n   6: \r\n   7: import numpy as np\r\n   8: \r\n   9: \r\n  10: T = 48\r\n  11: RHO = 0.95\r\n  12: HORIZON = 6\r\n  13: THRESHOLD = 1.0\r\n  14: \r\n  15: \r\n  16: def _sigmoid(x):\r\n  17:     \"\"\"Numerically stable logistic function that accepts NumPy arrays.\"\"\"\r\n  18:     x = np.asarray(x, dtype=np.float64)\r\n  19:     out = np.empty_like(x)\r\n  20:     positive = x >= 0\r\n  21:     out[positive] = 1.0 / (1.0 + np.exp(-x[positive]))\r\n  22:     ex = np.exp(x[~positive])\r\n  23:     out[~positive] = ex / (1.0 + ex)\r\n  24:     return out\r\n  25: \r\n  26: \r\n  27: def _alpha_for_rate(gamma, rate):\r\n  28:     \"\"\"Solve E[sigmoid(alpha + gamma Z)] = rate by Gaussian quadrature.\"\"\"\r\n  29:     if not 0.0 < rate < 1.0:\r\n  30:         raise ValueError(\"rate must lie strictly between 0 and 1\")\r\n  31:     if gamma < 0.0:\r\n  32:         raise ValueError(\"gamma must be nonnegative\")\r\n  33:     if gamma == 0.0:\r\n  34:         return math.log(rate / (1.0 - rate))\r\n  35: \r\n  36:     # Hermite nodes integrate against exp(-x**2); sqrt(2) transforms them\r\n  37:     # to a standard normal.  The fixed quadrature makes policy construction\r\n  38:     # deterministic and avoids a costly Monte Carlo root solve.\r\n  39:     nodes, weights = np.polynomial.hermite.hermgauss(80)\r\n  40:     z = math.sqrt(2.0) * nodes\r\n  41:     weights = weights / math.sqrt(math.pi)\r\n  42: \r\n  43:     lo, hi = -30.0 - gamma, 30.0 + gamma\r\n  44:     for _ in range(80):\r\n  45:         mid = 0.5 * (lo + hi)\r\n  46:         marginal = float(np.dot(weights, _sigmoid(mid + gamma * z)))\r\n  47:         if marginal < rate:\r\n  48:             lo = mid\r\n  49:         else:\r\n  50:             hi = mid\r\n  51:     return 0.5 * (lo + hi)\r\n  52: \r\n  53: \r\n  54: @dataclass(frozen=True)\r\n  55: class Policy:\r\n  56:     \"\"\"Observation policy and its parameters.\"\"\"\r\n  57: \r\n  58:     name: str\r\n  59:     rate: float\r\n  60:     gamma: float = 0.0\r\n  61:     alpha: float = 0.0\r\n  62:     stay: float = 0.0\r\n  63: \r\n  64: \r\n  65: def informative(gamma, rate):\r\n  66:     \"\"\"Return an informative policy with marginal observation rate ``rate``.\"\"\"\r\n  67:     gamma = float(gamma)\r\n  68:     rate = float(rate)\r\n  69:     alpha = _alpha_for_rate(gamma, rate)\r\n  70:     return Policy(name=f\"informative_g{gamma:g}_r{rate:g}\", rate=rate,\r\n  71:                   gamma=gamma, alpha=alpha)\r\n  72: \r\n  73: \r\n  74: def _recorded_mask(z, noisy, uniforms, alpha, gamma):\r\n  75:     \"\"\"Draw recorded-value-driven masks from fixed noise and uniforms.\"\"\"\r\n  76:     n = z.shape[0]\r\n  77:     mask = np.empty((n, T), dtype=bool)\r\n  78:     x_last = np.zeros(n, dtype=np.float64)\r\n  79:     for t in range(T):\r\n  80:         p = _sigmoid(alpha + gamma * x_last)\r\n  81:         mask[:, t] = uniforms[:, t] < p\r\n  82:         x_last = np.where(mask[:, t], noisy[:, t], x_last)\r\n  83:     return mask\r\n  84: \r\n  85: \r\n  86: @lru_cache(maxsize=32)\r\n  87: def _alpha_for_recorded_rate(gamma, rate, sigma):\r\n  88:     \"\"\"Calibrate recorded-policy alpha on the fixed E3 cohort and draws.\"\"\"\r\n  89:     latent = simulate_latent(4000, seed=990001)\r\n  90:     z = np.asarray(latent[\"z\"], dtype=np.float64)\r\n  91:     rng = np.random.default_rng(990002)\r\n  92:     # Common random numbers make the calibration deterministic across trials.\r\n  93:     noisy = z + sigma * rng.standard_normal((z.shape[0], T), dtype=np.float64)\r\n  94:     uniforms = rng.random((z.shape[0], T))\r\n  95: \r\n  96:     lo, hi = -30.0 - gamma, 30.0 + gamma\r\n  97:     best_alpha = 0.5 * (lo + hi)\r\n  98:     best_error = float(\"inf\")\r\n  99:     for _ in range(80):\r\n 100:         mid = 0.5 * (lo + hi)\r\n 101:         mask = _recorded_mask(z, noisy, uniforms, mid, gamma)\r\n 102:         empirical_rate = float(mask.mean())\r\n 103:         error = abs(empirical_rate - rate)\r\n 104:         if error < best_error:\r\n 105:             best_error = error\r\n 106:             best_alpha = mid\r\n 107:         if empirical_rate < rate:\r\n 108:             lo = mid\r\n 109:         else:\r\n 110:             hi = mid\r\n 111:     return float(best_alpha)\r\n 112: \r\n 113: \r\n 114: def recorded(gamma, rate, sigma):\r\n 115:     \"\"\"Return a policy whose mask depends on the last recorded noisy value.\"\"\"\r\n 116:     gamma = float(gamma)\r\n 117:     rate = float(rate)\r\n 118:     sigma = float(sigma)\r\n 119:     if gamma < 0.0:\r\n 120:         raise ValueError(\"gamma must be nonnegative\")\r\n 121:     if not 0.0 < rate < 1.0:\r\n 122:         raise ValueError(\"rate must lie strictly between 0 and 1\")\r\n 123:     if sigma < 0.0:\r\n 124:         raise ValueError(\"sigma must be nonnegative\")\r\n 125:     alpha = _alpha_for_recorded_rate(gamma, rate, sigma)\r\n 126:     return Policy(name=f\"recorded_g{gamma:g}_r{rate:g}_s{sigma:g}\",\r\n 127:                   rate=rate, gamma=gamma, alpha=alpha)\r\n 128: \r\n 129: \r\n 130: def recorded_probs(x, m, policy):\r\n 131:     \"\"\"Return sequential recorded-policy probabilities for observed histories.\"\"\"\r\n 132:     x = np.asarray(x, dtype=np.float64)\r\n 133:     m = np.asarray(m, dtype=bool)\r\n 134:     if x.ndim != 2 or x.shape != m.shape or x.shape[1] != T:\r\n 135:         raise ValueError(f\"x and m must have matching shape (n, {T})\")\r\n 136:     if not getattr(policy, \"name\", \"\").startswith(\"recorded\"):\r\n 137:         raise ValueError(\"policy must be a recorded policy\")\r\n 138:     probabilities = np.empty(x.shape, dtype=np.float64)\r\n 139:     x_last = np.zeros(x.shape[0], dtype=np.float64)\r\n 140:     for t in range(T):\r\n 141:         probabilities[:, t] = _sigmoid(policy.alpha + policy.gamma * x_last)\r\n 142:         x_last = np.where(m[:, t], x[:, t], x_last)\r\n 143:     return probabilities\r\n 144: \r\n 145: \r\n 146: def uniform(rate):\r\n 147:     \"\"\"Return a Z-independent Bernoulli observation policy.\"\"\"\r\n 148:     rate = float(rate)\r\n 149:     if not 0.0 <= rate <= 1.0:\r\n 150:         raise ValueError(\"rate must lie between 0 and 1\")\r\n 151:     return Policy(name=f\"uniform_{rate:g}\", rate=rate)\r\n 152: \r\n 153: \r\n 154: def bursty(rate, stay):\r\n 155:     \"\"\"Return a stationary two-state Markov observation policy.\r\n 156: \r\n 157:     ``stay`` is the stationary, aggregate probability of repeating the prior\r\n 158:     state.  The two conditional switching probabilities are derived from the\r\n 159:     stationary flow constraint.  This gives equal conditional stay\r\n 160:     probabilities when ``rate == 0.5``.\r\n 161:     \"\"\"\r\n 162:     rate = float(rate)\r\n 163:     stay = float(stay)\r\n 164:     if not 0.0 < rate < 1.0:\r\n 165:         raise ValueError(\"rate must lie strictly between 0 and 1\")\r\n 166:     if not 0.0 <= stay <= 1.0:\r\n 167:         raise ValueError(\"stay must lie between 0 and 1\")\r\n 168:     p10 = (1.0 - stay) / (2.0 * rate)       # 1 -> 0\r\n 169:     p01 = (1.0 - stay) / (2.0 * (1.0 - rate))  # 0 -> 1\r\n 170:     if p10 > 1.0 + 1e-12 or p01 > 1.0 + 1e-12:\r\n 171:         raise ValueError(\"requested rate/stay pair has no valid two-state chain\")\r\n 172:     return Policy(name=f\"bursty_{rate:g}_s{stay:g}\", rate=rate, stay=stay)\r\n 173: \r\n 174: \r\n 175: def simulate_latent(n, seed):\r\n 176:     \"\"\"Simulate stationary Gaussian AR(1) paths and the horizon outcome.\"\"\"\r\n 177:     n = int(n)\r\n 178:     if n < 0:\r\n 179:         raise ValueError(\"n must be nonnegative\")\r\n 180:     rng = np.random.default_rng(seed)\r\n 181:     total_steps = T + HORIZON\r\n 182:     eps = rng.standard_normal((n, total_steps), dtype=np.float64)\r\n 183:     z = np.empty_like(eps)\r\n 184:     z[:, 0] = eps[:, 0]\r\n 185:     innovation_sd = math.sqrt(1.0 - RHO * RHO)\r\n 186:     for t in range(1, total_steps):\r\n 187:         z[:, t] = RHO * z[:, t - 1] + innovation_sd * eps[:, t]\r\n 188:     z_window = z[:, :T].astype(np.float32)\r\n 189:     z_future = z[:, T + HORIZON - 1].astype(np.float32)\r\n 190:     y = (z_future > THRESHOLD).astype(np.int8)\r\n 191:     return {\"z\": z_window, \"z_future\": z_future, \"y\": y}\r\n 192: \r\n 193: \r\n 194: def observe(latent, policy, sigma, seed):\r\n 195:     \"\"\"Draw masks and noisy values for an existing latent cohort.\"\"\"\r\n 196:     z = np.asarray(latent[\"z\"], dtype=np.float64)\r\n 197:     if z.ndim != 2 or z.shape[1] != T:\r\n 198:         raise ValueError(f\"latent['z'] must have shape (n, {T})\")\r\n 199:     sigma = float(sigma)\r\n 200:     if sigma < 0.0:\r\n 201:         raise ValueError(\"sigma must be nonnegative\")\r\n 202:     rng = np.random.default_rng(seed)\r\n 203:     n = z.shape[0]\r\n 204: \r\n 205:     if policy.name.startswith(\"recorded\"):\r\n 206:         # E3 draws the complete noise matrix before generating any masks.\r\n 207:         noisy = z + sigma * rng.standard_normal((n, T), dtype=np.float64)\r\n 208:         uniforms = rng.random((n, T))\r\n 209:         mask = _recorded_mask(z, noisy, uniforms, policy.alpha, policy.gamma)\r\n 210:     elif policy.name.startswith(\"informative\"):\r\n 211:         p = _sigmoid(policy.alpha + policy.gamma * z)\r\n 212:         mask = (rng.random((n, T)) < p)\r\n 213:     elif policy.name.startswith(\"bursty\"):\r\n 214:         # P(1->0) and P(0->1) preserve the requested stationary rate.\r\n 215:         p10 = (1.0 - policy.stay) / (2.0 * policy.rate)\r\n 216:         p01 = (1.0 - policy.stay) / (2.0 * (1.0 - policy.rate))\r\n 217:         mask = np.empty((n, T), dtype=bool)\r\n 218:         mask[:, 0] = rng.random(n) < policy.rate\r\n 219:         for t in range(1, T):\r\n 220:             u = rng.random(n)\r\n 221:             previous = mask[:, t - 1]\r\n 222:             mask[:, t] = np.where(previous, u >= p10, u < p01)\r\n 223:     else:\r\n 224:         mask = rng.random((n, T)) < policy.rate\r\n 225: \r\n 226:     if not policy.name.startswith(\"recorded\"):\r\n 227:         noisy = z + sigma * rng.standard_normal((n, T), dtype=np.float64)\r\n 228:     x = np.where(mask, noisy, np.nan).astype(np.float32)\r\n 229:     return {\"x\": x, \"m\": mask.astype(np.int8)}\r\n 230: \r\n--- bayes.py 1-155 ---\r\n   1: \"\"\"Grid-based exact Bayes predictors for the observation-shift study.\"\"\"\r\n   2: \r\n   3: from functools import lru_cache\r\n   4: import math\r\n   5: \r\n   6: import numpy as np\r\n   7: \r\n   8: from sim import HORIZON, RHO, THRESHOLD, T\r\n   9: \r\n  10: \r\n  11: GRID_MIN = -5.5\r\n  12: GRID_MAX = 5.5\r\n  13: DEFAULT_G = 241\r\n  14: \r\n  15: \r\n  16: def _erf_array(values):\r\n  17:     \"\"\"Apply the platform's accurate math.erf to an ndarray.\"\"\"\r\n  18:     values = np.asarray(values, dtype=np.float64)\r\n  19:     flat = values.ravel()\r\n  20:     return np.fromiter((math.erf(float(v)) for v in flat), dtype=np.float64,\r\n  21:                        count=flat.size).reshape(values.shape)\r\n  22: \r\n  23: \r\n  24: def _normal_cdf(values):\r\n  25:     return 0.5 * (1.0 + _erf_array(np.asarray(values, dtype=np.float64) / math.sqrt(2.0)))\r\n  26: \r\n  27: \r\n  28: @lru_cache(maxsize=4)\r\n  29: def _grid_and_transition(G):\r\n  30:     \"\"\"Return grid, discretized stationary prior, and row-normalized kernel.\"\"\"\r\n  31:     G = int(G)\r\n  32:     if G < 3:\r\n  33:         raise ValueError(\"G must be at least 3\")\r\n  34:     grid = np.linspace(GRID_MIN, GRID_MAX, G, dtype=np.float64)\r\n  35:     # Evaluate the stationary density and conditional transition density at\r\n  36:     # grid points, then normalize.  The common density constants and grid\r\n  37:     # spacing cancel in these discrete distributions.\r\n  38:     prior = np.exp(-0.5 * grid * grid)\r\n  39:     prior /= prior.sum()\r\n  40: \r\n  41:     sd = math.sqrt(1.0 - RHO * RHO)\r\n  42:     residual = (grid[None, :] - RHO * grid[:, None]) / sd\r\n  43:     transition = np.exp(-0.5 * residual * residual)\r\n  44:     transition /= transition.sum(axis=1, keepdims=True)\r\n  45:     grid.setflags(write=False)\r\n  46:     prior.setflags(write=False)\r\n  47:     transition.setflags(write=False)\r\n  48:     return grid, prior, transition\r\n  49: \r\n  50: \r\n  51: def _is_informative(policy):\r\n  52:     return getattr(policy, \"name\", \"\").startswith(\"informative\")\r\n  53: \r\n  54: \r\n  55: def _bayes_predict_grid(x, m, sigma, assumed_policy, G):\r\n  56:     \"\"\"Grid-size implementation used by the public predictor and convergence test.\r\n  57: \r\n  58:     ``assumed_policy`` controls whether the observation pattern contributes\r\n  59:     information about the latent state.  Any Z-independent policy (uniform or\r\n  60:     bursty) is treated as values-only.  ``G`` is an optional grid-size\r\n  61:     override used for the prescribed 241-versus-481 convergence check.\r\n  62:     \"\"\"\r\n  63:     x = np.asarray(x, dtype=np.float64)\r\n  64:     m = np.asarray(m, dtype=bool)\r\n  65:     if x.ndim != 2 or x.shape != m.shape or x.shape[1] != T:\r\n  66:         raise ValueError(f\"x and m must have matching shape (n, {T})\")\r\n  67:     sigma = float(sigma)\r\n  68:     if sigma <= 0.0:\r\n  69:         raise ValueError(\"sigma must be positive\")\r\n  70: \r\n  71:     grid, initial, transition = _grid_and_transition(int(G))\r\n  72:     n = x.shape[0]\r\n  73:     posterior = np.broadcast_to(initial, (n, initial.size)).copy()\r\n  74:     informative = _is_informative(assumed_policy)\r\n  75:     tiny = np.finfo(np.float64).tiny\r\n  76:     log_normal_scale = -math.log(sigma)\r\n  77: \r\n  78:     if informative:\r\n  79:         gamma = float(assumed_policy.gamma)\r\n  80:         alpha = float(assumed_policy.alpha)\r\n  81:         log_p = -np.logaddexp(0.0, -(alpha + gamma * grid))\r\n  82:         log_not_p = -np.logaddexp(0.0, alpha + gamma * grid)\r\n  83: \r\n  84:     for t in range(T):\r\n  85:         # Rows of the kernel are previous states; this matrix product\r\n  86:         # propagates every patient's posterior in one BLAS operation.\r\n  87:         predicted = posterior @ transition\r\n  88:         observed = m[:, t]\r\n  89:         if informative:\r\n  90:             log_likelihood = np.broadcast_to(log_not_p, predicted.shape).copy()\r\n  91:             if np.any(observed):\r\n  92:                 residual = (x[observed, t, None] - grid[None, :]) / sigma\r\n  93:                 log_likelihood[observed] = (\r\n  94:                     log_p[None, :] + log_normal_scale - 0.5 * residual * residual\r\n  95:                 )\r\n  96:         else:\r\n  97:             log_likelihood = np.zeros_like(predicted)\r\n  98:             if np.any(observed):\r\n  99:                 residual = (x[observed, t, None] - grid[None, :]) / sigma\r\n 100:                 log_likelihood[observed] = (\r\n 101:                     log_normal_scale - 0.5 * residual * residual\r\n 102:                 )\r\n 103: \r\n 104:         log_weights = np.log(np.maximum(predicted, tiny)) + log_likelihood\r\n 105:         log_weights -= np.max(log_weights, axis=1, keepdims=True)\r\n 106:         posterior = np.exp(log_weights)\r\n 107:         posterior /= posterior.sum(axis=1, keepdims=True)\r\n 108: \r\n 109:     future_sd = math.sqrt(1.0 - RHO ** (2 * HORIZON))\r\n 110:     future_mean = (RHO ** HORIZON) * grid\r\n 111:     event_given_state = 1.0 - _normal_cdf((THRESHOLD - future_mean) / future_sd)\r\n 112:     return np.asarray(posterior @ event_given_state, dtype=np.float64)\r\n 113: \r\n 114: \r\n 115: def bayes_predict(x, m, sigma, assumed_policy):\r\n 116:     \"\"\"Return ``P(Y=1 | x, m)`` using the specified 241-point grid filter.\"\"\"\r\n 117:     return _bayes_predict_grid(x, m, sigma, assumed_policy, DEFAULT_G)\r\n 118: \r\n--- latent_filter.py 1-330 ---\r\n   1: \"\"\"Learned discrete latent-state filter for the E5 observation-shift experiment.\r\n   2: \r\n   3: The NumPy implementation is intentionally kept in lockstep with the Torch\r\n   4: forward pass so the recursion can be inspected and checked without Torch.\r\n   5: \"\"\"\r\n   6: \r\n   7: from __future__ import annotations\r\n   8: \r\n   9: import argparse\r\n  10: import copy\r\n  11: import json\r\n  12: import math\r\n  13: import os\r\n  14: from pathlib import Path\r\n  15: import tempfile\r\n  16: import time\r\n  17: from typing import Dict, Iterable, Mapping, Tuple\r\n  18: \r\n  19: import numpy as np\r\n  20: \r\n  21: import bayes\r\n  22: import run_grid\r\n  23: import sim\r\n  24: \r\n  25: try:\r\n  26:     import torch\r\n  27:     from torch import nn\r\n  28:     from torch.nn import functional as F\r\n  29: except ImportError:  # NumPy reference remains usable in the supplied runtime.\r\n  30:     torch = None\r\n  31:     nn = None\r\n  32:     F = None\r\n  33: \r\n  34: \r\n  35: ROOT = Path(__file__).resolve().parent\r\n  36: DEFAULT_WEIGHTS = np.round(np.arange(0.0, 1.0001, 0.05), 2)\r\n  37: PARAMETER_NAMES = (\"transition_logits\", \"initial_logits\", \"mu\", \"log_sd\", \"c\", \"u\")\r\n  38: \r\n  39: \r\n  40: def _logsumexp(values: np.ndarray, axis: int, keepdims: bool = False) -> np.ndarray:\r\n  41:     values = np.asarray(values, dtype=np.float64)\r\n  42:     maximum = np.max(values, axis=axis, keepdims=True)\r\n  43:     result = maximum + np.log(np.sum(np.exp(values - maximum), axis=axis, keepdims=True))\r\n  44:     if not keepdims:\r\n  45:         result = np.squeeze(result, axis=axis)\r\n  46:     return result\r\n  47: \r\n  48: \r\n  49: def _log_softmax(values: np.ndarray, axis: int = -1) -> np.ndarray:\r\n  50:     values = np.asarray(values, dtype=np.float64)\r\n  51:     return values - _logsumexp(values, axis=axis, keepdims=True)\r\n  52: \r\n  53: \r\n  54: def _sigmoid(values: np.ndarray) -> np.ndarray:\r\n  55:     values = np.asarray(values, dtype=np.float64)\r\n  56:     output = np.empty_like(values)\r\n  57:     positive = values >= 0.0\r\n  58:     output[positive] = 1.0 / (1.0 + np.exp(-values[positive]))\r\n  59:     exponent = np.exp(values[~positive])\r\n  60:     output[~positive] = exponent / (1.0 + exponent)\r\n  61:     return output\r\n  62: \r\n  63: \r\n  64: def _check_inputs(x: np.ndarray, m: np.ndarray, parameters: Mapping[str, np.ndarray], w: float):\r\n  65:     x = np.asarray(x, dtype=np.float64)\r\n  66:     m = np.asarray(m)\r\n  67:     if x.ndim != 2 or m.shape != x.shape:\r\n  68:         raise ValueError(\"x and m must have matching shape [n, T]\")\r\n  69:     if x.shape[1] < 1:\r\n  70:         raise ValueError(\"time dimension T must be positive\")\r\n  71:     if not np.all((m == 0) | (m == 1)):\r\n  72:         raise ValueError(\"m must contain only 0/1 values\")\r\n  73:     m = m.astype(bool, copy=False)\r\n  74:     if np.any(m & ~np.isfinite(x)):\r\n  75:         raise ValueError(\"observed x values must be finite\")\r\n  76:     w = float(w)\r\n  77:     if not 0.0 <= w <= 1.0:\r\n  78:         raise ValueError(\"w must be in [0, 1]\")\r\n  79: \r\n  80:     transition_logits = np.asarray(parameters[\"transition_logits\"], dtype=np.float64)\r\n  81:     initial_logits = np.asarray(parameters[\"initial_logits\"], dtype=np.float64)\r\n  82:     mu = np.asarray(parameters[\"mu\"], dtype=np.float64)\r\n  83:     c = np.asarray(parameters[\"c\"], dtype=np.float64)\r\n  84:     u = np.asarray(parameters[\"u\"], dtype=np.float64)\r\n  85:     log_sd = float(np.asarray(parameters[\"log_sd\"], dtype=np.float64).reshape(()))\r\n  86:     n_states = mu.size\r\n  87:     if (transition_logits.shape != (n_states, n_states)\r\n  88:             or initial_logits.shape != (n_states,)\r\n  89:             or c.shape != (n_states,) or u.shape != (n_states,)):\r\n  90:         raise ValueError(\"filter parameters have inconsistent state dimensions\")\r\n  91:     if not np.isfinite(log_sd):\r\n  92:         raise ValueError(\"log_sd must be finite\")\r\n  93:     return x, m, transition_logits, initial_logits, mu, log_sd, c, u, w\r\n  94: \r\n  95: \r\n  96: def numpy_forward(\r\n  97:     x: np.ndarray,\r\n  98:     m: np.ndarray,\r\n  99:     parameters: Mapping[str, np.ndarray],\r\n 100:     w: float = 1.0,\r\n 101: ) -> Tuple[np.ndarray, np.ndarray]:\r\n 102:     \"\"\"Return filtered outcome probabilities and sequence log likelihoods.\r\n 103: \r\n 104:     ``x`` has shape [patients, T] with NaN at missing values; ``m`` contains\r\n 105:     the corresponding 0/1 mask. The mask likelihood is multiplied by ``w``.\r\n 106:     The transition is applied before each observation update, matching the\r\n 107:     reference recursion in :mod:`bayes`.\r\n 108:     \"\"\"\r\n 109:     x, m, transition_logits, initial_logits, mu, log_sd, c, u, w = _check_inputs(\r\n 110:         x, m, parameters, w\r\n 111:     )\r\n 112:     n_patients, n_steps = x.shape\r\n 113:     log_transition = _log_softmax(transition_logits, axis=1)\r\n 114:     log_belief = np.broadcast_to(_log_softmax(initial_logits), (n_patients, mu.size)).copy()\r\n 115:     log_p_test = -np.logaddexp(0.0, -c)\r\n 116:     log_not_test = -np.logaddexp(0.0, c)\r\n 117:     sd = math.exp(log_sd)\r\n 118:     log_normal_constant = -log_sd - 0.5 * math.log(2.0 * math.pi)\r\n 119:     log_marginal = np.zeros(n_patients, dtype=np.float64)\r\n 120: \r\n 121:     for t in range(n_steps):\r\n 122:         log_predicted = _logsumexp(\r\n 123:             log_belief[:, :, None] + log_transition[None, :, :], axis=1\r\n 124:         )\r\n 125:         observed = m[:, t]\r\n 126:         safe_x = np.where(observed, x[:, t], 0.0)\r\n 127:         residual = (safe_x[:, None] - mu[None, :]) / sd\r\n 128:         log_value = log_normal_constant - 0.5 * residual * residual\r\n 129:         log_value = np.where(observed[:, None], log_value, 0.0)\r\n 130:         log_test = w * (\r\n 131:             observed[:, None] * log_p_test[None, :]\r\n 132:             + (~observed)[:, None] * log_not_test[None, :]\r\n 133:         )\r\n 134:         log_unnormalized = log_predicted + log_value + log_test\r\n 135:         normalizer = _logsumexp(log_unnormalized, axis=1)\r\n 136:         log_belief = log_unnormalized - normalizer[:, None]\r\n 137:         log_marginal += normalizer\r\n 138: \r\n 139:     posterior = np.exp(log_belief)\r\n 140:     probabilities = posterior @ _sigmoid(u)\r\n 141:     return probabilities, log_marginal\r\n 142: \r\n 143: \r\n 144: if torch is not None:\r\n 145:     class LatentFilter(nn.Module):\r\n 146:         \"\"\"K-state differentiable filter with a deploy-time mask tempering knob.\"\"\"\r\n 147: \r\n 148:         def __init__(self, n_states: int = 32):\r\n 149:             super().__init__()\r\n 150:             if n_states < 2:\r\n 151:                 raise ValueError(\"n_states must be at least 2\")\r\n 152:             self.n_states = int(n_states)\r\n 153:             transition_logits = torch.zeros(n_states, n_states)\r\n 154:             diagonal = torch.arange(n_states)\r\n 155:             transition_logits[diagonal, diagonal] = 4.0\r\n 156:             if n_states > 1:\r\n 157:                 transition_logits[diagonal[:-1], diagonal[1:]] = 2.0\r\n 158:                 transition_logits[diagonal[1:], diagonal[:-1]] = 2.0\r\n 159:             means = torch.linspace(-2.5, 2.5, n_states)\r\n 160:             initial_logits = -0.5 * means.square()\r\n 161:             self.transition_logits = nn.Parameter(transition_logits)\r\n 162:             self.initial_logits = nn.Parameter(initial_logits)\r\n 163:             self.mu = nn.Parameter(means)\r\n 164:             self.log_sd = nn.Parameter(torch.tensor(0.0))\r\n 165:             self.c = nn.Parameter(torch.zeros(n_states))\r\n 166:             self.u = nn.Parameter(torch.zeros(n_states))\r\n 167: \r\n 168:         def forward(self, x, m, w: float = 1.0):\r\n 169:             if not 0.0 <= float(w) <= 1.0:\r\n 170:                 raise ValueError(\"w must be in [0, 1]\")\r\n 171:             mask = m.to(dtype=torch.bool)\r\n 172:             log_transition = F.log_softmax(self.transition_logits, dim=1)\r\n 173:             log_belief = F.log_softmax(self.initial_logits, dim=0).expand(x.shape[0], -1)\r\n 174:             log_p_test = F.logsigmoid(self.c)\r\n 175:             log_not_test = F.logsigmoid(-self.c)\r\n 176:             sd = torch.exp(self.log_sd)\r\n 177:             log_normal_constant = -self.log_sd - 0.5 * math.log(2.0 * math.pi)\r\n 178:             log_marginal = torch.zeros(x.shape[0], dtype=x.dtype, device=x.device)\r\n 179: \r\n 180:             for t in range(x.shape[1]):\r\n 181:                 log_predicted = torch.logsumexp(\r\n 182:                     log_belief.unsqueeze(2) + log_transition.unsqueeze(0), dim=1\r\n 183:                 )\r\n 184:                 observed = mask[:, t]\r\n 185:                 safe_x = torch.where(observed, x[:, t], torch.zeros_like(x[:, t]))\r\n 186:                 residual = (safe_x[:, None] - self.mu[None, :]) / sd\r\n 187:                 log_value = log_normal_constant - 0.5 * residual.square()\r\n 188:                 log_value = torch.where(observed[:, None], log_value, torch.zeros_like(log_value))\r\n 189:                 observed_float = observed.to(dtype=x.dtype)[:, None]\r\n 190:                 log_test = float(w) * (\r\n 191:                     observed_float * log_p_test[None, :]\r\n 192:                     + (1.0 - observed_float) * log_not_test[None, :]\r\n 193:                 )\r\n 194:                 log_unnormalized = log_predicted + log_value + log_test\r\n 195:                 normalizer = torch.logsumexp(log_unnormalized, dim=1)\r\n 196:                 log_belief = log_unnormalized - normalizer[:, None]\r\n 197:                 log_marginal = log_marginal + normalizer\r\n 198: \r\n 199:             posterior = torch.exp(log_belief)\r\n 200:             probabilities = posterior @ torch.sigmoid(self.u)\r\n 201:             return probabilities, log_marginal\r\n 202: \r\n 203:         def numpy_parameters(self) -> Dict[str, np.ndarray]:\r\n 204:             return {\r\n 205:                 name: getattr(self, name).detach().cpu().numpy().copy()\r\n 206:                 for name in PARAMETER_NAMES\r\n 207:             }\r\n 208: else:\r\n 209:     class LatentFilter:  # pragma: no cover - only used to provide a clear runtime message\r\n 210:         def __init__(self, *args, **kwargs):\r\n 211:             raise ImportError(\"PyTorch is required to construct or train LatentFilter\")\r\n 212: \r\n 213: \r\n 214: def train_filter(\r\n 215:     train_x: np.ndarray,\r\n 216:     train_m: np.ndarray,\r\n 217:     train_y: np.ndarray,\r\n 218:     val_x: np.ndarray,\r\n 219:     val_m: np.ndarray,\r\n 220:     val_y: np.ndarray,\r\n 221:     *,\r\n 222:     n_states: int = 32,\r\n 223:     max_epochs: int = 200,\r\n 224:     batch_size: int = 512,\r\n 225:     patience: int = 15,\r\n 226:     seed: int = 31_337,\r\n 227: ) -> Tuple[LatentFilter, Dict[str, object]]:\r\n 228:     \"\"\"Fit the filter on A data using BCE plus per-step marginal NLL.\"\"\"\r\n 229:     if torch is None:\r\n 230:         raise ImportError(\"PyTorch is required to train E5; NumPy forward is available\")\r\n 231:     torch.set_num_threads(4)\r\n 232:     torch.manual_seed(int(seed))\r\n 233:     np.random.seed(int(seed) % (2**32 - 1))\r\n 234: \r\n 235:     def tensor_data(x, m, y):\r\n 236:         return (\r\n 237:             torch.from_numpy(np.ascontiguousarray(x, dtype=np.float32)),\r\n 238:             torch.from_numpy(np.ascontiguousarray(m, dtype=np.float32)),\r\n 239:             torch.from_numpy(np.ascontiguousarray(y, dtype=np.float32)),\r\n 240:         )\r\n 241: \r\n 242:     x_train, m_train, y_train = tensor_data(train_x, train_m, train_y)\r\n 243:     x_val, m_val, y_val = tensor_data(val_x, val_m, val_y)\r\n 244:     model = LatentFilter(n_states=n_states)\r\n 245:     optimizer = torch.optim.Adam(model.parameters(), lr=1e-2)\r\n 246:     n_train = y_train.shape[0]\r\n 247:     best_loss = float(\"inf\")\r\n 248:     best_state = None\r\n 249:     best_epoch = 0\r\n 250:     stale_epochs = 0\r\n 251:     train_history = []\r\n 252:     val_history = []\r\n 253:     train_bce_history = []\r\n 254:     val_bce_history = []\r\n 255:     train_nll_history = []\r\n 256:     val_nll_history = []\r\n 257: \r\n 258:     def evaluate(x, m, y):\r\n 259:         model.eval()\r\n 260:         total_loss = total_bce = total_nll = 0.0\r\n 261:         with torch.no_grad():\r\n 262:             for start in range(0, y.shape[0], batch_size):\r\n 263:                 stop = start + batch_size\r\n 264:                 probabilities, log_marginal = model(x[start:stop], m[start:stop], w=1.0)\r\n 265:                 bce = F.binary_cross_entropy(\r\n 266:                     probabilities.clamp(1e-7, 1.0 - 1e-7), y[start:stop]\r\n 267:                 )\r\n 268:                 nll = -log_marginal.mean() / x.shape[1]\r\n 269:                 size = y[start:stop].shape[0]\r\n 270:                 total_bce += float(bce) * size\r\n 271:                 total_nll += float(nll) * size\r\n 272:                 total_loss += float(bce + nll) * size\r\n 273:         count = int(y.shape[0])\r\n 274:         return total_loss / count, total_bce / count, total_nll / count\r\n 275: \r\n 276:     for epoch in range(int(max_epochs)):\r\n 277:         model.train()\r\n 278:         permutation = torch.randperm(n_train)\r\n 279:         total_loss = total_bce = total_nll = 0.0\r\n 280:         for start in range(0, n_train, batch_size):\r\n 281:             indices = permutation[start:start + batch_size]\r\n 282:             xb, mb, yb = x_train[indices], m_train[indices], y_train[indices]\r\n 283:             optimizer.zero_grad(set_to_none=True)\r\n 284:             probabilities, log_marginal = model(xb, mb, w=1.0)\r\n 285:             bce = F.binary_cross_entropy(\r\n 286:                 probabilities.clamp(1e-7, 1.0 - 1e-7), yb\r\n 287:             )\r\n 288:             nll = -log_marginal.mean() / x_train.shape[1]\r\n 289:             loss = bce + nll\r\n 290:             loss.backward()\r\n 291:             optimizer.step()\r\n 292:             size = yb.shape[0]\r\n 293:             total_bce += float(bce.detach()) * size\r\n 294:             total_nll += float(nll.detach()) * size\r\n 295:             total_loss += float(loss.detach()) * size\r\n 296:         train_bce = total_bce / n_train\r\n 297:         train_nll = total_nll / n_train\r\n 298:         train_history.append(total_loss / n_train)\r\n 299:         train_bce_history.append(train_bce)\r\n 300:         train_nll_history.append(train_nll)\r\n 301: \r\n 302:         val_loss, val_bce, val_nll = evaluate(x_val, m_val, y_val)\r\n 303:         val_history.append(val_loss)\r\n 304:         val_bce_history.append(val_bce)\r\n 305:         val_nll_history.append(val_nll)\r\n 306:         if val_loss < best_loss - 1e-8:\r\n 307:             best_loss = val_loss\r\n 308:             best_epoch = epoch + 1\r\n 309:             best_state = copy.deepcopy(model.state_dict())\r\n 310:             stale_epochs = 0\r\n 311:         else:\r\n 312:             stale_epochs += 1\r\n 313:         if stale_epochs >= patience:\r\n 314:             break\r\n 315: \r\n 316:     if best_state is not None:\r\n 317:         model.load_state_dict(best_state)\r\n 318:     return model, {\r\n 319:         \"best_epoch\": best_epoch,\r\n 320:         \"epochs\": len(train_history),\r\n 321:         \"train_loss\": train_history,\r\n 322:         \"val_loss\": val_history,\r\n 323:         \"train_bce\": train_bce_history,\r\n 324:         \"val_bce\": val_bce_history,\r\n 325:         \"train_nll_per_step\": train_nll_history,\r\n 326:         \"val_nll_per_step\": val_nll_history,\r\n 327:     }\r\n 328: \r\n 329: \r\n 330: def true_parameters(grid_size: int, sigma: float, policy) -> Dict[str, np.ndarray]:\r\n--- e12_unlabelled_head.py 1-200 ---\r\n   1: \"\"\"E12: re-learn the E5 testing head at B with and without outcomes.\r\n   2: \r\n   3: Run from the project folder with ``python e12_unlabelled_head.py``.  The\r\n   4: ``--smoke`` mode uses small cohorts and short refits; normal mode follows the\r\n   5: sizes and optimisation steps in SPEC.md.\r\n   6: \"\"\"\r\n   7: \r\n   8: from __future__ import annotations\r\n   9: \r\n  10: import argparse\r\n  11: import multiprocessing as mp\r\n  12: from pathlib import Path\r\n  13: import time\r\n  14: from typing import Dict, Iterable, List, Mapping, Sequence, Tuple\r\n  15: \r\n  16: import numpy as np\r\n  17: import pandas as pd\r\n  18: \r\n  19: import bayes\r\n  20: import latent_filter\r\n  21: import run_grid\r\n  22: import sim\r\n  23: \r\n  24: \r\n  25: ROOT = Path(__file__).resolve().parent\r\n  26: PARAMS_PATH = ROOT / \"results\" / \"E5\" / \"sigma1_gamma2\" / \"seed0\" / \"filter\" / \"params.npz\"\r\n  27: SIGMA = 1.0\r\n  28: POLICY_NAMES = (\"B_less\", \"B_more\", \"B_match\", \"B_dense\")\r\n  29: POOL_SEED_BASE = 1_300_000\r\n  30: TEST_OBS_SEED_BASE = 1_200_000\r\n  31: RUN_COLUMNS = (\r\n  32:     \"policy\", \"method\", \"size_type\", \"size\", \"draw\", \"brier\", \"log_loss\",\r\n  33:     \"auroc\", \"regret\", \"w\", \"wall_time_seconds\",\r\n  34: )\r\n  35: CURVE_COLUMNS = (\r\n  36:     \"policy\", \"n_U\", \"draw\", \"state_index\", \"mu\", \"refitted_probability\",\r\n  37:     \"true_testing_probability\",\r\n  38: )\r\n  39: \r\n  40: \r\n  41: def _policies() -> Dict[str, sim.Policy]:\r\n  42:     \"\"\"Build the four target policies specified for E12.\"\"\"\r\n  43:     return {\r\n  44:         \"B_less\": sim.informative(gamma=1.0, rate=0.3),\r\n  45:         \"B_more\": sim.informative(gamma=3.5, rate=0.3),\r\n  46:         \"B_match\": sim.uniform(rate=0.3),\r\n  47:         \"B_dense\": sim.uniform(rate=0.6),\r\n  48:     }\r\n  49: \r\n  50: \r\n  51: def _load_parameters(path: Path | str) -> Dict[str, np.ndarray]:\r\n  52:     with np.load(path, allow_pickle=False) as stored:\r\n  53:         return {name: np.asarray(stored[name]).copy() for name in latent_filter.PARAMETER_NAMES}\r\n  54: \r\n  55: \r\n  56: def _sigmoid(values: np.ndarray) -> np.ndarray:\r\n  57:     values = np.asarray(values, dtype=np.float64)\r\n  58:     result = np.empty_like(values)\r\n  59:     positive = values >= 0.0\r\n  60:     result[positive] = 1.0 / (1.0 + np.exp(-values[positive]))\r\n  61:     exp_values = np.exp(values[~positive])\r\n  62:     result[~positive] = exp_values / (1.0 + exp_values)\r\n  63:     return result\r\n  64: \r\n  65: \r\n  66: def auroc_rank(y_true: np.ndarray, scores: np.ndarray) -> float:\r\n  67:     \"\"\"Compute AUROC from average ranks, assigning average ranks to ties.\"\"\"\r\n  68:     y = np.asarray(y_true, dtype=bool).reshape(-1)\r\n  69:     score = np.asarray(scores, dtype=np.float64).reshape(-1)\r\n  70:     if y.size != score.size:\r\n  71:         raise ValueError(\"y_true and scores must have the same length\")\r\n  72:     positives = int(y.sum())\r\n  73:     negatives = y.size - positives\r\n  74:     if positives == 0 or negatives == 0:\r\n  75:         return float(\"nan\")\r\n  76: \r\n  77:     order = np.argsort(score, kind=\"mergesort\")\r\n  78:     ordered = score[order]\r\n  79:     ranks = np.empty(y.size, dtype=np.float64)\r\n  80:     start = 0\r\n  81:     while start < y.size:\r\n  82:         stop = start + 1\r\n  83:         while stop < y.size and ordered[stop] == ordered[start]:\r\n  84:             stop += 1\r\n  85:         # Ranks are one-based; all tied items receive their average rank.\r\n  86:         ranks[order[start:stop]] = 0.5 * ((start + 1) + stop)\r\n  87:         start = stop\r\n  88:     positive_rank_sum = float(ranks[y].sum())\r\n  89:     return (positive_rank_sum - positives * (positives + 1) / 2.0) / (positives * negatives)\r\n  90: \r\n  91: \r\n  92: def _metrics(y: np.ndarray, probability: np.ndarray, oracle_brier: float) -> Dict[str, float]:\r\n  93:     y = np.asarray(y, dtype=np.float64).reshape(-1)\r\n  94:     probability = np.asarray(probability, dtype=np.float64).reshape(-1)\r\n  95:     if y.shape != probability.shape:\r\n  96:         raise ValueError(\"prediction and outcome arrays must have matching shapes\")\r\n  97:     clipped = np.clip(probability, 1e-7, 1.0 - 1e-7)\r\n  98:     brier = float(np.mean((probability - y) ** 2))\r\n  99:     log_loss = float(-np.mean(y * np.log(clipped) + (1.0 - y) * np.log1p(-clipped)))\r\n 100:     return {\r\n 101:         \"brier\": brier,\r\n 102:         \"log_loss\": log_loss,\r\n 103:         \"auroc\": auroc_rank(y, probability),\r\n 104:         \"regret\": brier - float(oracle_brier),\r\n 105:     }\r\n 106: \r\n 107: \r\n 108: def _pool_seeds(policy_index: int, size_type: str, size_index: int, draw: int) -> Tuple[int, int, int]:\r\n 109:     \"\"\"Return disjoint latent, observation, and minibatch seeds for one pool.\"\"\"\r\n 110:     type_offset = 0 if size_type == \"n_L\" else 25_000\r\n 111:     latent_seed = POOL_SEED_BASE + policy_index * 50_000 + type_offset + size_index * 1_000 + draw * 3\r\n 112:     return latent_seed, latent_seed + 1, latent_seed + 2\r\n 113: \r\n 114: \r\n 115: def _observe_pool(n: int, policy: sim.Policy, latent_seed: int, obs_seed: int):\r\n 116:     latent = sim.simulate_latent(n, seed=latent_seed)\r\n 117:     observed = sim.observe(latent, policy, sigma=SIGMA, seed=obs_seed)\r\n 118:     return observed, np.asarray(latent[\"y\"], dtype=np.float32)\r\n 119: \r\n 120: \r\n 121: def _choose_dial_weight(x: np.ndarray, m: np.ndarray, y: np.ndarray,\r\n 122:                         parameters: Mapping[str, np.ndarray]) -> float:\r\n 123:     \"\"\"Choose the labelled run-in log-loss minimiser, breaking ties toward 1.\"\"\"\r\n 124:     weights = np.round(np.arange(0.0, 1.0001, 0.05), 2)\r\n 125:     losses = []\r\n 126:     for weight in weights:\r\n 127:         probability, _ = latent_filter.numpy_forward(x, m, parameters, w=float(weight))\r\n 128:         clipped = np.clip(probability, 1e-7, 1.0 - 1e-7)\r\n 129:         loss = -np.mean(y * np.log(clipped) + (1.0 - y) * np.log1p(-clipped))\r\n 130:         losses.append(float(loss))\r\n 131:     best_loss = min(losses)\r\n 132:     return float(max(weight for weight, loss in zip(weights, losses) if loss == best_loss))\r\n 133: \r\n 134: \r\n 135: def _refit_testing_head(\r\n 136:     observed: Mapping[str, np.ndarray],\r\n 137:     labels: np.ndarray | None,\r\n 138:     parameters: Mapping[str, np.ndarray],\r\n 139:     *,\r\n 140:     batch_seed: int,\r\n 141:     steps: int,\r\n 142:     lr: float = 1e-2,\r\n 143: ) -> Dict[str, np.ndarray]:\r\n 144:     \"\"\"Refit c only, using the E5 likelihood and optional outcome BCE.\"\"\"\r\n 145:     try:\r\n 146:         import torch\r\n 147:         from torch.nn import functional as F\r\n 148:     except ImportError as exc:  # Keep NumPy checks usable without PyTorch.\r\n 149:         raise ImportError(\"PyTorch is required for the E12 head refits\") from exc\r\n 150: \r\n 151:     torch.set_num_threads(1)\r\n 152:     torch.manual_seed(int(batch_seed))\r\n 153:     model = latent_filter.LatentFilter(n_states=int(np.asarray(parameters[\"mu\"]).size))\r\n 154:     with torch.no_grad():\r\n 155:         for name in latent_filter.PARAMETER_NAMES:\r\n 156:             tensor = torch.as_tensor(np.asarray(parameters[name]), dtype=getattr(model, name).dtype)\r\n 157:             getattr(model, name).copy_(tensor)\r\n 158: \r\n 159:     for name, parameter in model.named_parameters():\r\n 160:         parameter.requires_grad_(name == \"c\")\r\n 161:     optimizer = torch.optim.Adam([model.c], lr=float(lr))\r\n 162: \r\n 163:     x = torch.from_numpy(np.ascontiguousarray(observed[\"x\"], dtype=np.float32))\r\n 164:     m = torch.from_numpy(np.ascontiguousarray(observed[\"m\"], dtype=np.float32))\r\n 165:     y_tensor = None if labels is None else torch.from_numpy(np.ascontiguousarray(labels, dtype=np.float32))\r\n 166:     n = int(x.shape[0])\r\n 167:     if n == 0:\r\n 168:         raise ValueError(\"cannot refit the testing head on an empty pool\")\r\n 169:     generator = torch.Generator(device=\"cpu\")\r\n 170:     generator.manual_seed(int(batch_seed))\r\n 171:     model.train()\r\n 172: \r\n 173:     for _ in range(int(steps)):\r\n 174:         # Sampling with replacement keeps every optimizer step at 256 records,\r\n 175:         # including the small labelled run-ins in E12.\r\n 176:         indices = torch.randint(0, n, (256,), generator=generator)\r\n 177:         xb = x.index_select(0, indices)\r\n 178:         mb = m.index_select(0, indices)\r\n 179:         probabilities, log_marginal = model(xb, mb, w=1.0)\r\n 180:         nll_per_step = -log_marginal.mean() / x.shape[1]\r\n 181:         loss = nll_per_step\r\n 182:         if y_tensor is not None:\r\n 183:             yb = y_tensor.index_select(0, indices)\r\n 184:             bce = F.binary_cross_entropy(probabilities.clamp(1e-7, 1.0 - 1e-7), yb)\r\n 185:             loss = bce + nll_per_step\r\n 186:         optimizer.zero_grad(set_to_none=True)\r\n 187:         loss.backward()\r\n 188:         optimizer.step()\r\n 189: \r\n 190:     return model.numpy_parameters()\r\n 191: \r\n 192: \r\n 193: _WORKER_TEST_OBS: Dict[str, Mapping[str, np.ndarray]] = {}\r\n 194: _WORKER_TEST_Y: np.ndarray | None = None\r\n 195: _WORKER_PARAMS_PATH: str | None = None\r\n 196: _WORKER_POLICIES: Dict[str, sim.Policy] = {}\r\n 197: _WORKER_ORACLE_BRIER: Dict[str, float] = {}\r\n 198: \r\n 199: \r\n 200: def _init_worker(\r\n--- e13_rungs_over_time.py 1-240 ---\r\n   1: \"\"\"E13: compare adaptation rungs as a deployment run-in grows week by week.\r\n   2: \r\n   3: Run from the project folder with ``python e13_rungs_over_time.py``.  The\r\n   4: ``--smoke`` option uses short training/refits and writes separate smoke files.\r\n   5: \"\"\"\r\n   6: \r\n   7: from __future__ import annotations\r\n   8: \r\n   9: import argparse\r\n  10: import json\r\n  11: import multiprocessing as mp\r\n  12: from pathlib import Path\r\n  13: import time\r\n  14: from typing import Dict, Iterable, List, Mapping, Sequence, Tuple\r\n  15: \r\n  16: import numpy as np\r\n  17: import pandas as pd\r\n  18: \r\n  19: import bayes\r\n  20: import sim\r\n  21: \r\n  22: # bayes imports THRESHOLD by value, so patch both modules at import time.  This\r\n  23: # module is imported afresh by spawned workers, which keeps their outcome rule\r\n  24: # aligned with the A model and the main process.\r\n  25: sim.THRESHOLD = 2.05\r\n  26: bayes.THRESHOLD = 2.05\r\n  27: \r\n  28: import e12_unlabelled_head as e12\r\n  29: import latent_filter\r\n  30: \r\n  31: \r\n  32: ROOT = Path(__file__).resolve().parent\r\n  33: SIGMA = 1.0\r\n  34: WEEKS = (1, 2, 4, 8, 13, 26, 52, 104)\r\n  35: SMOKE_WEEKS = (1, 4)\r\n  36: N_PER_WEEK = 25\r\n  37: STREAM_N = 2_600\r\n  38: POLICY_NAMES = (\"B_less\", \"B_more\", \"B_match\", \"B_dense\")\r\n  39: \r\n  40: # All E13 seed ranges are separate from the E5/E12 seeds and from one another.\r\n  41: A_TRAIN_LATENT_SEED = 1_500_000\r\n  42: A_VAL_LATENT_SEED = 1_501_000\r\n  43: A_TRAIN_OBS_SEED = 1_502_000\r\n  44: A_VAL_OBS_SEED = 1_503_000\r\n  45: A_MODEL_SEED = 1_504_337\r\n  46: TEST_LATENT_SEED = 1_550_000\r\n  47: TEST_OBS_SEED_BASE = 1_560_000\r\n  48: STREAM_SEED_BASE = 1_600_000\r\n  49: \r\n  50: RUN_COLUMNS = (\r\n  51:     \"policy\", \"method\", \"week\", \"n_patients\", \"n_cases\", \"draw\",\r\n  52:     \"brier\", \"log_loss\", \"auroc\", \"regret\", \"w\", \"wall_time_seconds\",\r\n  53: )\r\n  54: SUMMARY_METRICS = (\r\n  55:     \"n_patients\", \"n_cases\", \"brier\", \"log_loss\", \"auroc\", \"regret\",\r\n  56:     \"w\", \"wall_time_seconds\",\r\n  57: )\r\n  58: \r\n  59: \r\n  60: def _a_model_paths(smoke: bool) -> Tuple[Path, Path]:\r\n  61:     folder = ROOT / (\"results_smoke\" if smoke else \"results\") / \"E13\" / \"a_model\"\r\n  62:     return folder / \"params.npz\", folder / \"meta.json\"\r\n  63: \r\n  64: \r\n  65: def _observe_cohort(n: int, latent_seed: int, obs_seed: int, policy):\r\n  66:     latent = sim.simulate_latent(n, seed=latent_seed)\r\n  67:     observed = sim.observe(latent, policy, sigma=SIGMA, seed=obs_seed)\r\n  68:     return observed, np.asarray(latent[\"y\"], dtype=np.float32)\r\n  69: \r\n  70: \r\n  71: def _train_or_load_a_model(smoke: bool) -> Tuple[Path, Dict[str, object]]:\r\n  72:     n_train, n_val, max_epochs = (1_000, 300, 3) if smoke else (16_000, 4_000, 200)\r\n  73:     params_path, meta_path = _a_model_paths(smoke)\r\n  74:     train_policy = sim.informative(gamma=2.0, rate=0.3)\r\n  75: \r\n  76:     train_latent = sim.simulate_latent(n_train, seed=A_TRAIN_LATENT_SEED)\r\n  77:     train_y = np.asarray(train_latent[\"y\"], dtype=np.float32)\r\n  78:     training_rate = float(train_y.mean())\r\n  79:     assert 0.01 <= training_rate <= 0.03, (\r\n  80:         f\"E13 A training outcome rate must be 1%-3%; got {training_rate:.4%}\"\r\n  81:     )\r\n  82: \r\n  83:     if params_path.exists() and meta_path.exists():\r\n  84:         with meta_path.open(\"r\", encoding=\"utf-8\") as handle:\r\n  85:             metadata = json.load(handle)\r\n  86:         print(f\"SKIP A model training (cached at {params_path.parent})\", flush=True)\r\n  87:         return params_path, metadata\r\n  88: \r\n  89:     if latent_filter.torch is None:\r\n  90:         raise ImportError(\"PyTorch is required to train the E13 A filter\")\r\n  91:     started = time.perf_counter()\r\n  92:     train_observed = sim.observe(\r\n  93:         train_latent, train_policy, sigma=SIGMA, seed=A_TRAIN_OBS_SEED\r\n  94:     )\r\n  95:     val_observed, val_y = _observe_cohort(\r\n  96:         n_val, A_VAL_LATENT_SEED, A_VAL_OBS_SEED, train_policy\r\n  97:     )\r\n  98:     model, fit_meta = latent_filter.train_filter(\r\n  99:         train_observed[\"x\"], train_observed[\"m\"], train_y,\r\n 100:         val_observed[\"x\"], val_observed[\"m\"], val_y,\r\n 101:         n_states=32,\r\n 102:         max_epochs=max_epochs,\r\n 103:         batch_size=512,\r\n 104:         patience=15,\r\n 105:         seed=A_MODEL_SEED,\r\n 106:     )\r\n 107:     metadata: Dict[str, object] = {\r\n 108:         \"experiment\": \"E13\",\r\n 109:         \"model\": \"latent_filter\",\r\n 110:         \"sigma\": SIGMA,\r\n 111:         \"training_policy\": \"informative_gamma2_rate0.3\",\r\n 112:         \"threshold\": 2.05,\r\n 113:         \"n_train\": n_train,\r\n 114:         \"n_val\": n_val,\r\n 115:         \"n_train_cases\": int(train_y.sum()),\r\n 116:         \"train_outcome_rate\": training_rate,\r\n 117:         \"n_val_cases\": int(np.asarray(val_y).sum()),\r\n 118:         \"train_latent_seed\": A_TRAIN_LATENT_SEED,\r\n 119:         \"val_latent_seed\": A_VAL_LATENT_SEED,\r\n 120:         \"train_observation_seed\": A_TRAIN_OBS_SEED,\r\n 121:         \"val_observation_seed\": A_VAL_OBS_SEED,\r\n 122:         \"model_seed\": A_MODEL_SEED,\r\n 123:         \"best_epoch\": fit_meta[\"best_epoch\"],\r\n 124:         \"epochs\": fit_meta[\"epochs\"],\r\n 125:         \"train_loss\": fit_meta[\"train_loss\"],\r\n 126:         \"val_loss\": fit_meta[\"val_loss\"],\r\n 127:         \"train_bce\": fit_meta[\"train_bce\"],\r\n 128:         \"val_bce\": fit_meta[\"val_bce\"],\r\n 129:         \"train_nll_per_step\": fit_meta[\"train_nll_per_step\"],\r\n 130:         \"val_nll_per_step\": fit_meta[\"val_nll_per_step\"],\r\n 131:         \"wall_time_seconds\": time.perf_counter() - started,\r\n 132:     }\r\n 133:     latent_filter._atomic_npz(params_path, model.numpy_parameters())\r\n 134:     latent_filter._atomic_json(meta_path, metadata)\r\n 135:     print(\r\n 136:         f\"DONE A model training at {params_path.parent} \"\r\n 137:         f\"rate={training_rate:.3%} best_epoch={fit_meta['best_epoch']} \"\r\n 138:         f\"wall={metadata['wall_time_seconds']:.1f}s\",\r\n 139:         flush=True,\r\n 140:     )\r\n 141:     return params_path, metadata\r\n 142: \r\n 143: \r\n 144: def _stream_seeds(policy_index: int, draw: int) -> Tuple[int, int, int]:\r\n 145:     base = STREAM_SEED_BASE + policy_index * 10_000 + draw * 100\r\n 146:     return base, base + 1, base + 2\r\n 147: \r\n 148: \r\n 149: def _choose_penalized_weight(\r\n 150:     x: np.ndarray,\r\n 151:     m: np.ndarray,\r\n 152:     y: np.ndarray,\r\n 153:     parameters: Mapping[str, np.ndarray],\r\n 154: ) -> float:\r\n 155:     \"\"\"Minimize summed labelled log loss plus the E9 quadratic penalty.\"\"\"\r\n 156:     if int(np.asarray(y).sum()) == 0:\r\n 157:         return 1.0\r\n 158:     weights = np.round(np.arange(0.0, 1.0001, 0.05), 2)\r\n 159:     losses: List[float] = []\r\n 160:     labels = np.asarray(y, dtype=np.float64)\r\n 161:     for weight in weights:\r\n 162:         probability, _ = latent_filter.numpy_forward(x, m, parameters, w=float(weight))\r\n 163:         clipped = np.clip(probability, 1e-7, 1.0 - 1e-7)\r\n 164:         log_loss_sum = -np.sum(\r\n 165:             labels * np.log(clipped) + (1.0 - labels) * np.log1p(-clipped)\r\n 166:         )\r\n 167:         losses.append(float(log_loss_sum + 2.0 * (float(weight) - 1.0) ** 2))\r\n 168:     best_loss = min(losses)\r\n 169:     return float(max(weight for weight, loss in zip(weights, losses) if loss == best_loss))\r\n 170: \r\n 171: \r\n 172: def _finetune(\r\n 173:     observed: Mapping[str, np.ndarray],\r\n 174:     labels: np.ndarray,\r\n 175:     parameters: Mapping[str, np.ndarray],\r\n 176:     *,\r\n 177:     batch_seed: int,\r\n 178:     steps: int,\r\n 179:     lr: float,\r\n 180: ) -> Dict[str, np.ndarray]:\r\n 181:     \"\"\"Fine-tune every A parameter with the E5 objective and replacement batches.\"\"\"\r\n 182:     if int(np.asarray(labels).sum()) == 0:\r\n 183:         return {name: np.asarray(parameters[name]).copy() for name in latent_filter.PARAMETER_NAMES}\r\n 184:     try:\r\n 185:         import torch\r\n 186:         from torch.nn import functional as F\r\n 187:     except ImportError as exc:\r\n 188:         raise ImportError(\"PyTorch is required for E13 fine-tuning\") from exc\r\n 189: \r\n 190:     torch.set_num_threads(1)\r\n 191:     torch.manual_seed(int(batch_seed))\r\n 192:     model = latent_filter.LatentFilter(n_states=int(np.asarray(parameters[\"mu\"]).size))\r\n 193:     with torch.no_grad():\r\n 194:         for name in latent_filter.PARAMETER_NAMES:\r\n 195:             tensor = torch.as_tensor(\r\n 196:                 np.asarray(parameters[name]), dtype=getattr(model, name).dtype\r\n 197:             )\r\n 198:             getattr(model, name).copy_(tensor)\r\n 199:     optimizer = torch.optim.Adam(model.parameters(), lr=float(lr))\r\n 200:     x = torch.from_numpy(np.ascontiguousarray(observed[\"x\"], dtype=np.float32))\r\n 201:     m = torch.from_numpy(np.ascontiguousarray(observed[\"m\"], dtype=np.float32))\r\n 202:     y = torch.from_numpy(np.ascontiguousarray(labels, dtype=np.float32))\r\n 203:     n = int(x.shape[0])\r\n 204:     generator = torch.Generator(device=\"cpu\")\r\n 205:     generator.manual_seed(int(batch_seed))\r\n 206:     model.train()\r\n 207: \r\n 208:     for _ in range(int(steps)):\r\n 209:         indices = torch.randint(0, n, (256,), generator=generator)\r\n 210:         xb = x.index_select(0, indices)\r\n 211:         mb = m.index_select(0, indices)\r\n 212:         yb = y.index_select(0, indices)\r\n 213:         probability, log_marginal = model(xb, mb, w=1.0)\r\n 214:         bce = F.binary_cross_entropy(\r\n 215:             probability.clamp(1e-7, 1.0 - 1e-7), yb\r\n 216:         )\r\n 217:         nll_per_step = -log_marginal.mean() / x.shape[1]\r\n 218:         loss = bce + nll_per_step\r\n 219:         optimizer.zero_grad(set_to_none=True)\r\n 220:         loss.backward()\r\n 221:         optimizer.step()\r\n 222:     return model.numpy_parameters()\r\n 223: \r\n 224: \r\n 225: _WORKER_TEST_OBS: Dict[str, Mapping[str, np.ndarray]] = {}\r\n 226: _WORKER_TEST_Y: np.ndarray | None = None\r\n 227: _WORKER_ORACLE: Dict[str, np.ndarray] = {}\r\n 228: _WORKER_ORACLE_BRIER: Dict[str, float] = {}\r\n 229: _WORKER_PARAMS: Dict[str, np.ndarray] = {}\r\n 230: _WORKER_POLICIES: Dict[str, sim.Policy] = {}\r\n 231: _WORKER_LR = 0.05\r\n 232: _WORKER_STEPS = 160\r\n 233: \r\n 234: \r\n 235: def _init_worker(\r\n 236:     test_observations: Dict[str, Mapping[str, np.ndarray]],\r\n 237:     test_y: np.ndarray,\r\n 238:     oracle_predictions: Dict[str, np.ndarray],\r\n 239:     params_path: str,\r\n 240:     lr: float,\r\n--- e13_rungs_over_time.py 235-575 ---\r\n 235: def _init_worker(\r\n 236:     test_observations: Dict[str, Mapping[str, np.ndarray]],\r\n 237:     test_y: np.ndarray,\r\n 238:     oracle_predictions: Dict[str, np.ndarray],\r\n 239:     params_path: str,\r\n 240:     lr: float,\r\n 241:     steps: int,\r\n 242: ) -> None:\r\n 243:     global _WORKER_TEST_OBS, _WORKER_TEST_Y, _WORKER_ORACLE, _WORKER_ORACLE_BRIER\r\n 244:     global _WORKER_PARAMS, _WORKER_POLICIES, _WORKER_LR, _WORKER_STEPS\r\n 245:     try:\r\n 246:         import torch\r\n 247:     except ImportError as exc:\r\n 248:         raise ImportError(\"PyTorch is required to run E13 adaptation jobs\") from exc\r\n 249:     torch.set_num_threads(1)\r\n 250:     _WORKER_TEST_OBS = test_observations\r\n 251:     _WORKER_TEST_Y = np.asarray(test_y)\r\n 252:     _WORKER_ORACLE = oracle_predictions\r\n 253:     _WORKER_ORACLE_BRIER = {\r\n 254:         policy: float(np.mean((prediction - _WORKER_TEST_Y) ** 2))\r\n 255:         for policy, prediction in oracle_predictions.items()\r\n 256:     }\r\n 257:     _WORKER_PARAMS = e12._load_parameters(params_path)\r\n 258:     _WORKER_POLICIES = e12._policies()\r\n 259:     _WORKER_LR = float(lr)\r\n 260:     _WORKER_STEPS = int(steps)\r\n 261: \r\n 262: \r\n 263: def _run_job(task: Mapping[str, object]) -> Dict[str, object]:\r\n 264:     if _WORKER_TEST_Y is None:\r\n 265:         raise RuntimeError(\"E13 worker was not initialized\")\r\n 266:     started = time.perf_counter()\r\n 267:     policy_name = str(task[\"policy\"])\r\n 268:     policy_index = int(task[\"policy_index\"])\r\n 269:     draw = int(task[\"draw\"])\r\n 270:     week = int(task[\"week\"])\r\n 271:     n_patients = N_PER_WEEK * week\r\n 272:     latent_seed, observation_seed, batch_seed = _stream_seeds(policy_index, draw)\r\n 273:     stream_latent = sim.simulate_latent(STREAM_N, seed=latent_seed)\r\n 274:     stream_all = sim.observe(\r\n 275:         stream_latent,\r\n 276:         _WORKER_POLICIES[policy_name],\r\n 277:         sigma=SIGMA,\r\n 278:         seed=observation_seed,\r\n 279:     )\r\n 280:     stream = {\r\n 281:         \"x\": np.asarray(stream_all[\"x\"][:n_patients], dtype=np.float32),\r\n 282:         \"m\": np.asarray(stream_all[\"m\"][:n_patients], dtype=np.int8),\r\n 283:     }\r\n 284:     stream_y = np.asarray(stream_latent[\"y\"][:n_patients], dtype=np.float32)\r\n 285:     n_cases = int(stream_y.sum())\r\n 286:     test_observed = _WORKER_TEST_OBS[policy_name]\r\n 287:     test_y = _WORKER_TEST_Y\r\n 288:     oracle_brier = _WORKER_ORACLE_BRIER[policy_name]\r\n 289:     params = _WORKER_PARAMS\r\n 290:     rows: List[Dict[str, object]] = []\r\n 291: \r\n 292:     # R1 and R2 share the same refitted testing head. Its fit is unlabelled.\r\n 293:     method_started = time.perf_counter()\r\n 294:     head_u_params = e12._refit_testing_head(\r\n 295:         stream,\r\n 296:         None,\r\n 297:         params,\r\n 298:         batch_seed=batch_seed,\r\n 299:         steps=_WORKER_STEPS,\r\n 300:         lr=_WORKER_LR,\r\n 301:     )\r\n 302:     head_u_prediction, _ = latent_filter.numpy_forward(\r\n 303:         test_observed[\"x\"], test_observed[\"m\"], head_u_params, w=1.0\r\n 304:     )\r\n 305:     rows.append({\r\n 306:         \"policy\": policy_name,\r\n 307:         \"method\": \"head_U\",\r\n 308:         \"week\": week,\r\n 309:         \"n_patients\": n_patients,\r\n 310:         \"n_cases\": 0,\r\n 311:         \"draw\": draw,\r\n 312:         **e12._metrics(test_y, head_u_prediction, oracle_brier),\r\n 313:         \"w\": 1.0,\r\n 314:         \"wall_time_seconds\": time.perf_counter() - method_started,\r\n 315:     })\r\n 316: \r\n 317:     method_started = time.perf_counter()\r\n 318:     head_u_dial_w = _choose_penalized_weight(\r\n 319:         stream[\"x\"], stream[\"m\"], stream_y, head_u_params\r\n 320:     )\r\n 321:     head_u_dial_prediction, _ = latent_filter.numpy_forward(\r\n 322:         test_observed[\"x\"], test_observed[\"m\"], head_u_params, w=head_u_dial_w\r\n 323:     )\r\n 324:     rows.append({\r\n 325:         \"policy\": policy_name,\r\n 326:         \"method\": \"head_U_dial\",\r\n 327:         \"week\": week,\r\n 328:         \"n_patients\": n_patients,\r\n 329:         \"n_cases\": n_cases,\r\n 330:         \"draw\": draw,\r\n 331:         **e12._metrics(test_y, head_u_dial_prediction, oracle_brier),\r\n 332:         \"w\": head_u_dial_w,\r\n 333:         \"wall_time_seconds\": time.perf_counter() - method_started,\r\n 334:     })\r\n 335: \r\n 336:     method_started = time.perf_counter()\r\n 337:     dial_only_w = _choose_penalized_weight(\r\n 338:         stream[\"x\"], stream[\"m\"], stream_y, params\r\n 339:     )\r\n 340:     dial_only_prediction, _ = latent_filter.numpy_forward(\r\n 341:         test_observed[\"x\"], test_observed[\"m\"], params, w=dial_only_w\r\n 342:     )\r\n 343:     rows.append({\r\n 344:         \"policy\": policy_name,\r\n 345:         \"method\": \"dial_only\",\r\n 346:         \"week\": week,\r\n 347:         \"n_patients\": n_patients,\r\n 348:         \"n_cases\": n_cases,\r\n 349:         \"draw\": draw,\r\n 350:         **e12._metrics(test_y, dial_only_prediction, oracle_brier),\r\n 351:         \"w\": dial_only_w,\r\n 352:         \"wall_time_seconds\": time.perf_counter() - method_started,\r\n 353:     })\r\n 354: \r\n 355:     method_started = time.perf_counter()\r\n 356:     finetuned_params = _finetune(\r\n 357:         stream,\r\n 358:         stream_y,\r\n 359:         params,\r\n 360:         batch_seed=batch_seed + 17,\r\n 361:         steps=_WORKER_STEPS,\r\n 362:         lr=_WORKER_LR,\r\n 363:     )\r\n 364:     finetune_prediction, _ = latent_filter.numpy_forward(\r\n 365:         test_observed[\"x\"], test_observed[\"m\"], finetuned_params, w=1.0\r\n 366:     )\r\n 367:     rows.append({\r\n 368:         \"policy\": policy_name,\r\n 369:         \"method\": \"finetune\",\r\n 370:         \"week\": week,\r\n 371:         \"n_patients\": n_patients,\r\n 372:         \"n_cases\": n_cases,\r\n 373:         \"draw\": draw,\r\n 374:         **e12._metrics(test_y, finetune_prediction, oracle_brier),\r\n 375:         \"w\": 1.0,\r\n 376:         \"wall_time_seconds\": time.perf_counter() - method_started,\r\n 377:     })\r\n 378: \r\n 379:     return {\r\n 380:         \"policy\": policy_name,\r\n 381:         \"week\": week,\r\n 382:         \"draw\": draw,\r\n 383:         \"rows\": rows,\r\n 384:         \"elapsed\": time.perf_counter() - started,\r\n 385:     }\r\n 386: \r\n 387: \r\n 388: def _make_test_cohort(n_test: int):\r\n 389:     policies = e12._policies()\r\n 390:     test_latent = sim.simulate_latent(n_test, seed=TEST_LATENT_SEED)\r\n 391:     test_y = np.asarray(test_latent[\"y\"], dtype=np.float32)\r\n 392:     test_observations: Dict[str, Mapping[str, np.ndarray]] = {}\r\n 393:     oracle_predictions: Dict[str, np.ndarray] = {}\r\n 394:     for policy_index, policy_name in enumerate(POLICY_NAMES):\r\n 395:         policy = policies[policy_name]\r\n 396:         observed = sim.observe(\r\n 397:             test_latent,\r\n 398:             policy,\r\n 399:             sigma=SIGMA,\r\n 400:             seed=TEST_OBS_SEED_BASE + policy_index,\r\n 401:         )\r\n 402:         test_observations[policy_name] = observed\r\n 403:         oracle_predictions[policy_name] = bayes.bayes_predict(\r\n 404:             observed[\"x\"], observed[\"m\"], SIGMA, policy\r\n 405:         )\r\n 406:     return policies, test_observations, test_y, oracle_predictions\r\n 407: \r\n 408: \r\n 409: def _summary_frame(rows: Sequence[Mapping[str, object]]) -> pd.DataFrame:\r\n 410:     frame = pd.DataFrame(rows, columns=RUN_COLUMNS)\r\n 411:     grouped = frame.groupby([\"policy\", \"method\", \"week\"], sort=False)[\r\n 412:         list(SUMMARY_METRICS)\r\n 413:     ].agg([\"mean\", \"min\", \"max\"])\r\n 414:     grouped.columns = [f\"{column}_{stat}\" for column, stat in grouped.columns]\r\n 415:     return grouped.reset_index()\r\n 416: \r\n 417: \r\n 418: def run(\r\n 419:     *,\r\n 420:     smoke: bool = False,\r\n 421:     workers: int = 4,\r\n 422:     lr: float = 0.05,\r\n 423:     steps: int = 160,\r\n 424:     train_only: bool = False,\r\n 425: ) -> Tuple[Path | None, Path | None]:\r\n 426:     if workers < 1:\r\n 427:         raise ValueError(\"--workers must be at least 1\")\r\n 428:     if steps < 1:\r\n 429:         raise ValueError(\"--steps must be at least 1\")\r\n 430:     if lr <= 0:\r\n 431:         raise ValueError(\"--lr must be positive\")\r\n 432: \r\n 433:     params_path, _ = _train_or_load_a_model(smoke)\r\n 434:     if train_only:\r\n 435:         return None, None\r\n 436: \r\n 437:     n_test = 500 if smoke else 10_000\r\n 438:     weeks = SMOKE_WEEKS if smoke else WEEKS\r\n 439:     draws = 1 if smoke else 5\r\n 440:     policies, test_observations, test_y, oracle_predictions = _make_test_cohort(n_test)\r\n 441:     params = e12._load_parameters(params_path)\r\n 442:     oracle_brier = {\r\n 443:         name: float(np.mean((oracle_predictions[name] - test_y) ** 2))\r\n 444:         for name in POLICY_NAMES\r\n 445:     }\r\n 446: \r\n 447:     # Compute static R0 and oracle predictions once per policy. A copy of each\r\n 448:     # metric row is placed at every week so the summary and figure have flat\r\n 449:     # reference curves on the same x axis as the adapting methods.\r\n 450:     static_rows: List[Dict[str, object]] = []\r\n 451:     for policy_name in POLICY_NAMES:\r\n 452:         observed = test_observations[policy_name]\r\n 453:         keep_prediction, _ = latent_filter.numpy_forward(\r\n 454:             observed[\"x\"], observed[\"m\"], params, w=1.0\r\n 455:         )\r\n 456:         for week in weeks:\r\n 457:             n_patients = N_PER_WEEK * week\r\n 458:             static_rows.append({\r\n 459:                 \"policy\": policy_name,\r\n 460:                 \"method\": \"keep\",\r\n 461:                 \"week\": week,\r\n 462:                 \"n_patients\": n_patients,\r\n 463:                 \"n_cases\": 0,\r\n 464:                 \"draw\": 0,\r\n 465:                 **e12._metrics(test_y, keep_prediction, oracle_brier[policy_name]),\r\n 466:                 \"w\": 1.0,\r\n 467:                 \"wall_time_seconds\": 0.0,\r\n 468:             })\r\n 469:             static_rows.append({\r\n 470:                 \"policy\": policy_name,\r\n 471:                 \"method\": \"oracle\",\r\n 472:                 \"week\": week,\r\n 473:                 \"n_patients\": n_patients,\r\n 474:                 \"n_cases\": 0,\r\n 475:                 \"draw\": 0,\r\n 476:                 **e12._metrics(\r\n 477:                     test_y, oracle_predictions[policy_name], oracle_brier[policy_name]\r\n 478:                 ),\r\n 479:                 \"w\": float(\"nan\"),\r\n 480:                 \"wall_time_seconds\": 0.0,\r\n 481:             })\r\n 482: \r\n 483:     tasks = [\r\n 484:         {\r\n 485:             \"policy\": policy_name,\r\n 486:             \"policy_index\": policy_index,\r\n 487:             \"draw\": draw,\r\n 488:             \"week\": week,\r\n 489:         }\r\n 490:         for policy_index, policy_name in enumerate(POLICY_NAMES)\r\n 491:         for draw in range(draws)\r\n 492:         for week in weeks\r\n 493:     ]\r\n 494:     job_rows: List[Dict[str, object]] = []\r\n 495:     context = mp.get_context(\"spawn\")\r\n 496:     with context.Pool(\r\n 497:         processes=workers,\r\n 498:         initializer=_init_worker,\r\n 499:         initargs=(\r\n 500:             test_observations,\r\n 501:             test_y,\r\n 502:             oracle_predictions,\r\n 503:             str(params_path),\r\n 504:             lr,\r\n 505:             2 if smoke else steps,\r\n 506:         ),\r\n 507:     ) as pool:\r\n 508:         for result in pool.imap_unordered(_run_job, tasks, chunksize=1):\r\n 509:             job_rows.extend(result[\"rows\"])\r\n 510:             print(\r\n 511:                 f\"DONE {result['policy']} draw={result['draw']} \"\r\n 512:                 f\"week={result['week']} wall={result['elapsed']:.1f}s\",\r\n 513:                 flush=True,\r\n 514:             )\r\n 515: \r\n 516:     rows = static_rows + job_rows\r\n 517:     analysis_dir = ROOT / \"analysis\"\r\n 518:     analysis_dir.mkdir(parents=True, exist_ok=True)\r\n 519:     prefix = \"e13_smoke\" if smoke else \"e13\"\r\n 520:     runs_path = analysis_dir / f\"{prefix}_runs.csv\"\r\n 521:     summary_path = analysis_dir / f\"{prefix}_summary.csv\"\r\n 522:     runs_frame = pd.DataFrame(rows, columns=RUN_COLUMNS)\r\n 523:     policy_order = {name: index for index, name in enumerate(POLICY_NAMES)}\r\n 524:     method_order = {\r\n 525:         \"keep\": 0, \"head_U\": 1, \"head_U_dial\": 2, \"finetune\": 3,\r\n 526:         \"dial_only\": 4, \"oracle\": 5,\r\n 527:     }\r\n 528:     runs_frame[\"_policy_order\"] = runs_frame[\"policy\"].map(policy_order)\r\n 529:     runs_frame[\"_method_order\"] = runs_frame[\"method\"].map(method_order)\r\n 530:     runs_frame.sort_values(\r\n 531:         [\"_policy_order\", \"week\", \"_method_order\", \"draw\"], inplace=True\r\n 532:     )\r\n 533:     runs_frame.drop(columns=[\"_policy_order\", \"_method_order\"]).to_csv(\r\n 534:         runs_path, index=False\r\n 535:     )\r\n 536:     _summary_frame(rows).to_csv(summary_path, index=False)\r\n 537:     print(f\"WROTE {runs_path}\", flush=True)\r\n 538:     print(f\"WROTE {summary_path}\", flush=True)\r\n 539:     return runs_path, summary_path\r\n 540: \r\n 541: \r\n 542: def main(argv: Iterable[str] | None = None) -> None:\r\n 543:     parser = argparse.ArgumentParser(description=__doc__)\r\n 544:     parser.add_argument(\"--smoke\", action=\"store_true\")\r\n 545:     parser.add_argument(\"--workers\", type=int, default=4)\r\n 546:     parser.add_argument(\"--lr\", type=float, default=0.05)\r\n 547:     parser.add_argument(\"--steps\", type=int, default=160)\r\n 548:     parser.add_argument(\"--train-only\", action=\"store_true\")\r\n 549:     args = parser.parse_args(argv)\r\n 550:     run(\r\n 551:         smoke=args.smoke,\r\n 552:         workers=args.workers,\r\n 553:         lr=args.lr,\r\n 554:         steps=args.steps,\r\n 555:         train_only=args.train_only,\r\n 556:     )\r\n 557: \r\n 558: \r\n 559: if __name__ == \"__main__\":\r\n 560:     mp.freeze_support()\r\n 561:     main()\r\n","exit_code":0,"status":"completed"}}
