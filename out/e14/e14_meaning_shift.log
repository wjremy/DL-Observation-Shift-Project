{"type":"item.completed","item":{"id":"item_6","type":"command_execution","command":"\"C:\\\\WINDOWS\\\\System32\\\\WindowsPowerShell\\\\v1.0\\\\powershell.exe\" -Command '$files=@(@{p='\"'e13_rungs_over_time.py';s=1;e=148},@{p='e12_unlabelled_head.py';s=1;e=200},@{p='latent_filter.py';s=214;e=330}); foreach(\"'$f in $files){$a=Get-Content $f.p; \"--- $($f.p) $($f.s)-$($f.e) ---\"; for($i=$f.s-1;$i -lt [Math]::Min($a.Length,$f.e);$i++){ '\"'{0,4}: {1}' -f (\"'$i+1),$a[$i] }}'","aggregated_output":"--- e13_rungs_over_time.py 1-148 ---\r\n   1: \"\"\"E13: compare adaptation rungs as a deployment run-in grows week by week.\r\n   2: \r\n   3: Run from the project folder with ``python e13_rungs_over_time.py``.  The\r\n   4: ``--smoke`` option uses short training/refits and writes separate smoke files.\r\n   5: \"\"\"\r\n   6: \r\n   7: from __future__ import annotations\r\n   8: \r\n   9: import argparse\r\n  10: import json\r\n  11: import multiprocessing as mp\r\n  12: from pathlib import Path\r\n  13: import time\r\n  14: from typing import Dict, Iterable, List, Mapping, Sequence, Tuple\r\n  15: \r\n  16: import numpy as np\r\n  17: import pandas as pd\r\n  18: \r\n  19: import bayes\r\n  20: import sim\r\n  21: \r\n  22: # bayes imports THRESHOLD by value, so patch both modules at import time.  This\r\n  23: # module is imported afresh by spawned workers, which keeps their outcome rule\r\n  24: # aligned with the A model and the main process.\r\n  25: sim.THRESHOLD = 2.05\r\n  26: bayes.THRESHOLD = 2.05\r\n  27: \r\n  28: import e12_unlabelled_head as e12\r\n  29: import latent_filter\r\n  30: \r\n  31: \r\n  32: ROOT = Path(__file__).resolve().parent\r\n  33: SIGMA = 1.0\r\n  34: WEEKS = (1, 2, 4, 8, 13, 26, 52, 104)\r\n  35: SMOKE_WEEKS = (1, 4)\r\n  36: N_PER_WEEK = 25\r\n  37: STREAM_N = 2_600\r\n  38: POLICY_NAMES = (\"B_less\", \"B_more\", \"B_match\", \"B_dense\")\r\n  39: \r\n  40: # All E13 seed ranges are separate from the E5/E12 seeds and from one another.\r\n  41: A_TRAIN_LATENT_SEED = 1_500_000\r\n  42: A_VAL_LATENT_SEED = 1_501_000\r\n  43: A_TRAIN_OBS_SEED = 1_502_000\r\n  44: A_VAL_OBS_SEED = 1_503_000\r\n  45: A_MODEL_SEED = 1_504_337\r\n  46: TEST_LATENT_SEED = 1_550_000\r\n  47: TEST_OBS_SEED_BASE = 1_560_000\r\n  48: STREAM_SEED_BASE = 1_600_000\r\n  49: \r\n  50: RUN_COLUMNS = (\r\n  51:     \"policy\", \"method\", \"week\", \"n_patients\", \"n_cases\", \"draw\",\r\n  52:     \"brier\", \"log_loss\", \"auroc\", \"regret\", \"w\", \"wall_time_seconds\",\r\n  53: )\r\n  54: SUMMARY_METRICS = (\r\n  55:     \"n_patients\", \"n_cases\", \"brier\", \"log_loss\", \"auroc\", \"regret\",\r\n  56:     \"w\", \"wall_time_seconds\",\r\n  57: )\r\n  58: \r\n  59: \r\n  60: def _a_model_paths(smoke: bool) -> Tuple[Path, Path]:\r\n  61:     folder = ROOT / (\"results_smoke\" if smoke else \"results\") / \"E13\" / \"a_model\"\r\n  62:     return folder / \"params.npz\", folder / \"meta.json\"\r\n  63: \r\n  64: \r\n  65: def _observe_cohort(n: int, latent_seed: int, obs_seed: int, policy):\r\n  66:     latent = sim.simulate_latent(n, seed=latent_seed)\r\n  67:     observed = sim.observe(latent, policy, sigma=SIGMA, seed=obs_seed)\r\n  68:     return observed, np.asarray(latent[\"y\"], dtype=np.float32)\r\n  69: \r\n  70: \r\n  71: def _train_or_load_a_model(smoke: bool) -> Tuple[Path, Dict[str, object]]:\r\n  72:     n_train, n_val, max_epochs = (1_000, 300, 3) if smoke else (16_000, 4_000, 200)\r\n  73:     params_path, meta_path = _a_model_paths(smoke)\r\n  74:     train_policy = sim.informative(gamma=2.0, rate=0.3)\r\n  75: \r\n  76:     train_latent = sim.simulate_latent(n_train, seed=A_TRAIN_LATENT_SEED)\r\n  77:     train_y = np.asarray(train_latent[\"y\"], dtype=np.float32)\r\n  78:     training_rate = float(train_y.mean())\r\n  79:     assert 0.01 <= training_rate <= 0.03, (\r\n  80:         f\"E13 A training outcome rate must be 1%-3%; got {training_rate:.4%}\"\r\n  81:     )\r\n  82: \r\n  83:     if params_path.exists() and meta_path.exists():\r\n  84:         with meta_path.open(\"r\", encoding=\"utf-8\") as handle:\r\n  85:             metadata = json.load(handle)\r\n  86:         print(f\"SKIP A model training (cached at {params_path.parent})\", flush=True)\r\n  87:         return params_path, metadata\r\n  88: \r\n  89:     if latent_filter.torch is None:\r\n  90:         raise ImportError(\"PyTorch is required to train the E13 A filter\")\r\n  91:     started = time.perf_counter()\r\n  92:     train_observed = sim.observe(\r\n  93:         train_latent, train_policy, sigma=SIGMA, seed=A_TRAIN_OBS_SEED\r\n  94:     )\r\n  95:     val_observed, val_y = _observe_cohort(\r\n  96:         n_val, A_VAL_LATENT_SEED, A_VAL_OBS_SEED, train_policy\r\n  97:     )\r\n  98:     model, fit_meta = latent_filter.train_filter(\r\n  99:         train_observed[\"x\"], train_observed[\"m\"], train_y,\r\n 100:         val_observed[\"x\"], val_observed[\"m\"], val_y,\r\n 101:         n_states=32,\r\n 102:         max_epochs=max_epochs,\r\n 103:         batch_size=512,\r\n 104:         patience=15,\r\n 105:         seed=A_MODEL_SEED,\r\n 106:     )\r\n 107:     metadata: Dict[str, object] = {\r\n 108:         \"experiment\": \"E13\",\r\n 109:         \"model\": \"latent_filter\",\r\n 110:         \"sigma\": SIGMA,\r\n 111:         \"training_policy\": \"informative_gamma2_rate0.3\",\r\n 112:         \"threshold\": 2.05,\r\n 113:         \"n_train\": n_train,\r\n 114:         \"n_val\": n_val,\r\n 115:         \"n_train_cases\": int(train_y.sum()),\r\n 116:         \"train_outcome_rate\": training_rate,\r\n 117:         \"n_val_cases\": int(np.asarray(val_y).sum()),\r\n 118:         \"train_latent_seed\": A_TRAIN_LATENT_SEED,\r\n 119:         \"val_latent_seed\": A_VAL_LATENT_SEED,\r\n 120:         \"train_observation_seed\": A_TRAIN_OBS_SEED,\r\n 121:         \"val_observation_seed\": A_VAL_OBS_SEED,\r\n 122:         \"model_seed\": A_MODEL_SEED,\r\n 123:         \"best_epoch\": fit_meta[\"best_epoch\"],\r\n 124:         \"epochs\": fit_meta[\"epochs\"],\r\n 125:         \"train_loss\": fit_meta[\"train_loss\"],\r\n 126:         \"val_loss\": fit_meta[\"val_loss\"],\r\n 127:         \"train_bce\": fit_meta[\"train_bce\"],\r\n 128:         \"val_bce\": fit_meta[\"val_bce\"],\r\n 129:         \"train_nll_per_step\": fit_meta[\"train_nll_per_step\"],\r\n 130:         \"val_nll_per_step\": fit_meta[\"val_nll_per_step\"],\r\n 131:         \"wall_time_seconds\": time.perf_counter() - started,\r\n 132:     }\r\n 133:     latent_filter._atomic_npz(params_path, model.numpy_parameters())\r\n 134:     latent_filter._atomic_json(meta_path, metadata)\r\n 135:     print(\r\n 136:         f\"DONE A model training at {params_path.parent} \"\r\n 137:         f\"rate={training_rate:.3%} best_epoch={fit_meta['best_epoch']} \"\r\n 138:         f\"wall={metadata['wall_time_seconds']:.1f}s\",\r\n 139:         flush=True,\r\n 140:     )\r\n 141:     return params_path, metadata\r\n 142: \r\n 143: \r\n 144: def _stream_seeds(policy_index: int, draw: int) -> Tuple[int, int, int]:\r\n 145:     base = STREAM_SEED_BASE + policy_index * 10_000 + draw * 100\r\n 146:     return base, base + 1, base + 2\r\n 147: \r\n 148: \r\n--- e12_unlabelled_head.py 1-200 ---\r\n   1: \"\"\"E12: re-learn the E5 testing head at B with and without outcomes.\r\n   2: \r\n   3: Run from the project folder with ``python e12_unlabelled_head.py``.  The\r\n   4: ``--smoke`` mode uses small cohorts and short refits; normal mode follows the\r\n   5: sizes and optimisation steps in SPEC.md.\r\n   6: \"\"\"\r\n   7: \r\n   8: from __future__ import annotations\r\n   9: \r\n  10: import argparse\r\n  11: import multiprocessing as mp\r\n  12: from pathlib import Path\r\n  13: import time\r\n  14: from typing import Dict, Iterable, List, Mapping, Sequence, Tuple\r\n  15: \r\n  16: import numpy as np\r\n  17: import pandas as pd\r\n  18: \r\n  19: import bayes\r\n  20: import latent_filter\r\n  21: import run_grid\r\n  22: import sim\r\n  23: \r\n  24: \r\n  25: ROOT = Path(__file__).resolve().parent\r\n  26: PARAMS_PATH = ROOT / \"results\" / \"E5\" / \"sigma1_gamma2\" / \"seed0\" / \"filter\" / \"params.npz\"\r\n  27: SIGMA = 1.0\r\n  28: POLICY_NAMES = (\"B_less\", \"B_more\", \"B_match\", \"B_dense\")\r\n  29: POOL_SEED_BASE = 1_300_000\r\n  30: TEST_OBS_SEED_BASE = 1_200_000\r\n  31: RUN_COLUMNS = (\r\n  32:     \"policy\", \"method\", \"size_type\", \"size\", \"draw\", \"brier\", \"log_loss\",\r\n  33:     \"auroc\", \"regret\", \"w\", \"wall_time_seconds\",\r\n  34: )\r\n  35: CURVE_COLUMNS = (\r\n  36:     \"policy\", \"n_U\", \"draw\", \"state_index\", \"mu\", \"refitted_probability\",\r\n  37:     \"true_testing_probability\",\r\n  38: )\r\n  39: \r\n  40: \r\n  41: def _policies() -> Dict[str, sim.Policy]:\r\n  42:     \"\"\"Build the four target policies specified for E12.\"\"\"\r\n  43:     return {\r\n  44:         \"B_less\": sim.informative(gamma=1.0, rate=0.3),\r\n  45:         \"B_more\": sim.informative(gamma=3.5, rate=0.3),\r\n  46:         \"B_match\": sim.uniform(rate=0.3),\r\n  47:         \"B_dense\": sim.uniform(rate=0.6),\r\n  48:     }\r\n  49: \r\n  50: \r\n  51: def _load_parameters(path: Path | str) -> Dict[str, np.ndarray]:\r\n  52:     with np.load(path, allow_pickle=False) as stored:\r\n  53:         return {name: np.asarray(stored[name]).copy() for name in latent_filter.PARAMETER_NAMES}\r\n  54: \r\n  55: \r\n  56: def _sigmoid(values: np.ndarray) -> np.ndarray:\r\n  57:     values = np.asarray(values, dtype=np.float64)\r\n  58:     result = np.empty_like(values)\r\n  59:     positive = values >= 0.0\r\n  60:     result[positive] = 1.0 / (1.0 + np.exp(-values[positive]))\r\n  61:     exp_values = np.exp(values[~positive])\r\n  62:     result[~positive] = exp_values / (1.0 + exp_values)\r\n  63:     return result\r\n  64: \r\n  65: \r\n  66: def auroc_rank(y_true: np.ndarray, scores: np.ndarray) -> float:\r\n  67:     \"\"\"Compute AUROC from average ranks, assigning average ranks to ties.\"\"\"\r\n  68:     y = np.asarray(y_true, dtype=bool).reshape(-1)\r\n  69:     score = np.asarray(scores, dtype=np.float64).reshape(-1)\r\n  70:     if y.size != score.size:\r\n  71:         raise ValueError(\"y_true and scores must have the same length\")\r\n  72:     positives = int(y.sum())\r\n  73:     negatives = y.size - positives\r\n  74:     if positives == 0 or negatives == 0:\r\n  75:         return float(\"nan\")\r\n  76: \r\n  77:     order = np.argsort(score, kind=\"mergesort\")\r\n  78:     ordered = score[order]\r\n  79:     ranks = np.empty(y.size, dtype=np.float64)\r\n  80:     start = 0\r\n  81:     while start < y.size:\r\n  82:         stop = start + 1\r\n  83:         while stop < y.size and ordered[stop] == ordered[start]:\r\n  84:             stop += 1\r\n  85:         # Ranks are one-based; all tied items receive their average rank.\r\n  86:         ranks[order[start:stop]] = 0.5 * ((start + 1) + stop)\r\n  87:         start = stop\r\n  88:     positive_rank_sum = float(ranks[y].sum())\r\n  89:     return (positive_rank_sum - positives * (positives + 1) / 2.0) / (positives * negatives)\r\n  90: \r\n  91: \r\n  92: def _metrics(y: np.ndarray, probability: np.ndarray, oracle_brier: float) -> Dict[str, float]:\r\n  93:     y = np.asarray(y, dtype=np.float64).reshape(-1)\r\n  94:     probability = np.asarray(probability, dtype=np.float64).reshape(-1)\r\n  95:     if y.shape != probability.shape:\r\n  96:         raise ValueError(\"prediction and outcome arrays must have matching shapes\")\r\n  97:     clipped = np.clip(probability, 1e-7, 1.0 - 1e-7)\r\n  98:     brier = float(np.mean((probability - y) ** 2))\r\n  99:     log_loss = float(-np.mean(y * np.log(clipped) + (1.0 - y) * np.log1p(-clipped)))\r\n 100:     return {\r\n 101:         \"brier\": brier,\r\n 102:         \"log_loss\": log_loss,\r\n 103:         \"auroc\": auroc_rank(y, probability),\r\n 104:         \"regret\": brier - float(oracle_brier),\r\n 105:     }\r\n 106: \r\n 107: \r\n 108: def _pool_seeds(policy_index: int, size_type: str, size_index: int, draw: int) -> Tuple[int, int, int]:\r\n 109:     \"\"\"Return disjoint latent, observation, and minibatch seeds for one pool.\"\"\"\r\n 110:     type_offset = 0 if size_type == \"n_L\" else 25_000\r\n 111:     latent_seed = POOL_SEED_BASE + policy_index * 50_000 + type_offset + size_index * 1_000 + draw * 3\r\n 112:     return latent_seed, latent_seed + 1, latent_seed + 2\r\n 113: \r\n 114: \r\n 115: def _observe_pool(n: int, policy: sim.Policy, latent_seed: int, obs_seed: int):\r\n 116:     latent = sim.simulate_latent(n, seed=latent_seed)\r\n 117:     observed = sim.observe(latent, policy, sigma=SIGMA, seed=obs_seed)\r\n 118:     return observed, np.asarray(latent[\"y\"], dtype=np.float32)\r\n 119: \r\n 120: \r\n 121: def _choose_dial_weight(x: np.ndarray, m: np.ndarray, y: np.ndarray,\r\n 122:                         parameters: Mapping[str, np.ndarray]) -> float:\r\n 123:     \"\"\"Choose the labelled run-in log-loss minimiser, breaking ties toward 1.\"\"\"\r\n 124:     weights = np.round(np.arange(0.0, 1.0001, 0.05), 2)\r\n 125:     losses = []\r\n 126:     for weight in weights:\r\n 127:         probability, _ = latent_filter.numpy_forward(x, m, parameters, w=float(weight))\r\n 128:         clipped = np.clip(probability, 1e-7, 1.0 - 1e-7)\r\n 129:         loss = -np.mean(y * np.log(clipped) + (1.0 - y) * np.log1p(-clipped))\r\n 130:         losses.append(float(loss))\r\n 131:     best_loss = min(losses)\r\n 132:     return float(max(weight for weight, loss in zip(weights, losses) if loss == best_loss))\r\n 133: \r\n 134: \r\n 135: def _refit_testing_head(\r\n 136:     observed: Mapping[str, np.ndarray],\r\n 137:     labels: np.ndarray | None,\r\n 138:     parameters: Mapping[str, np.ndarray],\r\n 139:     *,\r\n 140:     batch_seed: int,\r\n 141:     steps: int,\r\n 142:     lr: float = 1e-2,\r\n 143: ) -> Dict[str, np.ndarray]:\r\n 144:     \"\"\"Refit c only, using the E5 likelihood and optional outcome BCE.\"\"\"\r\n 145:     try:\r\n 146:         import torch\r\n 147:         from torch.nn import functional as F\r\n 148:     except ImportError as exc:  # Keep NumPy checks usable without PyTorch.\r\n 149:         raise ImportError(\"PyTorch is required for the E12 head refits\") from exc\r\n 150: \r\n 151:     torch.set_num_threads(1)\r\n 152:     torch.manual_seed(int(batch_seed))\r\n 153:     model = latent_filter.LatentFilter(n_states=int(np.asarray(parameters[\"mu\"]).size))\r\n 154:     with torch.no_grad():\r\n 155:         for name in latent_filter.PARAMETER_NAMES:\r\n 156:             tensor = torch.as_tensor(np.asarray(parameters[name]), dtype=getattr(model, name).dtype)\r\n 157:             getattr(model, name).copy_(tensor)\r\n 158: \r\n 159:     for name, parameter in model.named_parameters():\r\n 160:         parameter.requires_grad_(name == \"c\")\r\n 161:     optimizer = torch.optim.Adam([model.c], lr=float(lr))\r\n 162: \r\n 163:     x = torch.from_numpy(np.ascontiguousarray(observed[\"x\"], dtype=np.float32))\r\n 164:     m = torch.from_numpy(np.ascontiguousarray(observed[\"m\"], dtype=np.float32))\r\n 165:     y_tensor = None if labels is None else torch.from_numpy(np.ascontiguousarray(labels, dtype=np.float32))\r\n 166:     n = int(x.shape[0])\r\n 167:     if n == 0:\r\n 168:         raise ValueError(\"cannot refit the testing head on an empty pool\")\r\n 169:     generator = torch.Generator(device=\"cpu\")\r\n 170:     generator.manual_seed(int(batch_seed))\r\n 171:     model.train()\r\n 172: \r\n 173:     for _ in range(int(steps)):\r\n 174:         # Sampling with replacement keeps every optimizer step at 256 records,\r\n 175:         # including the small labelled run-ins in E12.\r\n 176:         indices = torch.randint(0, n, (256,), generator=generator)\r\n 177:         xb = x.index_select(0, indices)\r\n 178:         mb = m.index_select(0, indices)\r\n 179:         probabilities, log_marginal = model(xb, mb, w=1.0)\r\n 180:         nll_per_step = -log_marginal.mean() / x.shape[1]\r\n 181:         loss = nll_per_step\r\n 182:         if y_tensor is not None:\r\n 183:             yb = y_tensor.index_select(0, indices)\r\n 184:             bce = F.binary_cross_entropy(probabilities.clamp(1e-7, 1.0 - 1e-7), yb)\r\n 185:             loss = bce + nll_per_step\r\n 186:         optimizer.zero_grad(set_to_none=True)\r\n 187:         loss.backward()\r\n 188:         optimizer.step()\r\n 189: \r\n 190:     return model.numpy_parameters()\r\n 191: \r\n 192: \r\n 193: _WORKER_TEST_OBS: Dict[str, Mapping[str, np.ndarray]] = {}\r\n 194: _WORKER_TEST_Y: np.ndarray | None = None\r\n 195: _WORKER_PARAMS_PATH: str | None = None\r\n 196: _WORKER_POLICIES: Dict[str, sim.Policy] = {}\r\n 197: _WORKER_ORACLE_BRIER: Dict[str, float] = {}\r\n 198: \r\n 199: \r\n 200: def _init_worker(\r\n--- latent_filter.py 214-330 ---\r\n 214: def train_filter(\r\n 215:     train_x: np.ndarray,\r\n 216:     train_m: np.ndarray,\r\n 217:     train_y: np.ndarray,\r\n 218:     val_x: np.ndarray,\r\n 219:     val_m: np.ndarray,\r\n 220:     val_y: np.ndarray,\r\n 221:     *,\r\n 222:     n_states: int = 32,\r\n 223:     max_epochs: int = 200,\r\n 224:     batch_size: int = 512,\r\n 225:     patience: int = 15,\r\n 226:     seed: int = 31_337,\r\n 227: ) -> Tuple[LatentFilter, Dict[str, object]]:\r\n 228:     \"\"\"Fit the filter on A data using BCE plus per-step marginal NLL.\"\"\"\r\n 229:     if torch is None:\r\n 230:         raise ImportError(\"PyTorch is required to train E5; NumPy forward is available\")\r\n 231:     torch.set_num_threads(4)\r\n 232:     torch.manual_seed(int(seed))\r\n 233:     np.random.seed(int(seed) % (2**32 - 1))\r\n 234: \r\n 235:     def tensor_data(x, m, y):\r\n 236:         return (\r\n 237:             torch.from_numpy(np.ascontiguousarray(x, dtype=np.float32)),\r\n 238:             torch.from_numpy(np.ascontiguousarray(m, dtype=np.float32)),\r\n 239:             torch.from_numpy(np.ascontiguousarray(y, dtype=np.float32)),\r\n 240:         )\r\n 241: \r\n 242:     x_train, m_train, y_train = tensor_data(train_x, train_m, train_y)\r\n 243:     x_val, m_val, y_val = tensor_data(val_x, val_m, val_y)\r\n 244:     model = LatentFilter(n_states=n_states)\r\n 245:     optimizer = torch.optim.Adam(model.parameters(), lr=1e-2)\r\n 246:     n_train = y_train.shape[0]\r\n 247:     best_loss = float(\"inf\")\r\n 248:     best_state = None\r\n 249:     best_epoch = 0\r\n 250:     stale_epochs = 0\r\n 251:     train_history = []\r\n 252:     val_history = []\r\n 253:     train_bce_history = []\r\n 254:     val_bce_history = []\r\n 255:     train_nll_history = []\r\n 256:     val_nll_history = []\r\n 257: \r\n 258:     def evaluate(x, m, y):\r\n 259:         model.eval()\r\n 260:         total_loss = total_bce = total_nll = 0.0\r\n 261:         with torch.no_grad():\r\n 262:             for start in range(0, y.shape[0], batch_size):\r\n 263:                 stop = start + batch_size\r\n 264:                 probabilities, log_marginal = model(x[start:stop], m[start:stop], w=1.0)\r\n 265:                 bce = F.binary_cross_entropy(\r\n 266:                     probabilities.clamp(1e-7, 1.0 - 1e-7), y[start:stop]\r\n 267:                 )\r\n 268:                 nll = -log_marginal.mean() / x.shape[1]\r\n 269:                 size = y[start:stop].shape[0]\r\n 270:                 total_bce += float(bce) * size\r\n 271:                 total_nll += float(nll) * size\r\n 272:                 total_loss += float(bce + nll) * size\r\n 273:         count = int(y.shape[0])\r\n 274:         return total_loss / count, total_bce / count, total_nll / count\r\n 275: \r\n 276:     for epoch in range(int(max_epochs)):\r\n 277:         model.train()\r\n 278:         permutation = torch.randperm(n_train)\r\n 279:         total_loss = total_bce = total_nll = 0.0\r\n 280:         for start in range(0, n_train, batch_size):\r\n 281:             indices = permutation[start:start + batch_size]\r\n 282:             xb, mb, yb = x_train[indices], m_train[indices], y_train[indices]\r\n 283:             optimizer.zero_grad(set_to_none=True)\r\n 284:             probabilities, log_marginal = model(xb, mb, w=1.0)\r\n 285:             bce = F.binary_cross_entropy(\r\n 286:                 probabilities.clamp(1e-7, 1.0 - 1e-7), yb\r\n 287:             )\r\n 288:             nll = -log_marginal.mean() / x_train.shape[1]\r\n 289:             loss = bce + nll\r\n 290:             loss.backward()\r\n 291:             optimizer.step()\r\n 292:             size = yb.shape[0]\r\n 293:             total_bce += float(bce.detach()) * size\r\n 294:             total_nll += float(nll.detach()) * size\r\n 295:             total_loss += float(loss.detach()) * size\r\n 296:         train_bce = total_bce / n_train\r\n 297:         train_nll = total_nll / n_train\r\n 298:         train_history.append(total_loss / n_train)\r\n 299:         train_bce_history.append(train_bce)\r\n 300:         train_nll_history.append(train_nll)\r\n 301: \r\n 302:         val_loss, val_bce, val_nll = evaluate(x_val, m_val, y_val)\r\n 303:         val_history.append(val_loss)\r\n 304:         val_bce_history.append(val_bce)\r\n 305:         val_nll_history.append(val_nll)\r\n 306:         if val_loss < best_loss - 1e-8:\r\n 307:             best_loss = val_loss\r\n 308:             best_epoch = epoch + 1\r\n 309:             best_state = copy.deepcopy(model.state_dict())\r\n 310:             stale_epochs = 0\r\n 311:         else:\r\n 312:             stale_epochs += 1\r\n 313:         if stale_epochs >= patience:\r\n 314:             break\r\n 315: \r\n 316:     if best_state is not None:\r\n 317:         model.load_state_dict(best_state)\r\n 318:     return model, {\r\n 319:         \"best_epoch\": best_epoch,\r\n 320:         \"epochs\": len(train_history),\r\n 321:         \"train_loss\": train_history,\r\n 322:         \"val_loss\": val_history,\r\n 323:         \"train_bce\": train_bce_history,\r\n 324:         \"val_bce\": val_bce_history,\r\n 325:         \"train_nll_per_step\": train_nll_history,\r\n 326:         \"val_nll_per_step\": val_nll_history,\r\n 327:     }\r\n 328: \r\n 329: \r\n 330: def true_parameters(grid_size: int, sigma: float, policy) -> Dict[str, np.ndarray]:\r\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_7","type":"agent_message","text":"The spec confirms the 2.05 threshold is an E13 import side effect, so I’m isolating E14’s outcome generation and oracle with an explicit, quadrature-solved threshold. E14 will still import and reuse the E12/E13 refit, fine-tuning, metric, and parameter helpers as requested."}}
{"type":"item.started","item":{"id":"item_8","type":"command_execution","command":"\"C:\\\\WINDOWS\\\\System32\\\\WindowsPowerShell\\\\v1.0\\\\powershell.exe\" -Command \"@'\n\\\"\\\"\\\"E14 simulator extension with a hidden binary outcome-risk trait (NumPy only).\\\"\\\"\\\"\n\nfrom __future__ import annotations\n\nfrom dataclasses import dataclass\nfrom functools import lru_cache\nimport math\n\nimport numpy as np\n\nimport bayes\nimport sim\n\n\nU_RATE = 0.3\nDELTA = 1.0\n\n\n@lru_cache(maxsize=1)\ndef outcome_threshold() -> float:\n    \\\"\\\"\\\"Solve the stationary mixture event probability for a 2% outcome rate.\\\"\\\"\\\"\n    lo, hi = -12.0, 12.0\n    for _ in range(100):\n        mid = 0.5 * (lo + hi)\n        prevalence = (\n            (1.0 - U_RATE) * (1.0 - float(bayes._normal_cdf(np.asarray(mid))))\n            + U_RATE * (1.0 - float(bayes._normal_cdf(np.asarray(mid - DELTA))))\n        )\n        if prevalence > 0.02:\n            lo = mid\n        else:\n            hi = mid\n    return 0.5 * (lo + hi)\n\n\ndef simulate_latent_u(n: int, seed: int) -> dict[str, np.ndarray]:\n    \\\"\\\"\\\"Draw the AR(1) path, independent hidden trait, and E14 outcome.\\\"\\\"\\\"\n    latent = sim.simulate_latent(n, seed)\n    z = np.asarray(latent[\\\"z\\\"], dtype=np.float32)\n    z_future = np.asarray(latent[\\\"z_future\\\"], dtype=np.float32)\n    # Keep the trait stream independent of sim.simulate_latent's AR stream.\n    trait_rng = np.random.default_rng([int(seed), 7])\n    u = (trait_rng.random(z.shape[0]) < U_RATE).astype(np.int8)\n    threshold = outcome_threshold()\n    y = (z_future.astype(np.float64) + DELTA * u > threshold).astype(np.int8)\n    return {\\\"z\\\": z, \\\"z_future\\\": z_future, \\\"u\\\": u, \\\"y\\\": y}\n\n\n@dataclass(frozen=True)\nclass UPolicy:\n    \\\"\\\"\\\"Testing policy whose probability depends on latent state and trait.\\\"\\\"\\\"\n\n    name: str\n    rate: float\n    gamma: float\n    beta: float\n    alpha: float\n\n\ndef u_informative(gamma: float, beta: float, rate: float = U_RATE) -> UPolicy:\n    \\\"\\\"\\\"Construct a policy with the requested marginal rate by Gauss-Hermite.\\\"\\\"\\\"\n    gamma, beta, rate = float(gamma), float(beta), float(rate)\n    if not 0.0 < rate < 1.0:\n        raise ValueError(\\\"rate must lie strictly between 0 and 1\\\")\n    if not math.isfinite(gamma) or not math.isfinite(beta):\n        raise ValueError(\\\"gamma and beta must be finite\\\")\n\n    nodes, weights = np.polynomial.hermite.hermgauss(80)\n    z = math.sqrt(2.0) * nodes\n    weights = weights / math.sqrt(math.pi)\n\n    def sigmoid(values: np.ndarray) -> np.ndarray:\n        return sim._sigmoid(values)\n\n    lo, hi = -30.0 - abs(gamma) - abs(beta), 30.0 + abs(gamma) + abs(beta)\n    for _ in range(100):\n        alpha = 0.5 * (lo + hi)\n        marginal = float(\n            (1.0 - U_RATE) * np.dot(weights, sigmoid(alpha + gamma * z))\n            + U_RATE * np.dot(weights, sigmoid(alpha + gamma * z + beta))\n        )\n        if marginal < rate:\n            lo = alpha\n        else:\n            hi = alpha\n    alpha = 0.5 * (lo + hi)\n    return UPolicy(\n        name=f\\\"u_informative_g{gamma:g}_b{beta:g}_r{rate:g}\\\",\n        rate=rate,\n        gamma=gamma,\n        beta=beta,\n        alpha=alpha,\n    )\n\n\ndef observe_u(\n    latent: dict[str, np.ndarray], policy: UPolicy, sigma: float, seed: int\n) -> dict[str, np.ndarray]:\n    \\\"\\\"\\\"Observe latent values under a trait-aware mask, matching sim.observe.\\\"\\\"\\\"\n    z = np.asarray(latent[\\\"z\\\"], dtype=np.float64)\n    u = np.asarray(latent[\\\"u\\\"], dtype=np.float64).reshape(-1)\n    if z.ndim \"'!= 2 or z.shape[1] != sim.T or u.shape != (z.shape[0],):\n        raise ValueError(f\"latent z/u must have shapes (n, {sim.T}) and (n,)\")\n    sigma = float(sigma)\n    if sigma < 0.0:\n        raise ValueError(\"sigma must be nonnegative\")\n\n    rng = np.random.default_rng(seed)\n    probability = sim._sigmoid(\n        policy.alpha + policy.gamma * z + policy.beta * u[:, None]\n    )\n    mask = rng.random(z.shape) < probability\n    noisy = z + sigma * rng.standard_normal(z.shape, dtype=np.float64)\n    x = np.where(mask, noisy, np.nan).astype(np.float32)\n    return {\"x\": x, \"m\": mask.astype(np.int8)}\n\n\ndef _filter_given_u(\n    x: np.ndarray,\n    m: np.ndarray,\n    sigma: float,\n    policy: UPolicy,\n    u_value: int,\n) -> tuple[np.ndarray, np.ndarray]:\n    \"\"\"Return final grid posterior and log evidence for one fixed trait value.\"\"\"\n    grid, initial, transition = bayes._grid_and_transition(bayes.DEFAULT_G)\n    n = x.shape[0]\n    posterior = np.broadcast_to(initial, (n, initial.size)).copy()\n    offset = policy.alpha + policy.beta * float(u_value)\n    logits = offset + policy.gamma * grid\n    log_p = -np.logaddexp(0.0, -logits)\n    log_not_p = -np.logaddexp(0.0, logits)\n    log_evidence = np.zeros(n, dtype=np.float64)\n    tiny = np.finfo(np.float64).tiny\n\n    for t in range(sim.T):\n        predicted = posterior @ transition\n        observed = m[:, t]\n        likelihood = np.broadcast_to(log_not_p, predicted.shape).copy()\n        if np.any(observed):\n            residual = (x[observed, t, None] - grid[None, :]) / sigma\n            # The Gaussian normalizing constant is common to both u branches\n            # and cancels from P(u | history); this is the state-dependent part.\n            likelihood[observed] = log_p[None, :] - 0.5 * residual * residual\n        log_weights = np.log(np.maximum(predicted, tiny)) + likelihood\n        maxima = np.max(log_weights, axis=1)\n        log_normalizers = maxima + np.log(\n            np.exp(log_weights - maxima[:, None]).sum(axis=1)\n        )\n        log_evidence += log_normalizers\n        posterior = np.exp(log_weights - log_normalizers[:, None])\n    return posterior, log_evidence\n\n\ndef bayes_predict_u(\n    x: np.ndarray,\n    m: np.ndarray,\n    sigma: float,\n    policy: UPolicy,\n    threshold: float | None = None,\n    delta: float = DELTA,\n    return_u_probability: bool = False,\n):\n    \"\"\"Exact grid mixture prediction integrating over the hidden trait.\n\n    When ``return_u_probability`` is true, return ``(prediction, P(u=1|h))``.\n    \"\"\"\n    x = np.asarray(x, dtype=np.float64)\n    m = np.asarray(m, dtype=bool)\n    if x.ndim != 2 or x.shape != m.shape or x.shape[1] != sim.T:\n        raise ValueError(f\"x and m must have matching shape (n, {sim.T})\")\n    sigma = float(sigma)\n    delta = float(delta)\n    if sigma <= 0.0:\n        raise ValueError(\"sigma must be positive\")\n    if np.any(m & ~np.isfinite(x)):\n        raise ValueError(\"observed x values must be finite\")\n    if threshold is None:\n        threshold = outcome_threshold()\n    threshold = float(threshold)\n\n    posteriors = []\n    log_evidences = []\n    for u_value in (0, 1):\n        posterior, log_evidence = _filter_given_u(\n            x, m, sigma, policy, u_value\n        )\n        posteriors.append(posterior)\n        log_evidences.append(log_evidence)\n\n    log_weight_0 = math.log(1.0 - U_RATE) + log_evidences[0]\n    log_weight_1 = math.log(U_RATE) + log_evidences[1]\n    log_total = np.logaddexp(log_weight_0, log_weight_1)\n    p_u1 = np.exp(log_weight_1 - log_total)\n\n    grid, _, _ = bayes._grid_and_transition(bayes.DEFAULT_G)\n    future_sd = math.sqrt(1.0 - sim.RHO ** (2 * sim.HORIZON))\n    future_mean = (sim.RHO ** sim.HORIZON) * grid\n    conditional = []\n    for u_value in (0, 1):\n        event_given_state = 1.0 - bayes._normal_cdf(\n            (threshold - delta * u_value - future_mean) / future_sd\n        )\n        conditional.append(posteriors[u_value] @ event_given_state)\n    prediction = (1.0 - p_u1) * conditional[0] + p_u1 * conditional[1]\n    prediction = np.asarray(prediction, dtype=np.float64)\n    p_u1 = np.asarray(p_u1, dtype=np.float64)\n    if return_u_probability:\n        return prediction, p_u1\n    return prediction\n'\"'@ | Set-Content -Encoding utf8 sim_u.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_8","type":"command_execution","command":"\"C:\\\\WINDOWS\\\\System32\\\\WindowsPowerShell\\\\v1.0\\\\powershell.exe\" -Command \"@'\n\\\"\\\"\\\"E14 simulator extension with a hidden binary outcome-risk trait (NumPy only).\\\"\\\"\\\"\n\nfrom __future__ import annotations\n\nfrom dataclasses import dataclass\nfrom functools import lru_cache\nimport math\n\nimport numpy as np\n\nimport bayes\nimport sim\n\n\nU_RATE = 0.3\nDELTA = 1.0\n\n\n@lru_cache(maxsize=1)\ndef outcome_threshold() -> float:\n    \\\"\\\"\\\"Solve the stationary mixture event probability for a 2% outcome rate.\\\"\\\"\\\"\n    lo, hi = -12.0, 12.0\n    for _ in range(100):\n        mid = 0.5 * (lo + hi)\n        prevalence = (\n            (1.0 - U_RATE) * (1.0 - float(bayes._normal_cdf(np.asarray(mid))))\n            + U_RATE * (1.0 - float(bayes._normal_cdf(np.asarray(mid - DELTA))))\n        )\n        if prevalence > 0.02:\n            lo = mid\n        else:\n            hi = mid\n    return 0.5 * (lo + hi)\n\n\ndef simulate_latent_u(n: int, seed: int) -> dict[str, np.ndarray]:\n    \\\"\\\"\\\"Draw the AR(1) path, independent hidden trait, and E14 outcome.\\\"\\\"\\\"\n    latent = sim.simulate_latent(n, seed)\n    z = np.asarray(latent[\\\"z\\\"], dtype=np.float32)\n    z_future = np.asarray(latent[\\\"z_future\\\"], dtype=np.float32)\n    # Keep the trait stream independent of sim.simulate_latent's AR stream.\n    trait_rng = np.random.default_rng([int(seed), 7])\n    u = (trait_rng.random(z.shape[0]) < U_RATE).astype(np.int8)\n    threshold = outcome_threshold()\n    y = (z_future.astype(np.float64) + DELTA * u > threshold).astype(np.int8)\n    return {\\\"z\\\": z, \\\"z_future\\\": z_future, \\\"u\\\": u, \\\"y\\\": y}\n\n\n@dataclass(frozen=True)\nclass UPolicy:\n    \\\"\\\"\\\"Testing policy whose probability depends on latent state and trait.\\\"\\\"\\\"\n\n    name: str\n    rate: float\n    gamma: float\n    beta: float\n    alpha: float\n\n\ndef u_informative(gamma: float, beta: float, rate: float = U_RATE) -> UPolicy:\n    \\\"\\\"\\\"Construct a policy with the requested marginal rate by Gauss-Hermite.\\\"\\\"\\\"\n    gamma, beta, rate = float(gamma), float(beta), float(rate)\n    if not 0.0 < rate < 1.0:\n        raise ValueError(\\\"rate must lie strictly between 0 and 1\\\")\n    if not math.isfinite(gamma) or not math.isfinite(beta):\n        raise ValueError(\\\"gamma and beta must be finite\\\")\n\n    nodes, weights = np.polynomial.hermite.hermgauss(80)\n    z = math.sqrt(2.0) * nodes\n    weights = weights / math.sqrt(math.pi)\n\n    def sigmoid(values: np.ndarray) -> np.ndarray:\n        return sim._sigmoid(values)\n\n    lo, hi = -30.0 - abs(gamma) - abs(beta), 30.0 + abs(gamma) + abs(beta)\n    for _ in range(100):\n        alpha = 0.5 * (lo + hi)\n        marginal = float(\n            (1.0 - U_RATE) * np.dot(weights, sigmoid(alpha + gamma * z))\n            + U_RATE * np.dot(weights, sigmoid(alpha + gamma * z + beta))\n        )\n        if marginal < rate:\n            lo = alpha\n        else:\n            hi = alpha\n    alpha = 0.5 * (lo + hi)\n    return UPolicy(\n        name=f\\\"u_informative_g{gamma:g}_b{beta:g}_r{rate:g}\\\",\n        rate=rate,\n        gamma=gamma,\n        beta=beta,\n        alpha=alpha,\n    )\n\n\ndef observe_u(\n    latent: dict[str, np.ndarray], policy: UPolicy, sigma: float, seed: int\n) -> dict[str, np.ndarray]:\n    \\\"\\\"\\\"Observe latent values under a trait-aware mask, matching sim.observe.\\\"\\\"\\\"\n    z = np.asarray(latent[\\\"z\\\"], dtype=np.float64)\n    u = np.asarray(latent[\\\"u\\\"], dtype=np.float64).reshape(-1)\n    if z.ndim \"'!= 2 or z.shape[1] != sim.T or u.shape != (z.shape[0],):\n        raise ValueError(f\"latent z/u must have shapes (n, {sim.T}) and (n,)\")\n    sigma = float(sigma)\n    if sigma < 0.0:\n        raise ValueError(\"sigma must be nonnegative\")\n\n    rng = np.random.default_rng(seed)\n    probability = sim._sigmoid(\n        policy.alpha + policy.gamma * z + policy.beta * u[:, None]\n    )\n    mask = rng.random(z.shape) < probability\n    noisy = z + sigma * rng.standard_normal(z.shape, dtype=np.float64)\n    x = np.where(mask, noisy, np.nan).astype(np.float32)\n    return {\"x\": x, \"m\": mask.astype(np.int8)}\n\n\ndef _filter_given_u(\n    x: np.ndarray,\n    m: np.ndarray,\n    sigma: float,\n    policy: UPolicy,\n    u_value: int,\n) -> tuple[np.ndarray, np.ndarray]:\n    \"\"\"Return final grid posterior and log evidence for one fixed trait value.\"\"\"\n    grid, initial, transition = bayes._grid_and_transition(bayes.DEFAULT_G)\n    n = x.shape[0]\n    posterior = np.broadcast_to(initial, (n, initial.size)).copy()\n    offset = policy.alpha + policy.beta * float(u_value)\n    logits = offset + policy.gamma * grid\n    log_p = -np.logaddexp(0.0, -logits)\n    log_not_p = -np.logaddexp(0.0, logits)\n    log_evidence = np.zeros(n, dtype=np.float64)\n    tiny = np.finfo(np.float64).tiny\n\n    for t in range(sim.T):\n        predicted = posterior @ transition\n        observed = m[:, t]\n        likelihood = np.broadcast_to(log_not_p, predicted.shape).copy()\n        if np.any(observed):\n            residual = (x[observed, t, None] - grid[None, :]) / sigma\n            # The Gaussian normalizing constant is common to both u branches\n            # and cancels from P(u | history); this is the state-dependent part.\n            likelihood[observed] = log_p[None, :] - 0.5 * residual * residual\n        log_weights = np.log(np.maximum(predicted, tiny)) + likelihood\n        maxima = np.max(log_weights, axis=1)\n        log_normalizers = maxima + np.log(\n            np.exp(log_weights - maxima[:, None]).sum(axis=1)\n        )\n        log_evidence += log_normalizers\n        posterior = np.exp(log_weights - log_normalizers[:, None])\n    return posterior, log_evidence\n\n\ndef bayes_predict_u(\n    x: np.ndarray,\n    m: np.ndarray,\n    sigma: float,\n    policy: UPolicy,\n    threshold: float | None = None,\n    delta: float = DELTA,\n    return_u_probability: bool = False,\n):\n    \"\"\"Exact grid mixture prediction integrating over the hidden trait.\n\n    When ``return_u_probability`` is true, return ``(prediction, P(u=1|h))``.\n    \"\"\"\n    x = np.asarray(x, dtype=np.float64)\n    m = np.asarray(m, dtype=bool)\n    if x.ndim != 2 or x.shape != m.shape or x.shape[1] != sim.T:\n        raise ValueError(f\"x and m must have matching shape (n, {sim.T})\")\n    sigma = float(sigma)\n    delta = float(delta)\n    if sigma <= 0.0:\n        raise ValueError(\"sigma must be positive\")\n    if np.any(m & ~np.isfinite(x)):\n        raise ValueError(\"observed x values must be finite\")\n    if threshold is None:\n        threshold = outcome_threshold()\n    threshold = float(threshold)\n\n    posteriors = []\n    log_evidences = []\n    for u_value in (0, 1):\n        posterior, log_evidence = _filter_given_u(\n            x, m, sigma, policy, u_value\n        )\n        posteriors.append(posterior)\n        log_evidences.append(log_evidence)\n\n    log_weight_0 = math.log(1.0 - U_RATE) + log_evidences[0]\n    log_weight_1 = math.log(U_RATE) + log_evidences[1]\n    log_total = np.logaddexp(log_weight_0, log_weight_1)\n    p_u1 = np.exp(log_weight_1 - log_total)\n\n    grid, _, _ = bayes._grid_and_transition(bayes.DEFAULT_G)\n    future_sd = math.sqrt(1.0 - sim.RHO ** (2 * sim.HORIZON))\n    future_mean = (sim.RHO ** sim.HORIZON) * grid\n    conditional = []\n    for u_value in (0, 1):\n        event_given_state = 1.0 - bayes._normal_cdf(\n            (threshold - delta * u_value - future_mean) / future_sd\n        )\n        conditional.append(posteriors[u_value] @ event_given_state)\n    prediction = (1.0 - p_u1) * conditional[0] + p_u1 * conditional[1]\n    prediction = np.asarray(prediction, dtype=np.float64)\n    p_u1 = np.asarray(p_u1, dtype=np.float64)\n    if return_u_probability:\n        return prediction, p_u1\n    return prediction\n'\"'@ | Set-Content -Encoding utf8 sim_u.py\"","aggregated_output":"","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_9","type":"command_execution","command":"\"C:\\\\WINDOWS\\\\System32\\\\WindowsPowerShell\\\\v1.0\\\\powershell.exe\" -Command \"@'\n\\\"\\\"\\\"E14: outcome-only meaning shifts and adaptation over deployment weeks.\\\"\\\"\\\"\n\nfrom __future__ import annotations\n\nimport argparse\nimport json\nimport multiprocessing as mp\nfrom pathlib import Path\nimport time\nfrom typing import Dict, Iterable, List, Mapping, Sequence, Tuple\n\nimport numpy as np\nimport pandas as pd\n\nimport sim\nimport sim_u\nimport e12_unlabelled_head as e12\nimport e13_rungs_over_time as e13\nimport latent_filter\n\n\nROOT = Path(__file__).resolve().parent\nSIGMA = 1.0\nDIRECTIONS = (\\\"gain\\\", \\\"lose\\\")\nWEEKS = (4, 13, 52, 104)\nSMOKE_WEEKS = (4, 13)\nN_PER_WEEK = 25\nSTREAM_N = 2_600\n\n# E14's seed ranges are disjoint from E12 and E13. The latent test cohort is\n# shared by both directions; each direction receives its own B observation draw.\nA_TRAIN_LATENT_SEED = 1_700_000\nA_VAL_LATENT_SEED = 1_701_000\nA_TRAIN_OBS_SEED = 1_702_000\nA_VAL_OBS_SEED = 1_703_000\nA_MODEL_SEED = 1_704_337\nTEST_LATENT_SEED = 1_750_000\nTEST_OBS_SEED_BASE = 1_760_000\nSTREAM_SEED_BASE = 1_800_000\n\nRUN_COLUMNS = (\n    \\\"direction\\\", \\\"method\\\", \\\"week\\\", \\\"n_patients\\\", \\\"n_cases\\\", \\\"draw\\\",\n    \\\"brier\\\", \\\"log_loss\\\", \\\"auroc\\\", \\\"regret\\\", \\\"w\\\", \\\"wall_time_seconds\\\",\n)\nSUMMARY_METRICS = (\n    \\\"n_patients\\\", \\\"n_cases\\\", \\\"brier\\\", \\\"log_loss\\\", \\\"auroc\\\", \\\"regret\\\",\n    \\\"w\\\", \\\"wall_time_seconds\\\",\n)\nMETHOD_ORDER = {\n    \\\"keep\\\": 0,\n    \\\"head_U\\\": 1,\n    \\\"dial_only\\\": 2,\n    \\\"head_L\\\": 3,\n    \\\"finetune_lr05\\\": 4,\n    \\\"finetune_lr005\\\": 5,\n    \\\"oracle\\\": 6,\n}\n\n\ndef _direction_policies() -> Dict[str, Dict[str, sim_u.UPolicy]]:\n    return {\n        \\\"gain\\\": {\n            \\\"A\\\": sim_u.u_informative(gamma=2.0, beta=0.0),\n            \\\"B\\\": sim_u.u_informative(gamma=2.0, beta=2.0),\n        },\n        \\\"lose\\\": {\n            \\\"A\\\": sim_u.u_informative(gamma=2.0, beta=2.0),\n            \\\"B\\\": sim_u.u_informative(gamma=2.0, beta=0.0),\n        },\n    }\n\n\ndef _a_model_paths(direction: str, smoke: bool) -> Tuple[Path, Path]:\n    root = ROOT / (\\\"results_smoke\\\" if smoke else \\\"results\\\") / \\\"E14\\\"\n    folder = root / f\\\"a_model_{direction}\\\"\n    return folder / \\\"params.npz\\\", folder / \\\"meta.json\\\"\n\n\ndef _load_a_parameters(path: Path | str) -> Dict[str, np.ndarray]:\n    return e12._load_parameters(path)\n\n\ndef _train_or_load_a_model(\n    direction: str, smoke: bool, policy: sim_u.UPolicy\n) -> Tuple[Path, Dict[str, object]]:\n    n_train, n_val, max_epochs = (1_000, 300, 3) if smoke else (16_000, 4_000, 200)\n    params_path, meta_path = _a_model_paths(direction, smoke)\n    params_path.parent.mkdir(parents=True, exist_ok=True)\n\n    train_latent = sim_u.simulate_latent_u(n_train, seed=A_TRAIN_LATENT_SEED)\n    train_y = np.asarray(train_latent[\\\"y\\\"], dtype=np.float32)\n    training_rate = float(train_y.mean())\n    assert 0.01 <= training_rate <= 0.03, (\n        f\\\"E14 {direction} A training outcome rate must be 1%-3%; \\\"\n        f\\\"got {training_rate:.4%}\\\"\n    )\n\n    if params_path.exists() and meta_path.exists():\n        with meta_path.open(\\\"r\\\", encoding=\\\"utf-8\\\") as handle:\n            metadata = json.load(handle)\n        print(f\\\"SKIP A model training (cached at {params_path.parent})\\\", flush=True)\n        return params_path, metadata\n\n    if latent_filter.torch is None:\n        raise ImportError(\\\"PyTorch is required to train the E14 A filter\\\")\n    started = time.perf_counter()\n    train_observed = sim_u.observe_u(\n        train_latent, policy, sigma=SIGMA, seed=A_TRAIN_OBS_SEED\n    )\n    val_latent = sim_u.simulate_latent_u(n_val, seed=A_VAL_LATENT_SEED)\n    val_observed = sim_u.observe_u(\n        val_latent, policy, sigma=SIGMA, seed=A_VAL_OBS_SEED\n    )\n    val_y = np.asarray(val_latent[\\\"y\\\"], dtype=np.float32)\n    model, fit_meta = latent_filter.train_filter(\n        train_observed[\\\"x\\\"], train_observed[\\\"m\\\"], train_y,\n        val_observed[\\\"x\\\"], val_observed[\\\"m\\\"], val_y,\n        n_states=32,\n        max_epochs=max_epochs,\n        batch_size=512,\n        patience=15,\n        seed=A_MODEL_SEED,\n    )\n    wall_time = time.perf_counter() - started\n    metadata: Dict[str, object] = {\n        \\\"experiment\\\": \\\"E14\\\",\n        \\\"direction\\\": direction,\n        \\\"model\\\": \\\"latent_filter\\\",\n        \\\"sigma\\\": SIGMA,\n        \\\"training_policy\\\": policy.name,\n        \\\"threshold\\\": sim_u.outcome_threshold(),\n        \\\"outcome_rate\\\": training_rate,\n        \\\"cases\\\": int(train_y.sum()),\n        \\\"n_train\\\": n_train,\n        \\\"n_val\\\": n_val,\n        \\\"n_train_cases\\\": int(train_y.sum()),\n        \\\"train_outcome_rate\\\": training_rate,\n        \\\"n_val_cases\\\": int(val_y.sum()),\n        \\\"train_latent_seed\\\": A_TRAIN_LATENT_SEED,\n        \\\"val_latent_seed\\\": A_VAL_LATENT_SEED,\n        \\\"train_observation_seed\\\": A_TRAIN_OBS_SEED,\n        \\\"val_observation_seed\\\": A_VAL_OBS_SEED,\n        \\\"model_seed\\\": A_MODEL_SEED,\n        \\\"best_epoch\\\": fit_meta[\\\"best_epoch\\\"],\n        \\\"epochs\\\": fit_meta[\\\"epochs\\\"],\n        \\\"train_loss\\\": fit_meta[\\\"train_loss\\\"],\n        \\\"val_loss\\\": fit_meta[\\\"val_loss\\\"],\n        \\\"train_bce\\\": fit_meta[\\\"train_bce\\\"],\n        \\\"val_bce\\\": fit_meta[\\\"val_bce\\\"],\n        \\\"train_nll_per_step\\\": fit_meta[\\\"train_nll_per_step\\\"],\n        \\\"val_nll_per_step\\\": fit_meta[\\\"val_nll_per_step\\\"],\n        \\\"wall_time_seconds\\\": wall_time,\n    }\n    latent_filter._atomic_npz(params_path, model.numpy_parameters())\n    latent_filter._atomic_json(meta_path, metadata)\n    print(\n        f\\\"DONE A model {direction} at {params_path.parent} \\\"\n        f\\\"rate={training_rate:.3%} best_epoch={fit_meta['best_epoch']} \\\"\n        f\\\"wall={wall_time:.1f}s\\\",\n        flush=True,\n    )\n    return params_path, metadata\n\n\ndef _stream_seeds(direction_index: int, draw: int) -> Tuple[int, int, int]:\n    base = STREAM_SEED_BASE + direction_index * 100_000 + draw * 1_000\n    return base, base + 1, base + 2\n\n\ndef _copy_parameters(parameters: Mapping[str, np.ndarray]) -> Dict[str, np.ndarray]:\n    return {\n        name: np.asarray(parameters[name]).copy()\n        for name in latent_filter.PARAMETER_NAMES\n    }\n\n\n_WORKER_TEST_OBS: Dict[str, Mapping[str, np.ndarray]] = {}\n_WORKER_TEST_Y: np.ndarray | None = None\n_WORKER_ORACLE: Dict[str, np.ndarray] = {}\n_WORKER_ORACLE_BRIER: Dict[str, float] = {}\n_WORKER_PARAMS: Dict[str, Dict[str, np.ndarray]] = {}\n_WORKER_B_POLICIES: Dict[str, sim_u.UPolicy] = {}\n_WORKER_STEPS = 160\n\n\ndef _init_worker(\n    test_observations: Dict[str, Mapping[str, np.ndarray]],\n    test_y: np.ndarray,\n    oracle_predictions: Dict[str, np.ndarray],\n    params_paths: Dict[str, str],\n    b_policies: Dict[str, sim_u.UPolicy],\n    steps: int,\n) -> None:\n    global _WORKER_TEST_OBS, _WORKER_TEST_Y, _WORKER_ORACLE\n    global _WORKER_ORACLE_BRIER, _WORKER_PARAMS, _WORKER_B_POLICIES, _WORKER_STEPS\n    try:\n        import torch\n    except ImportError as exc:\n        raise ImportError(\\\"PyTorch is required to run E14 adaptation jobs\\\") from exc\n    torch.set_num_threads(1)\n    _WORKER_TEST_OBS = test_observations\n    _WORKER_TEST_Y = np.asarray(test_y)\n    _WORKER_ORACLE = oracle_predictions\n    _WORKER_ORACLE_BRIER = {\n        direction: float(np.mean((prediction - _WORKER_TEST_Y) ** 2))\n        for direction, prediction in oracle_predictions.items()\n    }\n    _WORKER_PARAMS = {\n        direction: _load_a_parameters(path)\n        for direction, path in params_paths.items()\n    }\n    _WORKER_B_POLICIES = b_policies\n    _WORKER_STEPS = int(steps)\n\n\ndef _run_job(task: Mapping[str, object]) -> Dict[str, object]:\n    if _WORKER_TEST_Y is None:\n        raise RuntimeError(\\\"E14 worker was not initialized\\\")\n    started = time.perf_counter()\n    direction = str(task[\\\"direction\\\"])\n    direction_index = int(task[\\\"direction_index\\\"])\n    draw = int(task[\\\"draw\\\"])\n    week = int(task[\\\"week\\\"])\n    n_patients = N_PER_WEEK * week\n    latent_seed, observation_seed, batch_seed = _stream_seeds(direction_index, draw)\n\n    stream_latent = sim_u.simulate_latent_u(STREAM_N, seed=latent_seed)\n    stream_all = sim_u.observe_u(\n        stream_latent,\n        _WORKER_B_POLICIES[direction],\n        sigma=SIGMA,\n        seed=observation_seed,\n    )\n    stream = {\n        \\\"x\\\": np.asarray(stream_all[\\\"x\\\"][:n_patients], dtype=np.float32),\n        \\\"m\\\": np.asarray(stream_all[\\\"m\\\"][:n_patients], dtype=np.int8),\n    }\n    stream_y = np.asarray(stream_latent[\\\"y\\\"][:n_patients], dtype=np.float32)\n    n_cases = int(stream_y.sum())\n    test_observed = _WORKER_TEST_OBS[direction]\n    test_y = _WORKER_TEST_Y\n    oracle_brier = _WORKER_ORACLE_BRIER[direction]\n    parameters = _WORKER_PARAMS[direction]\n    rows: List[Dict[str, object]] = []\n\n    method_started = time.perf_counter()\n    head_u_params = e12._refit_testing_head(\n        stream,\n        None,\n        parameters,\n        batch_seed=batch_seed,\n        steps=_WORKER_STEPS,\n        lr=0.05,\n    )\n    head_u_prediction, _ = latent_filter.numpy_forward(\n        test_observed[\\\"x\\\"], test_observed[\\\"m\\\"], head_u_params, w=1.0\n    )\n    rows.append({\n        \\\"direction\\\": direction,\n        \\\"method\\\": \\\"head_U\\\",\n        \\\"week\\\": week,\n        \\\"n_patients\\\": n_patients,\n        \\\"n_cases\\\": 0,\n        \\\"draw\\\": draw,\n        **e12._metrics(test_y, head_u_prediction, oracle_brier),\n        \\\"w\\\": 1.0,\n        \\\"wall_time_seconds\\\": time.perf_counter() - method_started,\n    })\n\n    method_started = time.perf_counter()\n    dial_weight = e13._choose_penalized_weight(\n        stream[\\\"x\\\"], stream[\\\"m\\\"], stream_y, parameters\n    )\n    dial_prediction, _ = latent_filter.numpy_forward(\n        test_observed[\\\"x\\\"], test_observed[\\\"m\\\"], parameters, w=dial_weight\n    )\n    rows.append({\n        \\\"direction\\\": direction,\n        \\\"method\\\": \\\"dial_only\\\",\n        \\\"week\\\": week,\n        \\\"n_patients\\\": n_patients,\n        \\\"n_cases\\\": n_cases,\n        \\\"draw\\\": draw,\n        **e12._metrics(test_y, dial_prediction, oracle_brier),\n        \\\"w\\\": dial_weight,\n        \\\"wall_time_seconds\\\": time.perf_counter() - method_started,\n    })\n\n    method_started = time.perf_counter()\n    if n_cases == 0:\n        head_l_params = _copy_parameters(parameters)\n    else:\n        head_l_params = e12._refit_testing_head(\n            stream,\n            stream_y,\n            parameters,\n            batch_seed=batch_seed + 7,\n            steps=_WORKER_STEPS,\n            lr=0.05,\n        )\n    head_l_prediction, _ = latent_filter.numpy_forward(\n        test_observed[\\\"x\\\"], test_observed[\\\"m\\\"], head_l_params, w=1.0\n    )\n    rows.append({\n        \\\"direction\\\": direction,\n        \\\"method\\\": \\\"head_L\\\",\n        \\\"week\\\": week,\n        \\\"n_patients\\\": n_patients,\n        \\\"n_cases\\\": n_cases,\n        \\\"draw\\\": draw,\n        **e12._metrics(test_y, head_l_prediction, oracle_brier),\n        \\\"w\\\": 1.0,\n        \\\"wall_time_seconds\\\": time.perf_counter() - method_started,\n    })\n\n    for method, lr in ((\\\"finetune_lr05\\\", 0.05), (\\\"finetune_lr005\\\", 0.005)):\n        method_started = time.perf_counter()\n        finetuned = e13._finetune(\n            stream,\n            stream_y,\n            parameters,\n            batch_seed=batch_seed + 17,\n            steps=_WORKER_STEPS,\n            lr=lr,\n        )\n        prediction, _ = latent_filter.numpy_forward(\n            test_observed[\\\"x\\\"], test_observed[\\\"m\\\"], finetuned, w=1.0\n        )\n        rows.append({\n            \\\"direction\\\": direction,\n            \\\"method\\\": method,\n            \\\"week\\\": week,\n            \\\"n_patients\\\": n_patients,\n            \\\"n_cases\\\": n_cases,\n            \\\"draw\\\": draw,\n            **e12._metrics(test_y, prediction, oracle_brier),\n            \\\"w\\\": 1.0,\n            \\\"wall_time_seconds\\\": time.perf_counter() - method_started,\n        })\n\n    return {\n        \\\"direction\\\": direction,\n        \\\"week\\\": week,\n        \\\"draw\\\": draw,\n        \\\"rows\\\": rows,\n        \\\"elapsed\\\": time.perf_counter() - started,\n    }\n\n\ndef _make_test_cohort(\n    n_test: int,\n    policies: Dict[str, Dict[str, sim_u.UPolicy]],\n) -> Tuple[\n    np.ndarray,\n    np.ndarray,\n    Dict[str, Mapping[str, np.ndarray]],\n    Dict[str, np.ndarray],\n    Dict[str, Dict[str, float]],\n]:\n    latent = sim_u.simulate_latent_u(n_test, seed=TEST_LATENT_SEED)\n    test_y = np.asarray(latent[\\\"y\\\"], dtype=np.float32)\n    test_u = np.asarray(latent[\\\"u\\\"], dtype=np.int8)\n    threshold = sim_u.outcome_threshold()\n    observations: Dict[str, Mapping[str, np.ndarray]] = {}\n    oracle_predictions: Dict[str, np.ndarray] = {}\n    shift_size: Dict[str, Dict[str, float]] = {}\n    for direction_index, direction in enumerate(DIRECTIONS):\n        b_policy = policies[direction][\\\"B\\\"]\n        observed = sim_u.observe_u(\n            latent,\n            b_policy,\n            sigma=SIGMA,\n            seed=TEST_OBS_SEED_BASE + direction_index,\n        )\n        prediction, p_u1 = sim_u.bayes_predict_u(\n            observed[\\\"x\\\"],\n            observed[\\\"m\\\"],\n            SIGMA,\n            b_policy,\n            threshold=threshold,\n            return_u_probability=True,\n        )\n        keep, _ = latent_filter.numpy_forward(\n            observed[\\\"x\\\"], observed[\\\"m\\\"],\n            _load_a_parameters(_a_model_paths(direction, smoke=False)[0]),\n            w=1.0,\n        )\n        oracle_brier = float(np.mean((prediction - test_y) ** 2))\n        shift_size[direction] = {\n            \\\"direction\\\": direction,\n            \\\"keep_auroc\\\": e12.auroc_rank(test_y, keep),\n            \\\"oracle_auroc\\\": e12.auroc_rank(test_y, prediction),\n            \\\"keep_regret\\\": float(np.mean((keep - test_y) ** 2) - oracle_brier),\n            \\\"mean_p_u1_given_h_u1\\\": float(p_u1[test_u == 1].mean()),\n            \\\"mean_p_u1_given_h_u0\\\": float(p_u1[test_u == 0].mean()),\n        }\n        observations[direction] = observed\n        oracle_predictions[direction] = prediction\n    return test_y, test_u, observations, oracle_predictions, shift_size\n\n\ndef _summary_frame(rows: Sequence[Mapping[str, object]]) -> pd.DataFrame:\n    frame = pd.DataFrame(rows, columns=RUN_COLUMNS)\n    grouped = frame.groupby([\\\"direction\\\", \\\"method\\\", \\\"week\\\"], sort=False)[\n        list(SUMMARY_METRICS)\n    ].agg([\\\"mean\\\", \\\"min\\\", \\\"max\\\"])\n    grouped.columns = [f\\\"{column}_{stat}\\\" for column, stat in grouped.columns]\n    return grouped.reset_index()\n\n\ndef run(\n    *, smoke: bool = False, workers: int = 4, draws: int = 2, train_only: bool = False\n) -> Tuple[Path | None, Path | None, Path | None]:\n    if workers < 1:\n        raise ValueError(\\\"--workers must be at least 1\\\")\n    if draws < 1:\n        raise ValueError(\\\"--draws must be at least 1\\\")\n\n    policies = _direction_policies()\n    params_paths: Dict[str, Path] = {}\n    for direction in DIRECTIONS:\n        path, _ = _train_or_load_a_model(\n            direction, smoke, policies[direction][\\\"A\\\"]\n        )\n        params_paths[direction] = path\n    if train_only:\n        return None, None, None\n\n    n_test = 500 if smoke else 10_000\n    weeks = SMOKE_WEEKS if smoke else WEEKS\n    n_draws = 1 if smoke else draws\n    test_y, _test_u, test_observations, oracle_predictions, shift_size = (\n        _make_test_cohort(n_test, policies)\n    )\n    params = {\n        direction: _load_a_parameters(params_paths[direction])\n        for direction in DIRECTIONS\n    }\n    oracle_brier = {\n        direction: float(np.mean((oracle_predictions[direction] - test_y) ** 2))\n        for direction in DIRECTIONS\n    }\n\n    static_rows: List[Dict[str, object]] = []\n    for direction in DIRECTIONS:\n        observed = test_observations[direction]\n        keep_prediction, _ = latent_filter.numpy_forward(\n            observed[\\\"x\\\"], observed[\\\"m\\\"], params[direction], w=1.0\n        )\n        for week in weeks:\n            n_patients = N_PER_WEEK * week\n            for method, prediction in (\n                (\\\"keep\\\", keep_prediction),\n                (\\\"oracle\\\", oracle_predictions[direction]),\n            ):\n                static_rows.append({\n                    \\\"direction\\\": direction,\n                    \\\"method\\\": method,\n                    \\\"week\\\": week,\n                    \\\"n_patients\\\": n_patients,\n                    \\\"n_cases\\\": 0,\n                    \\\"draw\\\": 0,\n                    **e12._metrics(test_y, prediction, oracle_brier[direction]),\n                    \\\"w\\\": 1.0 if method == \\\"keep\\\" else float(\\\"nan\\\"),\n                    \\\"wall_time_seconds\\\": 0.0,\n                })\n\n    tasks = [\n        {\n            \\\"direction\\\": direction,\n            \\\"direction_index\\\": direction_index,\n            \\\"draw\\\": draw,\n            \\\"week\\\": week,\n        }\n        for direction_index, direction in enumerate(DIRECTIONS)\n        for draw in range(n_draws)\n        for week in weeks\n    ]\n    job_rows: List[Dict[str, object]] = []\n    context = mp.get_context(\\\"spawn\\\")\n    with context.Pool(\n        processes=workers,\n        initializer=_init_worker,\n        initargs=(\n            test_observations,\n            test_y,\n            oracle_predictions,\n            {direction: str(params_paths[direction]) for direction in DIRECTIONS},\n            {direction: policies[direction][\\\"B\\\"] for direction in DIRECTIONS},\n            2 if smoke else 160,\n        ),\n    ) as pool:\n        for result in pool.imap_unordered(_run_job, tasks, chunksize=1):\n            job_rows.extend(result[\\\"rows\\\"])\n            print(\n                f\\\"DONE {result['direction']} draw={result['draw']} \\\"\n                f\\\"week={result['week']} wall={result['elapsed']:.1f}s\\\",\n                flush=True,\n            )\n\n    rows = static_rows + job_rows\n    analysis_dir = ROOT / \\\"analysis\\\"\n    analysis_dir.mkdir(parents=True, exist_ok=True)\n    prefix = \\\"e14_smoke\\\" if smoke else \\\"e14\\\"\n    runs_path = analysis_dir / f\\\"{prefix}_runs.csv\\\"\n    summary_path = analysis_dir / f\\\"{prefix}_summary.csv\\\"\n    shift_path = analysis_dir / f\\\"{prefix}_shift_size.csv\\\"\n\n    runs_frame = pd.DataFrame(rows, columns=RUN_COLUMNS)\n    direction_order = {name: index for index, name in enumerate(DIRECTIONS)}\n    runs_frame[\\\"_direction_order\\\"] = runs_frame[\\\"direction\\\"].map(direction_order)\n    runs_frame[\\\"_method_order\\\"] = runs_frame[\\\"method\\\"].map(METHOD_ORDER)\n    runs_frame.sort_values(\n        [\\\"_direction_order\\\", \\\"week\\\", \\\"_method_order\\\", \\\"draw\\\"], inplace=True\n    )\n    runs_frame.drop(columns=[\\\"_direction_order\\\", \\\"_method_order\\\"]).to_csv(\n        runs_path, index=False\n    )\n    _summary_frame(rows).to_csv(summary_path, index=False)\n    pd.DataFrame([shift_size[name] for name in DIRECTIONS]).to_csv(\n        shift_path, index=False\n    )\n    print(f\\\"WROTE {runs_path}\\\", flush=True)\n    print(f\\\"WROTE {summary_path}\\\", flush=True)\n    print(f\\\"WROTE {shift_path}\\\", flush=True)\n    return runs_path, summary_path, shift_path\n\n\ndef main(argv: Iterable[str] | None = None) -> None:\n    parser = argparse.ArgumentParser(description=__doc__)\n    parser.add_argument(\\\"--smoke\\\", action=\\\"store_true\\\")\n    parser.add_argument(\\\"--workers\\\", type=int, default=4)\n    parser.add_argument(\\\"--draws\\\", type=int, default=2)\n    parser.add_argument(\\\"--train-only\\\", action=\\\"store_true\\\")\n    args = parser.parse_args(argv)\n    run(\n        smoke=args.smoke,\n        workers=args.workers,\n        draws=args.draws,\n        train_only=args.train_only,\n    )\n\n\nif __name__ == \\\"__main__\\\":\n    mp.freeze_support()\n    main()\n'@ | Set-Content -Encoding utf8 e14_meaning_shift.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_9","type":"command_execution","command":"\"C:\\\\WINDOWS\\\\System32\\\\WindowsPowerShell\\\\v1.0\\\\powershell.exe\" -Command \"@'\n\\\"\\\"\\\"E14: outcome-only meaning shifts and adaptation over deployment weeks.\\\"\\\"\\\"\n\nfrom __future__ import annotations\n\nimport argparse\nimport json\nimport multiprocessing as mp\nfrom pathlib import Path\nimport time\nfrom typing import Dict, Iterable, List, Mapping, Sequence, Tuple\n\nimport numpy as np\nimport pandas as pd\n\nimport sim\nimport sim_u\nimport e12_unlabelled_head as e12\nimport e13_rungs_over_time as e13\nimport latent_filter\n\n\nROOT = Path(__file__).resolve().parent\nSIGMA = 1.0\nDIRECTIONS = (\\\"gain\\\", \\\"lose\\\")\nWEEKS = (4, 13, 52, 104)\nSMOKE_WEEKS = (4, 13)\nN_PER_WEEK = 25\nSTREAM_N = 2_600\n\n# E14's seed ranges are disjoint from E12 and E13. The latent test cohort is\n# shared by both directions; each direction receives its own B observation draw.\nA_TRAIN_LATENT_SEED = 1_700_000\nA_VAL_LATENT_SEED = 1_701_000\nA_TRAIN_OBS_SEED = 1_702_000\nA_VAL_OBS_SEED = 1_703_000\nA_MODEL_SEED = 1_704_337\nTEST_LATENT_SEED = 1_750_000\nTEST_OBS_SEED_BASE = 1_760_000\nSTREAM_SEED_BASE = 1_800_000\n\nRUN_COLUMNS = (\n    \\\"direction\\\", \\\"method\\\", \\\"week\\\", \\\"n_patients\\\", \\\"n_cases\\\", \\\"draw\\\",\n    \\\"brier\\\", \\\"log_loss\\\", \\\"auroc\\\", \\\"regret\\\", \\\"w\\\", \\\"wall_time_seconds\\\",\n)\nSUMMARY_METRICS = (\n    \\\"n_patients\\\", \\\"n_cases\\\", \\\"brier\\\", \\\"log_loss\\\", \\\"auroc\\\", \\\"regret\\\",\n    \\\"w\\\", \\\"wall_time_seconds\\\",\n)\nMETHOD_ORDER = {\n    \\\"keep\\\": 0,\n    \\\"head_U\\\": 1,\n    \\\"dial_only\\\": 2,\n    \\\"head_L\\\": 3,\n    \\\"finetune_lr05\\\": 4,\n    \\\"finetune_lr005\\\": 5,\n    \\\"oracle\\\": 6,\n}\n\n\ndef _direction_policies() -> Dict[str, Dict[str, sim_u.UPolicy]]:\n    return {\n        \\\"gain\\\": {\n            \\\"A\\\": sim_u.u_informative(gamma=2.0, beta=0.0),\n            \\\"B\\\": sim_u.u_informative(gamma=2.0, beta=2.0),\n        },\n        \\\"lose\\\": {\n            \\\"A\\\": sim_u.u_informative(gamma=2.0, beta=2.0),\n            \\\"B\\\": sim_u.u_informative(gamma=2.0, beta=0.0),\n        },\n    }\n\n\ndef _a_model_paths(direction: str, smoke: bool) -> Tuple[Path, Path]:\n    root = ROOT / (\\\"results_smoke\\\" if smoke else \\\"results\\\") / \\\"E14\\\"\n    folder = root / f\\\"a_model_{direction}\\\"\n    return folder / \\\"params.npz\\\", folder / \\\"meta.json\\\"\n\n\ndef _load_a_parameters(path: Path | str) -> Dict[str, np.ndarray]:\n    return e12._load_parameters(path)\n\n\ndef _train_or_load_a_model(\n    direction: str, smoke: bool, policy: sim_u.UPolicy\n) -> Tuple[Path, Dict[str, object]]:\n    n_train, n_val, max_epochs = (1_000, 300, 3) if smoke else (16_000, 4_000, 200)\n    params_path, meta_path = _a_model_paths(direction, smoke)\n    params_path.parent.mkdir(parents=True, exist_ok=True)\n\n    train_latent = sim_u.simulate_latent_u(n_train, seed=A_TRAIN_LATENT_SEED)\n    train_y = np.asarray(train_latent[\\\"y\\\"], dtype=np.float32)\n    training_rate = float(train_y.mean())\n    assert 0.01 <= training_rate <= 0.03, (\n        f\\\"E14 {direction} A training outcome rate must be 1%-3%; \\\"\n        f\\\"got {training_rate:.4%}\\\"\n    )\n\n    if params_path.exists() and meta_path.exists():\n        with meta_path.open(\\\"r\\\", encoding=\\\"utf-8\\\") as handle:\n            metadata = json.load(handle)\n        print(f\\\"SKIP A model training (cached at {params_path.parent})\\\", flush=True)\n        return params_path, metadata\n\n    if latent_filter.torch is None:\n        raise ImportError(\\\"PyTorch is required to train the E14 A filter\\\")\n    started = time.perf_counter()\n    train_observed = sim_u.observe_u(\n        train_latent, policy, sigma=SIGMA, seed=A_TRAIN_OBS_SEED\n    )\n    val_latent = sim_u.simulate_latent_u(n_val, seed=A_VAL_LATENT_SEED)\n    val_observed = sim_u.observe_u(\n        val_latent, policy, sigma=SIGMA, seed=A_VAL_OBS_SEED\n    )\n    val_y = np.asarray(val_latent[\\\"y\\\"], dtype=np.float32)\n    model, fit_meta = latent_filter.train_filter(\n        train_observed[\\\"x\\\"], train_observed[\\\"m\\\"], train_y,\n        val_observed[\\\"x\\\"], val_observed[\\\"m\\\"], val_y,\n        n_states=32,\n        max_epochs=max_epochs,\n        batch_size=512,\n        patience=15,\n        seed=A_MODEL_SEED,\n    )\n    wall_time = time.perf_counter() - started\n    metadata: Dict[str, object] = {\n        \\\"experiment\\\": \\\"E14\\\",\n        \\\"direction\\\": direction,\n        \\\"model\\\": \\\"latent_filter\\\",\n        \\\"sigma\\\": SIGMA,\n        \\\"training_policy\\\": policy.name,\n        \\\"threshold\\\": sim_u.outcome_threshold(),\n        \\\"outcome_rate\\\": training_rate,\n        \\\"cases\\\": int(train_y.sum()),\n        \\\"n_train\\\": n_train,\n        \\\"n_val\\\": n_val,\n        \\\"n_train_cases\\\": int(train_y.sum()),\n        \\\"train_outcome_rate\\\": training_rate,\n        \\\"n_val_cases\\\": int(val_y.sum()),\n        \\\"train_latent_seed\\\": A_TRAIN_LATENT_SEED,\n        \\\"val_latent_seed\\\": A_VAL_LATENT_SEED,\n        \\\"train_observation_seed\\\": A_TRAIN_OBS_SEED,\n        \\\"val_observation_seed\\\": A_VAL_OBS_SEED,\n        \\\"model_seed\\\": A_MODEL_SEED,\n        \\\"best_epoch\\\": fit_meta[\\\"best_epoch\\\"],\n        \\\"epochs\\\": fit_meta[\\\"epochs\\\"],\n        \\\"train_loss\\\": fit_meta[\\\"train_loss\\\"],\n        \\\"val_loss\\\": fit_meta[\\\"val_loss\\\"],\n        \\\"train_bce\\\": fit_meta[\\\"train_bce\\\"],\n        \\\"val_bce\\\": fit_meta[\\\"val_bce\\\"],\n        \\\"train_nll_per_step\\\": fit_meta[\\\"train_nll_per_step\\\"],\n        \\\"val_nll_per_step\\\": fit_meta[\\\"val_nll_per_step\\\"],\n        \\\"wall_time_seconds\\\": wall_time,\n    }\n    latent_filter._atomic_npz(params_path, model.numpy_parameters())\n    latent_filter._atomic_json(meta_path, metadata)\n    print(\n        f\\\"DONE A model {direction} at {params_path.parent} \\\"\n        f\\\"rate={training_rate:.3%} best_epoch={fit_meta['best_epoch']} \\\"\n        f\\\"wall={wall_time:.1f}s\\\",\n        flush=True,\n    )\n    return params_path, metadata\n\n\ndef _stream_seeds(direction_index: int, draw: int) -> Tuple[int, int, int]:\n    base = STREAM_SEED_BASE + direction_index * 100_000 + draw * 1_000\n    return base, base + 1, base + 2\n\n\ndef _copy_parameters(parameters: Mapping[str, np.ndarray]) -> Dict[str, np.ndarray]:\n    return {\n        name: np.asarray(parameters[name]).copy()\n        for name in latent_filter.PARAMETER_NAMES\n    }\n\n\n_WORKER_TEST_OBS: Dict[str, Mapping[str, np.ndarray]] = {}\n_WORKER_TEST_Y: np.ndarray | None = None\n_WORKER_ORACLE: Dict[str, np.ndarray] = {}\n_WORKER_ORACLE_BRIER: Dict[str, float] = {}\n_WORKER_PARAMS: Dict[str, Dict[str, np.ndarray]] = {}\n_WORKER_B_POLICIES: Dict[str, sim_u.UPolicy] = {}\n_WORKER_STEPS = 160\n\n\ndef _init_worker(\n    test_observations: Dict[str, Mapping[str, np.ndarray]],\n    test_y: np.ndarray,\n    oracle_predictions: Dict[str, np.ndarray],\n    params_paths: Dict[str, str],\n    b_policies: Dict[str, sim_u.UPolicy],\n    steps: int,\n) -> None:\n    global _WORKER_TEST_OBS, _WORKER_TEST_Y, _WORKER_ORACLE\n    global _WORKER_ORACLE_BRIER, _WORKER_PARAMS, _WORKER_B_POLICIES, _WORKER_STEPS\n    try:\n        import torch\n    except ImportError as exc:\n        raise ImportError(\\\"PyTorch is required to run E14 adaptation jobs\\\") from exc\n    torch.set_num_threads(1)\n    _WORKER_TEST_OBS = test_observations\n    _WORKER_TEST_Y = np.asarray(test_y)\n    _WORKER_ORACLE = oracle_predictions\n    _WORKER_ORACLE_BRIER = {\n        direction: float(np.mean((prediction - _WORKER_TEST_Y) ** 2))\n        for direction, prediction in oracle_predictions.items()\n    }\n    _WORKER_PARAMS = {\n        direction: _load_a_parameters(path)\n        for direction, path in params_paths.items()\n    }\n    _WORKER_B_POLICIES = b_policies\n    _WORKER_STEPS = int(steps)\n\n\ndef _run_job(task: Mapping[str, object]) -> Dict[str, object]:\n    if _WORKER_TEST_Y is None:\n        raise RuntimeError(\\\"E14 worker was not initialized\\\")\n    started = time.perf_counter()\n    direction = str(task[\\\"direction\\\"])\n    direction_index = int(task[\\\"direction_index\\\"])\n    draw = int(task[\\\"draw\\\"])\n    week = int(task[\\\"week\\\"])\n    n_patients = N_PER_WEEK * week\n    latent_seed, observation_seed, batch_seed = _stream_seeds(direction_index, draw)\n\n    stream_latent = sim_u.simulate_latent_u(STREAM_N, seed=latent_seed)\n    stream_all = sim_u.observe_u(\n        stream_latent,\n        _WORKER_B_POLICIES[direction],\n        sigma=SIGMA,\n        seed=observation_seed,\n    )\n    stream = {\n        \\\"x\\\": np.asarray(stream_all[\\\"x\\\"][:n_patients], dtype=np.float32),\n        \\\"m\\\": np.asarray(stream_all[\\\"m\\\"][:n_patients], dtype=np.int8),\n    }\n    stream_y = np.asarray(stream_latent[\\\"y\\\"][:n_patients], dtype=np.float32)\n    n_cases = int(stream_y.sum())\n    test_observed = _WORKER_TEST_OBS[direction]\n    test_y = _WORKER_TEST_Y\n    oracle_brier = _WORKER_ORACLE_BRIER[direction]\n    parameters = _WORKER_PARAMS[direction]\n    rows: List[Dict[str, object]] = []\n\n    method_started = time.perf_counter()\n    head_u_params = e12._refit_testing_head(\n        stream,\n        None,\n        parameters,\n        batch_seed=batch_seed,\n        steps=_WORKER_STEPS,\n        lr=0.05,\n    )\n    head_u_prediction, _ = latent_filter.numpy_forward(\n        test_observed[\\\"x\\\"], test_observed[\\\"m\\\"], head_u_params, w=1.0\n    )\n    rows.append({\n        \\\"direction\\\": direction,\n        \\\"method\\\": \\\"head_U\\\",\n        \\\"week\\\": week,\n        \\\"n_patients\\\": n_patients,\n        \\\"n_cases\\\": 0,\n        \\\"draw\\\": draw,\n        **e12._metrics(test_y, head_u_prediction, oracle_brier),\n        \\\"w\\\": 1.0,\n        \\\"wall_time_seconds\\\": time.perf_counter() - method_started,\n    })\n\n    method_started = time.perf_counter()\n    dial_weight = e13._choose_penalized_weight(\n        stream[\\\"x\\\"], stream[\\\"m\\\"], stream_y, parameters\n    )\n    dial_prediction, _ = latent_filter.numpy_forward(\n        test_observed[\\\"x\\\"], test_observed[\\\"m\\\"], parameters, w=dial_weight\n    )\n    rows.append({\n        \\\"direction\\\": direction,\n        \\\"method\\\": \\\"dial_only\\\",\n        \\\"week\\\": week,\n        \\\"n_patients\\\": n_patients,\n        \\\"n_cases\\\": n_cases,\n        \\\"draw\\\": draw,\n        **e12._metrics(test_y, dial_prediction, oracle_brier),\n        \\\"w\\\": dial_weight,\n        \\\"wall_time_seconds\\\": time.perf_counter() - method_started,\n    })\n\n    method_started = time.perf_counter()\n    if n_cases == 0:\n        head_l_params = _copy_parameters(parameters)\n    else:\n        head_l_params = e12._refit_testing_head(\n            stream,\n            stream_y,\n            parameters,\n            batch_seed=batch_seed + 7,\n            steps=_WORKER_STEPS,\n            lr=0.05,\n        )\n    head_l_prediction, _ = latent_filter.numpy_forward(\n        test_observed[\\\"x\\\"], test_observed[\\\"m\\\"], head_l_params, w=1.0\n    )\n    rows.append({\n        \\\"direction\\\": direction,\n        \\\"method\\\": \\\"head_L\\\",\n        \\\"week\\\": week,\n        \\\"n_patients\\\": n_patients,\n        \\\"n_cases\\\": n_cases,\n        \\\"draw\\\": draw,\n        **e12._metrics(test_y, head_l_prediction, oracle_brier),\n        \\\"w\\\": 1.0,\n        \\\"wall_time_seconds\\\": time.perf_counter() - method_started,\n    })\n\n    for method, lr in ((\\\"finetune_lr05\\\", 0.05), (\\\"finetune_lr005\\\", 0.005)):\n        method_started = time.perf_counter()\n        finetuned = e13._finetune(\n            stream,\n            stream_y,\n            parameters,\n            batch_seed=batch_seed + 17,\n            steps=_WORKER_STEPS,\n            lr=lr,\n        )\n        prediction, _ = latent_filter.numpy_forward(\n            test_observed[\\\"x\\\"], test_observed[\\\"m\\\"], finetuned, w=1.0\n        )\n        rows.append({\n            \\\"direction\\\": direction,\n            \\\"method\\\": method,\n            \\\"week\\\": week,\n            \\\"n_patients\\\": n_patients,\n            \\\"n_cases\\\": n_cases,\n            \\\"draw\\\": draw,\n            **e12._metrics(test_y, prediction, oracle_brier),\n            \\\"w\\\": 1.0,\n            \\\"wall_time_seconds\\\": time.perf_counter() - method_started,\n        })\n\n    return {\n        \\\"direction\\\": direction,\n        \\\"week\\\": week,\n        \\\"draw\\\": draw,\n        \\\"rows\\\": rows,\n        \\\"elapsed\\\": time.perf_counter() - started,\n    }\n\n\ndef _make_test_cohort(\n    n_test: int,\n    policies: Dict[str, Dict[str, sim_u.UPolicy]],\n) -> Tuple[\n    np.ndarray,\n    np.ndarray,\n    Dict[str, Mapping[str, np.ndarray]],\n    Dict[str, np.ndarray],\n    Dict[str, Dict[str, float]],\n]:\n    latent = sim_u.simulate_latent_u(n_test, seed=TEST_LATENT_SEED)\n    test_y = np.asarray(latent[\\\"y\\\"], dtype=np.float32)\n    test_u = np.asarray(latent[\\\"u\\\"], dtype=np.int8)\n    threshold = sim_u.outcome_threshold()\n    observations: Dict[str, Mapping[str, np.ndarray]] = {}\n    oracle_predictions: Dict[str, np.ndarray] = {}\n    shift_size: Dict[str, Dict[str, float]] = {}\n    for direction_index, direction in enumerate(DIRECTIONS):\n        b_policy = policies[direction][\\\"B\\\"]\n        observed = sim_u.observe_u(\n            latent,\n            b_policy,\n            sigma=SIGMA,\n            seed=TEST_OBS_SEED_BASE + direction_index,\n        )\n        prediction, p_u1 = sim_u.bayes_predict_u(\n            observed[\\\"x\\\"],\n            observed[\\\"m\\\"],\n            SIGMA,\n            b_policy,\n            threshold=threshold,\n            return_u_probability=True,\n        )\n        keep, _ = latent_filter.numpy_forward(\n            observed[\\\"x\\\"], observed[\\\"m\\\"],\n            _load_a_parameters(_a_model_paths(direction, smoke=False)[0]),\n            w=1.0,\n        )\n        oracle_brier = float(np.mean((prediction - test_y) ** 2))\n        shift_size[direction] = {\n            \\\"direction\\\": direction,\n            \\\"keep_auroc\\\": e12.auroc_rank(test_y, keep),\n            \\\"oracle_auroc\\\": e12.auroc_rank(test_y, prediction),\n            \\\"keep_regret\\\": float(np.mean((keep - test_y) ** 2) - oracle_brier),\n            \\\"mean_p_u1_given_h_u1\\\": float(p_u1[test_u == 1].mean()),\n            \\\"mean_p_u1_given_h_u0\\\": float(p_u1[test_u == 0].mean()),\n        }\n        observations[direction] = observed\n        oracle_predictions[direction] = prediction\n    return test_y, test_u, observations, oracle_predictions, shift_size\n\n\ndef _summary_frame(rows: Sequence[Mapping[str, object]]) -> pd.DataFrame:\n    frame = pd.DataFrame(rows, columns=RUN_COLUMNS)\n    grouped = frame.groupby([\\\"direction\\\", \\\"method\\\", \\\"week\\\"], sort=False)[\n        list(SUMMARY_METRICS)\n    ].agg([\\\"mean\\\", \\\"min\\\", \\\"max\\\"])\n    grouped.columns = [f\\\"{column}_{stat}\\\" for column, stat in grouped.columns]\n    return grouped.reset_index()\n\n\ndef run(\n    *, smoke: bool = False, workers: int = 4, draws: int = 2, train_only: bool = False\n) -> Tuple[Path | None, Path | None, Path | None]:\n    if workers < 1:\n        raise ValueError(\\\"--workers must be at least 1\\\")\n    if draws < 1:\n        raise ValueError(\\\"--draws must be at least 1\\\")\n\n    policies = _direction_policies()\n    params_paths: Dict[str, Path] = {}\n    for direction in DIRECTIONS:\n        path, _ = _train_or_load_a_model(\n            direction, smoke, policies[direction][\\\"A\\\"]\n        )\n        params_paths[direction] = path\n    if train_only:\n        return None, None, None\n\n    n_test = 500 if smoke else 10_000\n    weeks = SMOKE_WEEKS if smoke else WEEKS\n    n_draws = 1 if smoke else draws\n    test_y, _test_u, test_observations, oracle_predictions, shift_size = (\n        _make_test_cohort(n_test, policies)\n    )\n    params = {\n        direction: _load_a_parameters(params_paths[direction])\n        for direction in DIRECTIONS\n    }\n    oracle_brier = {\n        direction: float(np.mean((oracle_predictions[direction] - test_y) ** 2))\n        for direction in DIRECTIONS\n    }\n\n    static_rows: List[Dict[str, object]] = []\n    for direction in DIRECTIONS:\n        observed = test_observations[direction]\n        keep_prediction, _ = latent_filter.numpy_forward(\n            observed[\\\"x\\\"], observed[\\\"m\\\"], params[direction], w=1.0\n        )\n        for week in weeks:\n            n_patients = N_PER_WEEK * week\n            for method, prediction in (\n                (\\\"keep\\\", keep_prediction),\n                (\\\"oracle\\\", oracle_predictions[direction]),\n            ):\n                static_rows.append({\n                    \\\"direction\\\": direction,\n                    \\\"method\\\": method,\n                    \\\"week\\\": week,\n                    \\\"n_patients\\\": n_patients,\n                    \\\"n_cases\\\": 0,\n                    \\\"draw\\\": 0,\n                    **e12._metrics(test_y, prediction, oracle_brier[direction]),\n                    \\\"w\\\": 1.0 if method == \\\"keep\\\" else float(\\\"nan\\\"),\n                    \\\"wall_time_seconds\\\": 0.0,\n                })\n\n    tasks = [\n        {\n            \\\"direction\\\": direction,\n            \\\"direction_index\\\": direction_index,\n            \\\"draw\\\": draw,\n            \\\"week\\\": week,\n        }\n        for direction_index, direction in enumerate(DIRECTIONS)\n        for draw in range(n_draws)\n        for week in weeks\n    ]\n    job_rows: List[Dict[str, object]] = []\n    context = mp.get_context(\\\"spawn\\\")\n    with context.Pool(\n        processes=workers,\n        initializer=_init_worker,\n        initargs=(\n            test_observations,\n            test_y,\n            oracle_predictions,\n            {direction: str(params_paths[direction]) for direction in DIRECTIONS},\n            {direction: policies[direction][\\\"B\\\"] for direction in DIRECTIONS},\n            2 if smoke else 160,\n        ),\n    ) as pool:\n        for result in pool.imap_unordered(_run_job, tasks, chunksize=1):\n            job_rows.extend(result[\\\"rows\\\"])\n            print(\n                f\\\"DONE {result['direction']} draw={result['draw']} \\\"\n                f\\\"week={result['week']} wall={result['elapsed']:.1f}s\\\",\n                flush=True,\n            )\n\n    rows = static_rows + job_rows\n    analysis_dir = ROOT / \\\"analysis\\\"\n    analysis_dir.mkdir(parents=True, exist_ok=True)\n    prefix = \\\"e14_smoke\\\" if smoke else \\\"e14\\\"\n    runs_path = analysis_dir / f\\\"{prefix}_runs.csv\\\"\n    summary_path = analysis_dir / f\\\"{prefix}_summary.csv\\\"\n    shift_path = analysis_dir / f\\\"{prefix}_shift_size.csv\\\"\n\n    runs_frame = pd.DataFrame(rows, columns=RUN_COLUMNS)\n    direction_order = {name: index for index, name in enumerate(DIRECTIONS)}\n    runs_frame[\\\"_direction_order\\\"] = runs_frame[\\\"direction\\\"].map(direction_order)\n    runs_frame[\\\"_method_order\\\"] = runs_frame[\\\"method\\\"].map(METHOD_ORDER)\n    runs_frame.sort_values(\n        [\\\"_direction_order\\\", \\\"week\\\", \\\"_method_order\\\", \\\"draw\\\"], inplace=True\n    )\n    runs_frame.drop(columns=[\\\"_direction_order\\\", \\\"_method_order\\\"]).to_csv(\n        runs_path, index=False\n    )\n    _summary_frame(rows).to_csv(summary_path, index=False)\n    pd.DataFrame([shift_size[name] for name in DIRECTIONS]).to_csv(\n        shift_path, index=False\n    )\n    print(f\\\"WROTE {runs_path}\\\", flush=True)\n    print(f\\\"WROTE {summary_path}\\\", flush=True)\n    print(f\\\"WROTE {shift_path}\\\", flush=True)\n    return runs_path, summary_path, shift_path\n\n\ndef main(argv: Iterable[str] | None = None) -> None:\n    parser = argparse.ArgumentParser(description=__doc__)\n    parser.add_argument(\\\"--smoke\\\", action=\\\"store_true\\\")\n    parser.add_argument(\\\"--workers\\\", type=int, default=4)\n    parser.add_argument(\\\"--draws\\\", type=int, default=2)\n    parser.add_argument(\\\"--train-only\\\", action=\\\"store_true\\\")\n    args = parser.parse_args(argv)\n    run(\n        smoke=args.smoke,\n        workers=args.workers,\n        draws=args.draws,\n        train_only=args.train_only,\n    )\n\n\nif __name__ == \\\"__main__\\\":\n    mp.freeze_support()\n    main()\n'@ | Set-Content -Encoding utf8 e14_meaning_shift.py\"","aggregated_output":"","exit_code":0,"status":"completed"}}
