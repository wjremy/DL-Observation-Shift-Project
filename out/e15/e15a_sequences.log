{"type":"item.started","item":{"id":"item_15","type":"command_execution","command":"\"C:\\\\WINDOWS\\\\System32\\\\WindowsPowerShell\\\\v1.0\\\\powershell.exe\" -Command '$py = Join-Path $env:USERPROFILE '\"'.cache\\\\codex-runtimes\\\\codex-primary-runtime\\\\dependencies\\\\python\\\\python.exe'; @'\nimport numpy as np\nimport pandas as pd\nimport e7_sites as e7\nz = np.load('data/e15_cache.npz', allow_pickle=False)\nsite = 'SICU'; names = ['HR','Urine','MAP']; lookup = {n:i for i,n in enumerate(z['P12_variables'].tolist())}\nids = z[f'P12_{site}_ids']\ndef valid(name, v):\n    return np.isfinite(v) and v >= 0 and v \"'!= -1 and (name.casefold() != '\"'ph' or 6.5 <= v <= 8)\nfor row,pid0 in enumerate(ids):\n    pid=str(pid0); letter,record=pid.split(':',1)\n    df=pd.read_csv(e7.P12_RAW/f'set-{letter}'/f'{record}.txt',dtype={'Time':str,'Parameter':str})\n    times=df['Time'].map(e7._parse_time).to_numpy(float); vals=pd.to_numeric(df['Value'],errors='coerce').to_numpy(float); params=df['Parameter'].to_numpy(str)\n    checks=[]\n    for name in names:\n        inds=np.flatnonzero((params==name)&np.isfinite(times)&(times>=0)&(times<=48)&np.isfinite(vals))\n        inds=[j for j in inds if valid(name,vals[j])]\n        if not inds: break\n        h=min(int(np.floor(times[inds[0]])),47); same=[j for j in inds if min(int(np.floor(times[j])),47)==h]\n        expected=float(vals[same[-1]]); got=float(z[f'P12_{site}_x'][row,h,lookup[name]])\n        assert np.isclose(got,expected,rtol=1e-6,atol=1e-6),(pid,name,h,expected,got)\n        checks.append((name,h,expected,got))\n    if len(checks)==3:\n        print('Selected P12 second patient:',pid)\n        for name,h,expected,got in checks: print(f'{name} hour {h}: raw={expected:g}, cache={got:g}')\n        break\nelse: raise AssertionError('No SICU sample had all three variables')\n'@ | & \"'$py -'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
