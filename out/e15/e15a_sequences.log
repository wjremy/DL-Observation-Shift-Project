{"type":"item.started","item":{"id":"item_13","type":"command_execution","command":"\"C:\\\\WINDOWS\\\\System32\\\\WindowsPowerShell\\\\v1.0\\\\powershell.exe\" -Command '$py = Join-Path $env:USERPROFILE '\"'.cache\\\\codex-runtimes\\\\codex-primary-runtime\\\\dependencies\\\\python\\\\python.exe'; @'\nimport numpy as np\nimport pandas as pd\nimport e7_sites as e7\n\nz7 = np.load('data/e7_cache.npz', allow_pickle=False)\nz = np.load('data/e15_cache.npz', allow_pickle=False)\n\n# Confirm E7 ids and outcomes are carried over for every unit/site, and union ordering.\nfor site, _, _ in e7.P19_SITE_NAMES:\n    for field, suffix in [('ids', 'patient_ids'), ('y', 'y')]:\n        assert np.array_equal(z[f'P19_{site}_{field}'], z7[f'P19_{site}_{suffix}']), (site, field)\nfor hospital in ('A', 'B'):\n    sites = [f'{hospital}-MICU', f'{hospital}-SICU']\n    for field, suffix in [('ids', 'patient_ids'), ('y', 'y')]:\n        expected = np.concatenate([z7[f'P19_{s}_{suffix}'] for s in sites])\n        assert np.array_equal(z[f'P19_{hospital}-all_{field}'], expected), (hospital, field)\nfor site in e7.P12_SITE_NAMES.values():\n    for field, suffix in [('ids', 'patient_ids'), ('y', 'y')]:\n        assert np.array_equal(z[f'P12_{site}_{field}'], z7[f'P12_{site}_{suffix}']), (site, field)\nfor key in [k[:-2] for k in z.files if k.endswith('_x')]:\n    x, m = z[key + '_x'], z[key + '_m']\n    assert np.array_equal(np.isnan(x), m == 0), key\n    assert np.isfinite(x[m == 1]).all(), key\nprint('Cache-wide checks passed: E7 ids/y exact; x is NaN exactly where m=0.')\n\n# Compare three raw, non-log variables per patient in two patients per dataset.\ndef valid(name, value, ds):\n    if not np.isfinite(value): return False\n    if ds == 'P12' and value == -1: return False\n    if name.casefold() \"'!= '\"'baseexcess' and value < 0: return False\n    if name.casefold() == 'ph' and not (6.5 <= value <= 8.0): return False\n    return True\n\ndef check_p19(site, row):\n    pid = str(z[f'P19_{site}_ids'][row]); hospital, stem = pid.split(':', 1)\n    df = pd.read_csv(e7.P19_RAW / f'training_set{hospital}' / f'{stem}.psv', sep='|', usecols=['ICULOS','HR','O2Sat','SBP'])\n    vars = ['HR','O2Sat','SBP']; lookup = {n:i for i,n in enumerate(z['P19_variables'].tolist())}\n    hours = df['ICULOS'].to_numpy(float)\n    for name in vars:\n        vals = pd.to_numeric(df[name], errors='coerce').to_numpy(float)\n        found = False\n        for h in range(24):\n            inds = np.flatnonzero((hours >= 1) & (hours <= 24) & (hours.astype(int)-1 == h) & np.isfinite(vals))\n            inds = [q for q in inds if valid(name, vals[q], 'P19')]\n            if inds:\n                expected = vals[inds[-1]]\n                got = float(z[f'P19_{site}_x'][row,h,lookup[name]])\n                assert np.isclose(got, expected, rtol=1e-6, atol=1e-6), (pid,name,h,expected,got)\n                print(f'P19 {pid} {name} hour {h}: raw={expected:g}, cache={got:g}')\n                found = True; break\n        assert found, (pid, name, 'no valid raw value')\n\ndef check_p12(site, row):\n    pid = str(z[f'P12_{site}_ids'][row]); letter, record = pid.split(':',1)\n    df = pd.read_csv(e7.P12_RAW / f'set-{letter}' / f'{record}.txt', dtype={'Time':str,'Parameter':str})\n    times = df['Time'].map(e7._parse_time).to_numpy(float)\n    vals = pd.to_numeric(df['Value'], errors='coerce').to_numpy(float)\n    params = df['Parameter'].to_numpy(str)\n    vars = ['HR','Urine','MAP']; lookup = {n:i for i,n in enumerate(z['P12_variables'].tolist())}\n    for name in vars:\n        inds = np.flatnonzero((params == name) & np.isfinite(times) & (times >= 0) & (times <= 48) & np.isfinite(vals))\n        inds = [q for q in inds if valid(name, vals[q], 'P12')]\n        assert inds, (pid, name, 'no valid raw value')\n        q = inds[0]; h = min(int(np.floor(times[q])),47)\n        same = [j for j in inds if min(int(np.floor(times[j])),47) == h]\n        expected = vals[same[-1]]\n        got = float(z[f'P12_{site}_x'][row,h,lookup[name]])\n        assert np.isclose(got, expected, rtol=1e-6, atol=1e-6), (pid,name,h,expected,got)\n        print(f'P12 {pid} {name} hour {h}: raw={expected:g}, cache={got:g}')\n\ncheck_p19('A-MICU', 0); check_p19('B-SICU', 0)\ncheck_p12('CCU', 0); check_p12('SICU', 0)\n'@ | & \"'$py -'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
