time.py:149\r\n 149: def _choose_penalized_weight(\r\n 150:     x: np.ndarray,\r\n 151:     m: np.ndarray,\r\n 152:     y: np.ndarray,\r\n 153:     parameters: Mapping[str, np.ndarray],\r\n 154: ) -> float:\r\n 155:     \"\"\"Minimize summed labelled log loss plus the E9 quadratic penalty.\"\"\"\r\n 156:     if int(np.asarray(y).sum()) == 0:\r\n 157:         return 1.0\r\n 158:     weights = np.round(np.arange(0.0, 1.0001, 0.05), 2)\r\n 159:     losses: List[float] = []\r\n 160:     labels = np.asarray(y, dtype=np.float64)\r\n 161:     for weight in weights:\r\n 162:         probability, _ = latent_filter.numpy_forward(x, m, parameters, w=float(weight))\r\n 163:         clipped = np.clip(probability, 1e-7, 1.0 - 1e-7)\r\n 164:         log_loss_sum = -np.sum(\r\n 165:             labels * np.log(clipped) + (1.0 - labels) * np.log1p(-clipped)\r\n 166:         )\r\n 167:         losses.append(float(log_loss_sum + 2.0 * (float(weight) - 1.0) ** 2))\r\n 168:     best_loss = min(losses)\r\n 169:     return float(max(weight for weight, loss in zip(weights, losses) if loss == best_loss))\r\n 170: \r\n 171: \r\n 172: def _finetune(\r\n 173:     observed: Mapping[str, np.ndarray],\r\n 174:     labels: np.ndarray,\r\n 175:     parameters: Mapping[str, np.ndarray],\r\n 176:     *,\r\n 177:     batch_seed: int,\r\n 178:     steps: int,\r\n 179:     lr: float,\r\n 180: ) -> Dict[str, np.ndarray]:\r\n 181:     \"\"\"Fine-tune every A parameter with the E5 objective and replacement batches.\"\"\"\r\n 182:     if int(np.asarray(labels).sum()) == 0:\r\n 183:         return {name: np.asarray(parameters[name]).copy() for name in latent_filter.PARAMETER_NAMES}\r\n 184:     try:\r\n 185:         import torch\r\n 186:         from torch.nn import functional as F\r\n 187:     except ImportError as exc:\r\n 188:         raise ImportError(\"PyTorch is required for E13 fine-tuning\") from exc\r\n 189: \r\n 190:     torch.set_num_threads(1)\r\n 191:     torch.manual_seed(int(batch_seed))\r\n 192:     model = latent_filter.LatentFilter(n_states=int(np.asarray(parameters[\"mu\"]).size))\r\n 193:     with torch.no_grad():\r\n 194:         for name in latent_filter.PARAMETER_NAMES:\r\n 195:             tensor = torch.as_tensor(\r\n 196:                 np.asarray(parameters[name]), dtype=getattr(model, name).dtype\r\n 197:             )\r\n 198:             getattr(model, name).copy_(tensor)\r\n 199:     optimizer = torch.optim.Adam(model.parameters(), lr=float(lr))\r\n 200:     x = torch.from_numpy(np.ascontiguousarray(observed[\"x\"], dtype=np.float32))\r\n 201:     m = torch.from_numpy(np.ascontiguousarray(observed[\"m\"], dtype=np.float32))\r\n 202:     y = torch.from_numpy(np.ascontiguousarray(labels, dtype=np.float32))\r\n 203:     n = int(x.shape[0])\r\n 204:     generator = torch.Generator(device=\"cpu\")\r\n 205:     generator.manual_seed(int(batch_seed))\r\n 206:     model.train()\r\n 207: \r\n 208:     for _ in range(int(steps)):\r\n 209:         indices = torch.randint(0, n, (256,), generator=generator)\r\n 210:         xb = x.index_select(0, indices)\r\n 211:         mb = m.index_select(0, indices)\r\n 212:         yb = y.index_select(0, indices)\r\n 213:         probability, log_marginal = model(xb, mb, w=1.0)\r\n 214:         bce = F.binary_cross_entropy(\r\n 215:             probability.clamp(1e-7, 1.0 - 1e-7), yb\r\n 216:         )\r\n 217:         nll_per_step = -log_marginal.mean() / x.shape[1]\r\n 218:         loss = bce + nll_per_step\r\n 219:         optimizer.zero_grad(set_to_none=True)\r\n 220:         loss.backward()\r\n 221:         optimizer.step()\r\n 222:     return model.numpy_parameters()\r\n 223: \r\n 224: \r\n 225: _WORKER_TEST_OBS: Dict[str, Mapping[str, np.ndarray]] = {}\r\n 226: _WORKER_TEST_Y: np.ndarray | None = None\r\n 227: _WORKER_ORACLE: Dict[str, np.ndarray] = {}\r\n 228: _WORKER_ORACLE_BRIER: Dict[str, float] = {}\r\n 229: _WORKER_PARAMS: Dict[str, np.ndarray] = {}\r\n 230: _WORKER_POLICIES: Dict[str, sim.Policy] = {}\r\n### e13_rungs_over_time.py:231\r\n 231: _WORKER_LR = 0.05\r\n 232: _WORKER_STEPS = 160\r\n 233: \r\n 234: \r\n 235: def _init_worker(\r\n 236:     test_observations: Dict[str, Mapping[str, np.ndarray]],\r\n 237:     test_y: np.ndarray,\r\n 238:     oracle_predictions: Dict[str, np.ndarray],\r\n 239:     params_path: str,\r\n 240:     lr: float,\r\n 241:     steps: int,\r\n 242: ) -> None:\r\n 243:     global _WORKER_TEST_OBS, _WORKER_TEST_Y, _WORKER_ORACLE, _WORKER_ORACLE_BRIER\r\n 244:     global _WORKER_PARAMS, _WORKER_POLICIES, _WORKER_LR, _WORKER_STEPS\r\n 245:     try:\r\n 246:         import torch\r\n 247:     except ImportError as exc:\r\n 248:         raise ImportError(\"PyTorch is required to run E13 adaptation jobs\") from exc\r\n 249:     torch.set_num_threads(1)\r\n 250:     _WORKER_TEST_OBS = test_observations\r\n 251:     _WORKER_TEST_Y = np.asarray(test_y)\r\n 252:     _WORKER_ORACLE = oracle_predictions\r\n 253:     _WORKER_ORACLE_BRIER = {\r\n 254:         policy: float(np.mean((prediction - _WORKER_TEST_Y) ** 2))\r\n 255:         for policy, prediction in oracle_predictions.items()\r\n 256:     }\r\n 257:     _WORKER_PARAMS = e12._load_parameters(params_path)\r\n 258:     _WORKER_POLICIES = e12._policies()\r\n 259:     _WORKER_LR = float(lr)\r\n 260:     _WORKER_STEPS = int(steps)\r\n 261: \r\n 262: \r\n 263: def _run_job(task: Mapping[str, object]) -> Dict[str, object]:\r\n 264:     if _WORKER_TEST_Y is None:\r\n 265:         raise RuntimeError(\"E13 worker was not initialized\")\r\n 266:     started = time.perf_counter()\r\n 267:     policy_name = str(task[\"policy\"])\r\n 268:     policy_index = int(task[\"policy_index\"])\r\n 269:     draw = int(task[\"draw\"])\r\n 270:     week = int(task[\"week\"])\r\n 271:     n_patients = N_PER_WEEK * week\r\n 272:     latent_seed, observation_seed, batch_seed = _stream_seeds(policy_index, draw)\r\n 273:     stream_latent = sim.simulate_latent(STREAM_N, seed=latent_seed)\r\n 274:     stream_all = sim.observe(\r\n 275:         stream_latent,\r\n 276:         _WORKER_POLICIES[policy_name],\r\n 277:         sigma=SIGMA,\r\n 278:         seed=observation_seed,\r\n 279:     )\r\n 280:     stream = {\r\n 281:         \"x\": np.asarray(stream_all[\"x\"][:n_patients], dtype=np.float32),\r\n 282:         \"m\": np.asarray(stream_all[\"m\"][:n_patients], dtype=np.int8),\r\n 283:     }\r\n 284:     stream_y = np.asarray(stream_latent[\"y\"][:n_patients], dtype=np.float32)\r\n 285:     n_cases = int(stream_y.sum())\r\n 286:     test_observed = _WORKER_TEST_OBS[policy_name]\r\n 287:     test_y = _WORKER_TEST_Y\r\n 288:     oracle_brier = _WORKER_ORACLE_BRIER[policy_name]\r\n 289:     params = _WORKER_PARAMS\r\n 290:     rows: List[Dict[str, object]] = []\r\n 291: \r\n 292:     # R1 and R2 share the same refitted testing head. Its fit is unlabelled.\r\n 293:     method_started = time.perf_counter()\r\n 294:     head_u_params = e12._refit_testing_head(\r\n 295:         stream,\r\n 296:         None,\r\n 297:         params,\r\n 298:         batch_seed=batch_seed,\r\n 299:         steps=_WORKER_STEPS,\r\n 300:         lr=_WORKER_LR,\r\n 301:     )\r\n 302:     head_u_prediction, _ = latent_filter.numpy_forward(\r\n 303:         test_observed[\"x\"], test_observed[\"m\"], head_u_params, w=1.0\r\n 304:     )\r\n 305:     rows.append({\r\n 306:         \"policy\": policy_name,\r\n 307:         \"method\": \"head_U\",\r\n 308:         \"week\": week,\r\n 309:         \"n_patients\": n_patients,\r\n 310:         \"n_cases\": 0,\r\n 311:         \"draw\": draw,\r\n 312:         **e12._metrics(test_y, head_u_prediction, oracle_brier),\r\n 313:         \"w\": 1.0,\r\n 314:         \"wall_time_seconds\": time.perf_counter() - method_started,\r\n 315:     })\r\n 316: \r\n 317:     method_started = time.perf_counter()\r\n 318:     head_u_dial_w = _choose_penalized_weight(\r\n 319:         stream[\"x\"], stream[\"m\"], stream_y, head_u_params\r\n 320:     )\r\n 321:     head_u_dial_prediction, _ = latent_filter.numpy_forward(\r\n 322:         test_observed[\"x\"], test_observed[\"m\"], head_u_params, w=head_u_dial_w\r\n 323:     )\r\n 324:     rows.append({\r\n 325:         \"policy\": policy_name,\r\n 326:         \"method\": \"head_U_dial\",\r\n 327:         \"week\": week,\r\n 328:         \"n_patients\": n_patients,\r\n 329:         \"n_cases\": n_cases,\r\n 330:         \"draw\": draw,\r\n 331:         **e12._metrics(test_y, head_u_dial_prediction, oracle_brier),\r\n 332:         \"w\": head_u_dial_w,\r\n 333:         \"wall_time_seconds\": time.perf_counter() - method_started,\r\n 334:     })\r\n 335: \r\n 336:     method_started = time.perf_counter()\r\n 337:     dial_only_w = _choose_penalized_weight(\r\n 338:         stream[\"x\"], stream[\"m\"], stream_y, params\r\n 339:     )\r\n 340:     dial_only_prediction, _ = latent_filter.numpy_forward(\r\n 341:         test_observed[\"x\"], test_observed[\"m\"], params, w=dial_only_w\r\n 342:     )\r\n 343:     rows.append({\r\n 344:         \"policy\": policy_name,\r\n 345:         \"method\": \"dial_only\",\r\n 346:         \"week\": week,\r\n 347:         \"n_patients\": n_patients,\r\n 348:         \"n_cases\": n_cases,\r\n 349:         \"draw\": draw,\r\n 350:         **e12._metrics(test_y, dial_only_prediction, oracle_brier),\r\n 351:         \"w\": dial_only_w,\r\n 352:         \"wall_time_seconds\": time.perf_counter() - method_started,\r\n 353:     })\r\n 354: \r\n 355:     method_started = time.perf_counter()\r\n 356:     finetuned_params = _finetune(\r\n 357:         stream,\r\n 358:         stream_y,\r\n 359:         params,\r\n 360:         batch_seed=batch_seed + 17,\r\n 361:         steps=_WORKER_STEPS,\r\n 362:         lr=_WORKER_LR,\r\n 363:     )\r\n 364:     finetune_prediction, _ = latent_filter.numpy_forward(\r\n 365:         test_observed[\"x\"], test_observed[\"m\"], finetuned_params, w=1.0\r\n 366:     )\r\n 367:     rows.append({\r\n 368:         \"policy\": policy_name,\r\n 369:         \"method\": \"finetune\",\r\n 370:         \"week\": week,\r\n 371:         \"n_patients\": n_patients,\r\n 372:         \"n_cases\": n_cases,\r\n 373:         \"draw\": draw,\r\n 374:         **e12._metrics(test_y, finetune_prediction, oracle_brier),\r\n 375:         \"w\": 1.0,\r\n 376:         \"wall_time_seconds\": time.perf_counter() - method_started,\r\n 377:     })\r\n 378: \r\n 379:     return {\r\n 380:         \"policy\": policy_name,\r\n 381:         \"week\": week,\r\n 382:         \"draw\": draw,\r\n 383:         \"rows\": rows,\r\n 384:         \"elapsed\": time.perf_counter() - started,\r\n 385:     }\r\n 386: \r\n 387: \r\n 388: def _make_test_cohort(n_test: int):\r\n### e7_dial.py:145\r\n 145:         raise ValueError(\"P12 cache does not certify E7 feature windows/static Weight handling\")\r\n 146:     result_pairs = []\r\n 147:     result_curves = []\r\n 148:     result_sites = []\r\n 149:     fit_records = {}\r\n 150:     target_source_overlap_checks = 0\r\n 151: \r\n 152:     for ds_ix, dataset in enumerate((\"P19\", \"P12\")):\r\n 153:         ds_meta = meta[dataset]\r\n 154:         sites = cache[f\"{dataset}_sites\"].astype(str).tolist()\r\n 155:         n_dynamic = len(ds_meta[\"raw_phys_names\"]) - (3 if dataset == \"P19\" else 4)\r\n 156:         if dataset == \"P19\":\r\n 157:             n_dynamic = len(ds_meta[\"raw_phys_names\"]) - 3\r\n 158:         dataset_arrays = {}\r\n 159:         for site in sites:\r\n 160:             prefix = f\"{dataset}_{site}\"\r\n 161:             dataset_arrays[site] = {\r\n 162:                 \"raw_phys\": cache[f\"{prefix}_raw_phys\"].astype(np.float64),\r\n 163:                 \"raw_pattern\": cache[f\"{prefix}_raw_pattern\"].astype(np.float64),\r\n 164:                 \"y\": cache[f\"{prefix}_y\"].astype(np.uint8),\r\n 165:                 \"ids\": cache[f\"{prefix}_patient_ids\"].astype(str),\r\n 166:             }\r\n 167: \r\n 168:         for site_ix, source in enumerate(sites):\r\n 169:             arrays = dataset_arrays[source]\r\n 170:             n = len(arrays[\"y\"])\r\n 171:             if n < 10:\r\n 172:                 raise ValueError(f\"Source site {dataset}/{source} is too small: n={n}\")\r\n 173:             split_rng = np.random.default_rng(SPLIT_SEED + ds_ix * 1000 + site_ix)\r\n 174:             permutation = split_rng.permutation(n)\r\n 175:             n_train = int(np.floor(0.8 * n))\r\n 176:             train_idx, holdout_idx = permutation[:n_train], permutation[n_train:]\r\n 177:             X, X_phys, prep = _build_source_features(\r\n 178:                 arrays[\"raw_phys\"], arrays[\"raw_pattern\"], n_dynamic, train_idx\r\n 179:             )\r\n 180:             y = arrays[\"y\"]\r\n 181:             if len(np.unique(y[train_idx])) < 2:\r\n 182:                 raise ValueError(f\"Source training split has one outcome class: {dataset}/{source}\")\r\n 183:             cv_seed = SPLIT_SEED + 10000 + ds_ix * 1000 + site_ix\r\n 184:             fit_started = time.perf_counter()\r\n 185:             print(f\"{dataset} source {source}: fit/CV n_train={len(train_idx):,}, features={X.shape[1]}\", flush=True)\r\n 186:             beta, penalty, cv = fit_with_cv(X[train_idx], y[train_idx], seed=cv_seed)\r\n 187:             n_phys = X_phys.shape[1]\r\n 188:             h_logits = beta[0] + X_phys[holdout_idx] @ beta[1:1+n_phys]\r\n 189:             p_holdout = ((X[holdout_idx, n_phys:]) @ beta[1+n_phys:])\r\n 190:             holdout_metrics = _metrics_from_logits(y[holdout_idx], h_logits + p_holdout)\r\n 191:             fit_records[(dataset, source)] = {\r\n 192:                 \"beta\": beta, \"prep\": prep, \"n_phys\": n_phys,\r\n 193:                 \"train_idx\": train_idx, \"holdout_idx\": holdout_idx,\r\n 194:                 \"penalty\": penalty, \"cv\": cv,\r\n 195:                 \"source_holdout_metrics\": holdout_metrics,\r\n 196:             }\r\n 197:             fit_elapsed = time.perf_counter() - fit_started\r\n 198:             result_sites.append({\r\n 199:                 \"dataset\": dataset, \"site\": source, \"n\": n,\r\n 200:                 \"outcome_cases\": int(y.sum()), \"outcome_rate\": float(y.mean()),\r\n 201:                 \"source_train_n\": len(train_idx), \"source_holdout_n\": len(holdout_idx),\r\n 202:                 \"selected_penalty\": penalty,\r\n 203:                 \"source_holdout_auroc_w1\": holdout_metrics[\"auroc\"],\r\n 204:                 \"source_holdout_brier_w1\": holdout_metrics[\"brier\"],\r\n 205:                 \"source_holdout_log_loss_w1\": holdout_metrics[\"log_loss\"],\r\n 206:                 \"source_training_cases\": int(y[train_idx].sum()),\r\n 207:                 \"source_holdout_cases\": int(y[holdout_idx].sum()),\r\n 208:                 \"cv_log_loss\": {str(k): v for k, v in cv.items()},\r\n 209:                 \"preprocessing_all_missing_raw_indices\": prep[\"all_missing_source_training_features\"],\r\n 210:             })\r\n 211:             print(f\"{dataset} source {source}: penalty={penalty:g}, holdout AUROC={holdout_metrics['auroc']:.4f}, log loss={holdout_metrics['log_loss']:.4f}, fit={fit_elapsed/60:.1f} min\", flush=True)\r\n 212: \r\n 213:         for source in sites:\r\n 214:             fitted = fit_records[(dataset, source)]\r\n### e7_dial.py:250\r\n 250: \r\n 251:     pairs_df = pd.DataFrame.from_records(result_pairs)\r\n 252:     curves_df = pd.DataFrame.from_records(result_curves)\r\n 253:     sites_df = pd.DataFrame.from_records(result_sites)\r\n 254:     ANALYSIS.mkdir(parents=True, exist_ok=True)\r\n 255:     pairs_path = ANALYSIS / \"e7_pairs.csv\"\r\n 256:     curves_path = ANALYSIS / \"e7_curves.csv\"\r\n 257:     sites_path = ANALYSIS / \"e7_sites.csv\"\r\n 258:     summary_path = ANALYSIS / \"e7_summary.json\"\r\n 259:     pairs_df.to_csv(pairs_path, index=False)\r\n 260:     curves_df.to_csv(curves_path, index=False)\r\n 261:     sites_df.to_csv(sites_path, index=False)\r\n 262: 