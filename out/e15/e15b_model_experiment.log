eepdims: bool = False) -> np.ndarray:\r\n  41:     values = np.asarray(values, dtype=np.float64)\r\n  42:     maximum = np.max(values, axis=axis, keepdims=True)\r\n  43:     result = maximum + np.log(np.sum(np.exp(values - maximum), axis=axis, keepdims=True))\r\n  44:     if not keepdims:\r\n  45:         result = np.squeeze(result, axis=axis)\r\n  46:     return result\r\n  47: \r\n  48: \r\n  49: def _log_softmax(values: np.ndarray, axis: int = -1) -> np.ndarray:\r\n  50:     values = np.asarray(values, dtype=np.float64)\r\n  51:     return values - _logsumexp(values, axis=axis, keepdims=True)\r\n  52: \r\n  53: \r\n  54: def _sigmoid(values: np.ndarray) -> np.ndarray:\r\n  55:     values = np.asarray(values, dtype=np.float64)\r\n  56:     output = np.empty_like(values)\r\n  57:     positive = values >= 0.0\r\n  58:     output[positive] = 1.0 / (1.0 + np.exp(-values[positive]))\r\n  59:     exponent = np.exp(values[~positive])\r\n  60:     output[~positive] = exponent / (1.0 + exponent)\r\n  61:     return output\r\n  62: \r\n  63: \r\n  64: def _check_inputs(x: np.ndarray, m: np.ndarray, parameters: Mapping[str, np.ndarray], w: float):\r\n  65:     x = np.asarray(x, dtype=np.float64)\r\n  66:     m = np.asarray(m)\r\n  67:     if x.ndim != 2 or m.shape != x.shape:\r\n  68:         raise ValueError(\"x and m must have matching shape [n, T]\")\r\n  69:     if x.shape[1] < 1:\r\n  70:         raise ValueError(\"time dimension T must be positive\")\r\n  71:     if not np.all((m == 0) | (m == 1)):\r\n  72:         raise ValueError(\"m must contain only 0/1 values\")\r\n  73:     m = m.astype(bool, copy=False)\r\n  74:     if np.any(m & ~np.isfinite(x)):\r\n  75:         raise ValueError(\"observed x values must be finite\")\r\n  76:     w = float(w)\r\n  77:     if not 0.0 <= w <= 1.0:\r\n  78:         raise ValueError(\"w must be in [0, 1]\")\r\n  79: \r\n  80:     transition_logits = np.asarray(parameters[\"transition_logits\"], dtype=np.float64)\r\n  81:     initial_logits = np.asarray(parameters[\"initial_logits\"], dtype=np.float64)\r\n  82:     mu = np.asarray(parameters[\"mu\"], dtype=np.float64)\r\n  83:     c = np.asarray(parameters[\"c\"], dtype=np.float64)\r\n  84:     u = np.asarray(parameters[\"u\"], dtype=np.float64)\r\n  85:     log_sd = float(np.asarray(parameters[\"log_sd\"], dtype=np.float64).reshape(()))\r\n  86:     n_states = mu.size\r\n  87:     if (transition_logits.shape != (n_states, n_states)\r\n  88:             or initial_logits.shape != (n_states,)\r\n  89:             or c.shape != (n_states,) or u.shape != (n_states,)):\r\n  90:         raise ValueError(\"filter parameters have inconsistent state dimensions\")\r\n  91:     if not np.isfinite(log_sd):\r\n  92:         raise ValueError(\"log_sd must be finite\")\r\n  93:     return x, m, transition_logits, initial_logits, mu, log_sd, c, u, w\r\n  94: \r\n  95: \r\n  96: def numpy_forward(\r\n  97:     x: np.ndarray,\r\n  98:     m: np.ndarray,\r\n  99:     parameters: Mapping[str, np.ndarray],\r\n 100:     w: float = 1.0,\r\n 101: ) -> Tuple[np.ndarray, np.ndarray]:\r\n 102:     \"\"\"Return filtered outcome probabilities and sequence log likelihoods.\r\n 103: \r\n 104:     ``x`` has shape [patients, T] with NaN at missing values; ``m`` contains\r\n 105:     the corresponding 0/1 mask. The mask likelihood is multiplied by ``w``.\r\n 106:     The transition is applied before each observation update, matching the\r\n 107:     reference recursion in :mod:`bayes`.\r\n 108:     \"\"\"\r\n 109:     x, m, transition_logits, initial_logits, mu, log_sd, c, u, w = _check_inputs(\r\n 110:         x, m, parameters, w\r\n 111:     )\r\n 112:     n_patients, n_steps = x.shape\r\n 113:     log_transition = _log_softmax(transition_logits, axis=1)\r\n 114:     log_belief = np.broadcast_to(_log_softmax(initial_logits), (n_patients, mu.size)).copy()\r\n 115:     log_p_test = -np.logaddexp(0.0, -c)\r\n 116:     log_not_test = -np.logaddexp(0.0, c)\r\n 117:     sd = math.exp(log_sd)\r\n 118:     log_normal_constant = -log_sd - 0.5 * math.log(2.0 * math.pi)\r\n 119:     log_marginal = np.zeros(n_patients, dtype=np.float64)\r\n 120: \r\n 121:     for t in range(n_steps):\r\n 122:         log_predicted = _logsumexp(\r\n 123:             log_belief[:, :, None] + log_transition[None, :, :], axis=1\r\n 124:         )\r\n 125:         observed = m[:, t]\r\n 126:         safe_x = np.where(observed, x[:, t], 0.0)\r\n 127:         residual = (safe_x[:, None] - mu[None, :]) / sd\r\n 128:         log_value = log_normal_constant - 0.5 * residual * residual\r\n 129:         log_value = np.where(observed[:, None], log_value, 0.0)\r\n 130:         log_test = w * (\r\n 131:             observed[:, None] * log_p_test[None, :]\r\n 132:             + (~observed)[:, None] * log_not_test[None, :]\r\n 133:         )\r\n 134:         log_unnormalized = log_predicted + log_value + log_test\r\n 135:         normalizer = _logsumexp(log_unnormalized, axis=1)\r\n 136:         log_belief = log_unnormalized - normalizer[:, None]\r\n 137:         log_marginal += normalizer\r\n 138: \r\n 139:     posterior = np.exp(log_belief)\r\n 140:     probabilities = posterior @ _sigmoid(u)\r\n 141:     return probabilities, log_marginal\r\n 142: \r\n 143: \r\n 144: if torch is not None:\r\n 145:     class LatentFilter(nn.Module):\r\n 146:         \"\"\"K-state differentiable filter with a deploy-time mask tempering knob.\"\"\"\r\n 147: \r\n 148:         def __init__(self, n_states: int = 32):\r\n 149:             super().__init__()\r\n 150:             if n_states < 2:\r\n 151:                 raise ValueError(\"n_states must be at least 2\")\r\n 152:             self.n_states = int(n_states)\r\n 153:             transition_logits = torch.zeros(n_states, n_states)\r\n 154:             diagonal = torch.arange(n_states)\r\n 155:             transition_logits[diagonal, diagonal] = 4.0\r\n 156:             if n_states > 1:\r\n 157:                 transition_logits[diagonal[:-1], diagonal[1:]] = 2.0\r\n 158:                 transition_logits[diagonal[1:], diagonal[:-1]] = 2.0\r\n 159:             means = torch.linspace(-2.5, 2.5, n_states)\r\n 160:             initial_logits = -0.5 * means.square()\r\n 161:             self.transition_logits = nn.Parameter(transition_logits)\r\n 162:             self.initial_logits = nn.Parameter(initial_logits)\r\n 163:             self.mu = nn.Parameter(means)\r\n 164:             self.log_sd = nn.Parameter(torch.tensor(0.0))\r\n 165:             self.c = nn.Parameter(torch.zeros(n_states))\r\n 166:             self.u = nn.Parameter(torch.zeros(n_states))\r\n 167: \r\n 168:         def forward(self, x, m, w: float = 1.0):\r\n 169:             if not 0.0 <= float(w) <= 1.0:\r\n 170:                 raise ValueError(\"w must be in [0, 1]\")\r\n 171:             mask = m.to(dtype=torch.bool)\r\n 172:             log_transition = F.log_softmax(self.transition_logits, dim=1)\r\n 173:             log_belief = F.log_softmax(self.initial_logits, dim=0).expand(x.shape[0], -1)\r\n 174:             log_p_test = F.logsigmoid(self.c)\r\n 175:             log_not_test = F.logsigmoid(-self.c)\r\n 176:             sd = torch.exp(self.log_sd)\r\n 177:             log_normal_constant = -self.log_sd - 0.5 * math.log(2.0 * math.pi)\r\n 178:             log_marginal = torch.zeros(x.shape[0], dtype=x.dtype, device=x.device)\r\n 179: \r\n 180:             for t in range(x.shape[1]):\r\n 181:                 log_predicted = torch.logsumexp(\r\n 182:                     log_belief.unsqueeze(2) + log_transition.unsqueeze(0), dim=1\r\n 183:                 )\r\n 184:                 observed = mask[:, t]\r\n 185:                 safe_x = torch.where(observed, x[:, t], torch.zeros_like(x[:, t]))\r\n 186:                 residual = (safe_x[:, None] - self.mu[None, :]) / sd\r\n 187:                 log_value = log_normal_constant - 0.5 * residual.square()\r\n 188:                 log_value = torch.where(observed[:, None], log_value, torch.zeros_like(log_value))\r\n 189:                 observed_float = observed.to(dtype=x.dtype)[:, None]\r\n 190:                 log_test = float(w) * (\r\n 191:                     observed_float * log_p_test[None, :]\r\n 192:                     + (1.0 - observed_float) * log_not_test[None, :]\r\n 193:                 )\r\n 194:                 log_unnormalized = log_predicted + log_value + log_test\r\n 195:                 normalizer = torch.logsumexp(log_unnormalized, dim=1)\r\n 196:                 log_belief = log_unnormalized - normalizer[:, None]\r\n 197:                 log_marginal = log_marginal + normalizer\r\n 198: \r\n 199:             posterior = torch.exp(log_belief)\r\n 200:             probabilities = posterior @ torch.sigmoid(self.u)\r\n 201:             return probabilities, log_marginal\r\n 202: \r\n 203:         def numpy_parameters(self) -> Dict[str, np.ndarray]:\r\n 204:             return {\r\n 205:                 name: getattr(self, name).detach().cpu().numpy().copy()\r\n 206:                 for name in PARAMETER_NAMES\r\n 207:             }\r\n 208: else:\r\n 209:     class LatentFilter:  # pragma: no cover - only used to provide a clear runtime message\r\n 210:         def __init__(self, *args, **kwargs):\r\n 211:             raise ImportError(\"PyTorch is required to construct or train LatentFilter\")\r\n 212: \r\n 213: \r\n 214: def train_filter(\r\n 215:     train_x: np.ndarray,\r\n 216:     train_m: np.ndarray,\r\n 217:     train_y: np.ndarray,\r\n 218:     val_x: np.ndarray,\r\n 219:     val_m: np.ndarray,\r\n 220:     val_y: np.ndarray,\r\n 221:     *,\r\n 222:     n_states: int = 32,\r\n 223:     max_epochs: int = 200,\r\n 224:     batch_size: int = 512,\r\n 225:     patience: int = 15,\r\n 226:     seed: int = 31_337,\r\n 227: ) -> Tuple[LatentFilter, Dict[str, object]]:\r\n 228:     \"\"\"Fit the filter on A data using BCE plus per-step marginal NLL.\"\"\"\r\n 229:     if torch is None:\r\n 230:         raise ImportError(\"PyTorch is required to train E5; NumPy forward is available\")\r\n 231:     torch.set_num_threads(4)\r\n 232:     torch.manual_seed(int(seed))\r\n 233:     np.random.seed(int(seed) % (2**32 - 1))\r\n 234: \r\n 235:     def tensor_data(x, m, y):\r\n 236:         return (\r\n 237:             torch.from_numpy(np.ascontiguousarray(x, dtype=np.float32)),\r\n 238:             torch.from_numpy(np.ascontiguousarray(m, dtype=np.float32)),\r\n 239:             torch.from_numpy(np.ascontiguousarray(y, dtype=np.float32)),\r\n 240:         )\r\n 241: \r\n 242:     x_train, m_train, y_train = tensor_data(train_x, train_m, train_y)\r\n 243:     x_val, m_val, y_val = tensor_data(val_x, val_m, val_y)\r\n 244:     model = LatentFilter(n_states=n_states)\r\n 245:     optimizer = torch.optim.Adam(model.parameters(), lr=1e-2)\r\n 246:     n_train = y_train.shape[0]\r\n 247:     best_loss = float(\"inf\")\r\n 248:     best_state = None\r\n 249:     best_epoch = 0\r\n 250:     stale_epochs = 0\r\n 251:     train_history = []\r\n 252:     val_history = []\r\n 253:     train_bce_history = []\r\n 254:     val_bce_history = []\r\n 255:     train_nll_history = []\r\n 256:     val_nll_history = []\r\n 257: \r\n 258:     def evaluate(x, m, y):\r\n 259:         model.eval()\r\n 260:         total_loss = total_bce = total_nll = 0.0\r\n 261:         with torch.no_grad():\r\n 262:             for start in range(0, y.shape[0], batch_size):\r\n 263:                 stop = start + batch_size\r\n 264:                 probabilities, log_marginal = model(x[start:stop], m[start:stop], w=1.0)\r\n 265:                 bce = F.binary_cross_entropy(\r\n 266:                     probabilities.clamp(1e-7, 1.0 - 1e-7), y[start:stop]\r\n 267:                 )\r\n 268:                 nll = -log_marginal.mean() / x.shape[1]\r\n 269:                 size = y[start:stop].shape[0]\r\n 270:                 total_bce += float(bce) * size\r\n 271:                 total_nll += float(nll) * size\r\n 272:                 total_loss += float(bce + nll) * size\r\n 273:         count = int(y.shape[0])\r\n 274:         return total_loss / count, total_bce / count, total_nll / count\r\n 275: \r\n 276:     for epoch in range(int(max_epochs)):\r\n 277:         model.train()\r\n 278:         permutation = torch.randperm(n_train)\r\n 279:         total_loss = total_bce = total_nll = 0.0\r\n 280:         for start in range(0, n_train, batch_size):\r\n 281:             indices = permutation[start:start + batch_size]\r\n 282:             xb, mb, yb = x_train[indices], m_train[indices], y_train[indices]\r\n 283:             optimizer.zero_grad(set_to_none=True)\r\n 284:             probabilities, log_marginal = model(xb, mb, w=1.0)\r\n 285:             bce = F.binary_cross_entropy(\r\n 286:                 probabilities.clamp(1e-7, 1.0 - 1e-7), yb\r\n 287:             )\r\n 288:             nll = -log_marginal.mean() / x_train.shape[1]\r\n 289:             loss = bce + nll\r\n 290:             loss.backward()\r\n 291:             optimizer.step()\r\n 292:             size = yb.shape[0]\r\n 293:             total_bce += float(bce.detach()) * size\r\n 294:             total_nll += float(nll.detach()) * size\r\n 295:             total_loss += float(loss.detach()) * size\r\n 296:         train_bce = total_bce / n_train\r\n 297:         train_nll = total_nll / n_train\r\n 298:         train_history.append(total_loss / n_train)\r\n 299:         train_bce_history.append(train_bce)\r\n 300:         train_nll_history.append(train_nll)\r\n 301: \r\n 302:         val_loss, val_bce, val_nll = evaluate(x_val, m_val, y_val)\r\n 303:         val_history.append(val_loss)\r\n 304:         val_bce_history.append(val_bce)\r\n 305:         val_nll_history.append(val_nll)\r\n 306:         if val_loss < best_loss - 1e-8:\r\n 307:             best_loss = val_loss\r\n 308:             best_epoch = epoch + 1\r\n 309:             best_state = copy.deepcopy(model.state_dict())\r\n 310:             stale_epochs = 0\r\n 311:         else:\r\n 312:             stale_epochs += 1\r\n 313:         if stale_epochs >= patience:\r\n 314:             break\r\n 315: \r\n 316:     if best_state is not None:\r\n 317:         model.load_state_dict(best_state)\r\n 318:     return model, {\r\n 319:         \"best_epoch\": best_epoch,\r\n 320:         \"epochs\": len(train_history),\r\n 321:         \"train_loss\": train_history,\r\n 322:         \"val_loss\": val_history,\r\n 323:         \"train_bce\": train_bce_history,\r\n 324:         \"val_bce\": val_bce_history,\r\n 325:         \"train_nll_per_step\": train_nll_history,\r\n 326:         \"val_nll_per_step\": val_nll_history,\r\n 327:     }\r\n 328: \r\n 329: \r\n### e12_unlabelled_head.py:60\r\n  60:     result[positive] = 1.0 / (1.0 + np.exp(-values[positive]))\r\n  61:     exp_values = np.exp(values[~positive])\r\n  62:     result[~positive] = exp_values / (1.0 + exp_values)\r\n  63:     return result\r\n  64: \r\n  65: \r\n  66: def auroc_rank(y_true: np.ndarray, scores: np.ndarray) -> float:\r\n  67:     \"\"\"Compute AUROC from average ranks, assigning average ranks to ties.\"\"\"\r\n  68:     y = np.asarray(y_true, dtype=bool).reshape(-1)\r\n  69:     score = np.asarray(scores, dtype=np.float64).reshape(-1)\r\n  70:     if y.size != score.size:\r\n  71:         raise ValueError(\"y_true and scores must have the same length\")\r\n  72:     positives = int(y.sum())\r\n  73:     negatives = y.size - positives\r\n  74:     if positives == 0 or negatives == 0:\r\n  75:         return float(\"nan\")\r\n  76: \r\n  77:     order = np.argsort(score, kind=\"mergesort\")\r\n  78:     ordered = score[order]\r\n  79:     ranks = np.empty(y.size, dtype=np.float64)\r\n  80:     start = 0\r\n  81:     while start < y.size:\r\n  82:         stop = start + 1\r\n  83:         while stop < y.size and ordered[stop] == ordered[start]:\r\n  84:             stop += 1\r\n  85:         # Ranks are one-based; all tied items receive their average rank.\r\n  86:         ranks[order[start:stop]] = 0.5 * ((start + 1) + stop)\r\n  87:         start = stop\r\n  88:     positive_rank_sum = float(ranks[y].sum())\r\n  89:     return (positive_rank_sum - positives * (positives + 1) / 2.0) / (positives * negatives)\r\n  90: \r\n  91: \r\n  92: def _metrics(y: np.ndarray, probability: np.ndarray, oracle_brier: float) -> Dict[str, float]:\r\n  93:     y = np.asarray(y, dtype=np.float64).reshape(-1)\r\n  94:     probability = np.asarray(probability, dtype=np.float64).reshape(-1)\r\n  95:     if y.shape != probability.shape:\r\n  96:         raise ValueError(\"prediction and outcome arrays must have matching shapes\")\r\n  97:     clipped = np.clip(probability, 1e-7, 1.0 - 1e-7)\r\n  98:     brier = float(np.mean((probability - y) ** 2))\r\n  99:     log_loss = float(-np.mean(y * np.log(clipped) + (1.0 - y) * np.log1p(-clipped)))\r\n 100:     return {\r\n 101:         \"brier\": brier,\r\n 102:         \"log_loss\": log_loss,\r\n 103:         \"auroc\": auroc_rank(y, probability),\r\n 104:         \"regret\": brier - float(oracle_brier),\r\n 105:     }\r\n 106: \r\n 107: \r\n 108: def _pool_seeds(policy_index: int, size_type: str, size_index: int, draw: int) -> Tuple[int, int, int]:\r\n 109:     \"\"\"Return disjoint latent, observation, and minibatch seeds for one pool.\"\"\"\r\n 110:     type_offset = 0 if size_type == \"n_L\" else 25_000\r\n 111:     latent_seed = POOL_SEED_BASE + policy_index * 50_000 + type_offset + size_index * 1_000 + draw * 3\r\n 112:     return latent_seed, latent_seed + 1, latent_seed + 2\r\n 113: \r\n 114: \r\n 115: def _observe_pool(n: int, policy: sim.Policy, latent_seed: int, obs_seed: int):\r\n 116:     latent = sim.simulate_latent(n, seed=latent_seed)\r\n 117:     observed = sim.observe(latent, policy, sigma=SIGMA, seed=obs_seed)\r\n 118:     return observed, np.asarray(latent[\"y\"], dtype=np.float32)\r\n 119: \r\n 120: \r\n 121: def _choose_dial_weight(x: np.ndarray, m: np.ndarray, y: np.ndarray,\r\n 122:                         parameters: Mapping[str, np.ndarray]) -> float:\r\n 123:     \"\"\"Choose the labelled run-in log-loss minimiser, breaking ties toward 1.\"\"\"\r\n 124:     weights = np.round(np.arange(0.0, 1.0001, 0.05), 2)\r\n 125:     losses = []\r\n 126:     for weight in weights:\r\n 127:         probability, _ = latent_filter.numpy_forward(x, m, parameters, w=float(weight))\r\n 128:         clipped = np.clip(probability, 1e-7, 1.0 - 1e-7)\r\n 129:         loss = -np.mean(y * np.log(clipped) + (1.0 - y) * np.log1p(-clipped))\r\n 130:         losses.append(float(loss))\r\n 131:     best_loss = min(losses)\r\n 132:     return float(max(weight for weight, loss in zip(weights, losses) if loss == best_loss))\r\n 133: \r\n 134: \r\n 135: def _refit_testing_head(\r\n 136:     observed: Mapping[str, np.ndarray],\r\n 137:     labels: np.ndarray | None,\r\n 138:     parameters: Mapping[str, np.ndarray],\r\n 139:     *,\r\n 140:     batch_seed: int,\r\n 141:     steps: int,\r\n 142:     lr: float = 1e-2,\r\n 143: ) -> Dict[str, np.ndarray]:\r\n 144:     \"\"\"Refit c only, using the E5 likelihood and optional outcome BCE.\"\"\"\r\n 145:     try:\r\n 146:         import torch\r\n 147:         from torch.nn import functional as F\r\n 148:     except ImportError as exc:  # Keep NumPy checks usable without PyTorch.\r\n 149:         raise ImportError(\"PyTorch is required for the E12 head refits\") from exc\r\n 150: \r\n 151:     torch.set_num_threads(1)\r\n 152:     torch.manual_seed(int(batch_seed))\r\n 153:     model = latent_filter.LatentFilter(n_states=int(np.asarray(parameters[\"mu\"]).size))\r\n 154:     with torch.no_grad():\r\n 155:         for name in latent_filter.PARAMETER_NAMES:\r\n 156:             tensor = torch.as_tensor(np.asarray(parameters[name]), dtype=getattr(model, name).dtype)\r\n 157:             getattr(model, name).copy_(tensor)\r\n 158: \r\n 159:     for name, parameter in model.named_parameters():\r\n 160:         parameter.requires_grad_