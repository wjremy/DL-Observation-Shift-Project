{"type":"item.started","item":{"id":"item_27","type":"command_execution","command":"\"C:\\\\WINDOWS\\\\System32\\\\WindowsPowerShell\\\\v1.0\\\\powershell.exe\" -Command '$py = Join-Path $env:USERPROFILE '\"'.cache\\\\codex-runtimes\\\\codex-primary-runtime\\\\dependencies\\\\python\\\\python.exe'; & \"'$py -m py_compile latent_filter_mv.py e15_real_pairs.py figures/e15_figure.py; @'\"'\nimport numpy as np\nimport latent_filter\nimport latent_filter_mv as mv\nrng=np.random.default_rng(15015)\nk,n,t=6,9,5\nparams={\\\"transition_logits\\\":rng.normal(size=(k,k)),\\\"initial_logits\\\":rng.normal(size=k),\\\"mu\\\":rng.normal(size=(k,1)),\\\"log_sd\\\":np.array([0.4]),\\\"c\\\":rng.normal(size=(k,1)),\\\"u\\\":rng.normal(size=k)}\nx=rng.normal(size=(n,t)); m=(rng.random(size=(n,t))<.4).astype(np.int8); x[m==0]=np.nan\nref={\\\"transition_logits\\\":params[\\\"transition_logits\\\"],\\\"initial_logits\\\":params[\\\"initial_logits\\\"],\\\"mu\\\":params[\\\"mu\\\"][:,0],\\\"log_sd\\\":float(params[\\\"log_sd\\\"][0]),\\\"c\\\":params[\\\"c\\\"][:,0],\\\"u\\\":params[\\\"u\\\"]}\nfor w in (0.,.27,1.):\n    a=mv.numpy_forward(x[:,:,None],m[:,:,None],params,w)\n    b=latent_filter.numpy_forward(x,m,ref,w)\n    np.testing.assert_allclose(a[0],b[0],rtol=0,atol=1e-10)\n    np.testing.assert_allclose(a[1],b[1],rtol=0,atol=1e-10)\nprint('D=1 parity vs latent_filter.numpy_forward: passed (0, 0.27, 1)')\n'@ | & \"'$py -'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
