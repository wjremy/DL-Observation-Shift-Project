{"type":"item.started","item":{"id":"item_22","type":"command_execution","command":"\"C:\\\\WINDOWS\\\\System32\\\\WindowsPowerShell\\\\v1.0\\\\powershell.exe\" -Command \"@'\nimport tempfile\nfrom pathlib import Path\nimport numpy as np\nimport latent_filter\nimport latent_filter_mv as mv\nimport e15_real_pairs as e15\n\nrng = np.random.default_rng(15015)\nn, t, k = 11, 7, 5\ntransition = rng.normal(size=(k, k))\ninitial = rng.normal(size=k)\nmu = rng.normal(size=k)\nlog_sd = np.array([0.25])\nc = rng.normal(size=k)\nu = rng.normal(size=k)\nx1 = rng.normal(size=(n, t))\nm1 = (rng.random(size=(n, t)) < 0.4).astype(np.int8)\nx1[m1 == 0] = np.nan\np_mv = {\\\"transition_logits\\\": transition, \\\"initial_logits\\\": initial,\n        \\\"mu\\\": mu[:, None], \\\"log_sd\\\": log_sd, \\\"c\\\": c[:, None], \\\"u\\\": u}\np_1d = {\\\"transition_logits\\\": transition, \\\"initial_logits\\\": initial,\n        \\\"mu\\\": mu, \\\"log_sd\\\": float(log_sd[0]), \\\"c\\\": c, \\\"u\\\": u}\nmax_diff = 0.0\nfor w in (0.0, 0.3, 1.0):\n    pmv, lmv = mv.numpy_forward(x1[:, :, None], m1[:, :, None], p_mv, w=w)\n    pref, lref = latent_filter.numpy_forward(x1, m1, p_1d, w=w)\n    max_diff = max(max_diff, float(np.max(np.abs(pmv - pref))), float(np.max(np.abs(lmv - lref))))\nassert max_diff < 1e-10, max_diff\np_other = dict(p_mv)\np_other[\\\"c\\\"] = rng.normal(size=(k, 1)) * 20\nnp.testing.assert_allclose(\n    mv.numpy_forward(x1[:, :, None], m1[:, :, None], p_mv, w=0.0)[0],\n    mv.numpy_forward(x1[:, :, None], m1[:, :, None], p_other, w=0.0)[0],\n    rtol=0, atol=1e-12,\n)\nstd_in = np.array([[[100.0, np.nan], [-20.0, 15.0]]])\nstd_out = mv.standardise(std_in, np.array([0.0, 10.0]), np.array([1.0, 1.0]))\nassert np.isnan(std_out[0, 0, 1]) and std_out[0, 0, 0] == 5.0 and std_out[0, 1, 0] == -5.0\n\nwith tempfile.TemporaryDirectory() as temp:\n    cache_path = Path(temp) / \\\"e15_cache.npz\\\"\n    x = rng.normal(size=(13, 4, 2)).astype(np.float32)\n    m = (rng.random(size=x.shape) > 0.35).astype(np.int8)\n    x[m == 0] = np.nan\n    np.savez_compressed(cache_path, P12_SICU_x=x, P12_SICU_m=m,\n                        P12_SICU_y=(np.arange(13) % 3 == 0).astype(np.int8),\n                        P12_SICU_ids=np.array([f\\\"p{i}\\\" for i in range(13)]),\n                        P12_variables=np.array([\\\"a\\\", \\\"b\\\"]),\n                        P12_log_variables=np.array([\\\"b\\\"]), P12_T=np.array(4))\n    loaded = e15._load_cache(cache_path)\n    assert loaded[\\\"P12_SICU_x\\\"].shape == (13, 4, 2)\n    pool, evaluation = e15._target_split_indices(13, \\\"P12\\\", \\\"SICU\\\")\n    assert len(pool) == 6 and len(evaluation) == 7 and not np.intersect1d(pool, evaluation).size\n    chosen = e15._draw_runin_indices(len(pool), 5, 44)\n    assert len(np.unique(chosen)) == 5\n    standardized = e15._standardise_target(loaded[\\\"P12_SICU_x\\\"], np.array([0.0, 0.0]), np.array([0.2, 0.2]))\n    assert np.isnan(standardized[loaded[\\\"P12_SICU_m\\\"] == 0]).all()\n    assert np.nanmax(np.abs(standardized)) <= 5.0\n\nscores, provenance = e15._source_reference_aurocs()\nassert scores[(\\\"P12\\\", \\\"CSRU\\\")] > 0.9\nassert (\\\"P19\\\", \\\"A-all\\\") in scores and \\\"e10_sites.csv\\\" in provenance[(\\\"P19\\\", \\\"A-all\\\")]\nprint(f\\\"D=1 NumPy parity max abs diff: {max_diff:.3g}\\\")\nprint(\\\"w=0 testing-head invariance: passed\\\")\nprint(\\\"standardisation NaN preservation/clipping: passed\\\")\nprint(\\\"synthetic cache loading, 50/50 split, run-in sampling, target scaling: passed\\\")\nprint(\\\"E7 source reference: analysis/e7_sites.csv:source_holdout_auroc_w1 (combined linear model)\\\")\nprint(\\\"P19 whole-hospital comparator fallback: analysis/e10_sites.csv:local_auroc (combined)\\\")\n'@ | & (Join-Path \"'$env:USERPROFILE '\"'.cache\\\\codex-runtimes\\\\codex-primary-runtime\\\\dependencies\\\\python\\\\python.exe') -\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
