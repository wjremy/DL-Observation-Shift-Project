                                        \r\n-a----        10/17/2026   5:21 PM          17626 analyze.py                                                           \r\n-a----        10/17/2026  10:19 PM           9848 analyze_e3.py                                                        \r\n-a----        10/18/2026  11:59 AM           5017 analyze_e4.py                                                        \r\n-a----        10/18/2026  12:50 PM           5101 analyze_e5.py                                                        \r\n-a----        10/17/2026   5:21 PM           4468 bayes.py                                                             \r\n-a----        10/17/2026   5:20 PM            673 bayes_reference.csv                                                  \r\n-a----        10/23/2026   4:47 PM           2192 CLAUDE.md                                                            \r\n-a----        10/20/2026   7:56 AM          24216 e10_diagnostic.py                                                    \r\n-a----        10/20/2026   9:08 AM          19946 e11_p12_runin.py                                                     \r\n-a----        10/20/2026   9:18 AM           1491 e11_sensitivity_clean_ph.py                                          \r\n-a----        10/23/2026   2:47 PM          20482 e12_unlabelled_head.py                                               \r\n-a----        10/24/2026   4:43 PM           4157 e13b_finetune_lr.py                                                  \r\n-a----        10/23/2026   3:05 PM          19717 e13_rungs_over_time.py                                               \r\n-a----        10/19/2026   7:31 PM           8914 e6_cohort.py                                                         \r\n-a----        10/19/2026   7:32 PM          23918 e6_dial.py                                                           \r\n-a----        10/19/2026  11:12 PM          20544 e7b_recal.py                                                         \r\n-a----        10/19/2026  10:03 PM          17242 e7_dial.py                                                           \r\n-a----        10/19/2026   9:59 PM          15212 e7_sites.py                                                          \r\n-a----        10/19/2026  11:47 PM          21416 e8_runin.py                                                          \r\n-a----        10/20/2026  12:12 AM          20099 e9_fixed_tuning.py                                                   \r\n-a----        10/18/2026  12:50 PM          19205 latent_filter.py                                                     \r\n-a----        10/17/2026   5:10 PM          10852 models.py                                                            \r\n-a----        10/17/2026   5:12 PM           5131 plot.py                                                              \r\n-a----        10/19/2026   8:48 PM           3489 README.md                                                            \r\n-a----        10/17/2026   8:59 PM           6775 run_full.log                                                         \r\n-a----        10/17/2026  10:18 PM          14796 run_grid.py                                                          \r\n-a----        10/18/2026  11:59 AM          11605 run_poe.py                                                           \r\n-a----        10/17/2026  10:17 PM           8302 sim.py                                                               \r\n-a----        10/25/2026  11:56 AM           7438 sim_u.py                                                             \r\n-a----        10/25/2026  11:55 AM          41089 SPEC.md                                                              \r\n-a----        10/25/2026  11:56 AM          39807 STATUS.md                                                            \r\n-a----        10/17/2026  10:20 PM           4416 test_e3.py                                                           \r\n-a----        10/18/